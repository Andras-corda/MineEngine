<Project>
  <!-- Paramètres communs à tous les projets de la solution. -->
  <PropertyGroup>
    <MineEngineTargetFramework>net9.0</MineEngineTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Mine Engine</Company>
    <Product>Mine Engine</Product>
    <Version>0.6.11</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <Copyright>Copyright (c) 2026 Andras Corda</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Traductions de l'interface : Tr.T("...") et Tr.F("...", ...) sont disponibles partout. -->
  <ItemGroup>
    <Using Include="MineEngine.Core.Localization" />
  </ItemGroup>
</Project>
