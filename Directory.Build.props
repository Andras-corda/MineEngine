<Project>
  <!-- Global parameter -->
  <PropertyGroup>
    <MineEngineTargetFramework>net9.0</MineEngineTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Mine Engine</Company>
    <Product>Mine Engine</Product>
    <Version>0.7.1</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <Copyright>Copyright (c) 2026 Andras Corda</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- traduction -->
  <ItemGroup>
    <Using Include="MineEngine.Core.Localization" />
  </ItemGroup>
</Project>
