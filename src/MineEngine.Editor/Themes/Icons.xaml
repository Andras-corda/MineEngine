    <!-- ============================================================
         STYLES
         ============================================================ -->

    <!--
        Glyphe à côté d'un texte : 13 px, espacé du texte qui suit. La couleur est celle du
        texte qui l'entoure (gris dans un menu, blanc dans un bouton bleu) ; Foreground la change.
    -->
    <Style x:Key="IconGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

    <!-- Petit glyphe dans un bouton à libellé (barre d'outils, chevron de menu déroulant) -->
    <Style x:Key="IconGlyphSmall" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- Glyphe de type d'élément : 16 px -->
    <Style x:Key="IconGlyphLarge" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- Glyphe mis en avant (élément sélectionné) -->
    <Style x:Key="IconGlyphAccent" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="Foreground" Value="{DynamicResource AccentLineBrush}"/>
    </Style>

    <!-- Glyphe sur un badge -->
    <Style x:Key="IconGlyphBadge" TargetType="TextBlock" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}"/>
    </Style>

    <!-- Icône vectorielle : 16 px, trait fin, aucun remplissage.
         Usage : <Path Style="{StaticResource IconPath}" Data="{StaticResource BlockGeometry}"/> -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Stroke" Value="{DynamicResource HintBrush}"/>
        <Setter Property="StrokeThickness" Value="1.2"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Variante 15 px (la géométrie est mise à l'échelle, pas le trait) -->
    <Style x:Key="IconPathSmall" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- Logo -->
    <Style x:Key="LogoPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Data" Value="{StaticResource CubeGeometry}"/>
        <Setter Property="Stroke" Value="{DynamicResource AccentLineBrush}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
    </Style>

    <!-- Bouton d'outil : glyphe 12 px, zone cliquable ≥ 24 px, fond discret au survol.
         Usage : <Button Style="{StaticResource IconButton}"
                         Content="{StaticResource Glyph.Save}"
                         ToolTip="Enregistrer (Ctrl+S)"/> -->
    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Back" CornerRadius="4" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton bascule (panneau affiché, option cochée) -->
    <Style x:Key="IconToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bouton d'outil avec une icône vectorielle :
         <Button Style="{StaticResource IconButton}" ToolTip="Nouveau bloc">
             <Path Style="{StaticResource IconPathButton}" Data="{StaticResource BlockGeometry}"/>
         </Button> -->
    <Style x:Key="IconPathButton" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
    </Style>

    <!-- Textures du mod : pixel art, sans lissage, jamais recolorées -->
    <Style x:Key="ModTexture" TargetType="Image">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

</ResourceDictionary>
