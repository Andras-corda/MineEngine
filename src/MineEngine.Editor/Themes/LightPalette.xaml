<!-- Couleurs propres à Mine Engine pour le thème clair. Les mêmes clés existent dans DarkPalette.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Fonds et surfaces : gris neutres et contrastés. Les barres latérales et les panneaux ancrés
        sont les plus sombres, la zone centrale plus claire, les cartes encore plus claires.
    -->
    <SolidColorBrush x:Key="HubBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#E6E7EA" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F0F1F4" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D9DBE0" />
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#E8F1FC" />
    <SolidColorBrush x:Key="CardSelectedBorderBrush" Color="#2F7FD8" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#DCE9FA" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#2F7FD8" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#E6E7EA" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#4A4D55" />
    <SolidColorBrush x:Key="LinkBrush" Color="#1F66C1" />
    <SolidColorBrush x:Key="PreviewGridBrush" Color="#E2E4E8" />

    <!-- Texte -->
    <SolidColorBrush x:Key="StrongTextBrush" Color="#1B1C1F" />
    <SolidColorBrush x:Key="HintBrush" Color="#5F626A" />

    <!-- Inspecteur : badges de type, aperçus de texture -->
    <SolidColorBrush x:Key="TypeBadgeBrush" Color="#E6E7EA" />
    <SolidColorBrush x:Key="TypeBadgeTextBrush" Color="#4A4D55" />
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#E6E7EA" />
    <SolidColorBrush x:Key="PreviewBorderBrush" Color="#D9DBE0" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#D9DBE0" />

    <!-- Journal et diagnostics -->
    <SolidColorBrush x:Key="LogDebugBrush" Color="#7A7A86" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#1E8449" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#9A6200" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#C0392B" />

    <!-- Sélection dans les listes et arbres : sélection bleue, plus discrète que l'accent de ModernWpf -->
    <SolidColorBrush x:Key="ListBoxItemUnselectedBackgroundPointerOverThemeBrush" Color="#F0F1F4" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#DCE9FA" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#CFE1F8" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#1B1C1F" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#F0F1F4" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#DCE9FA" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#CFE1F8" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#BFD7F5" />

    <!-- Accent bleu plein : bouton principal, onglet actif. Remplace aussi les boutons d'accent de ModernWpf. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F7FD8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3B8EEA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2668B3" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#2F7FD8" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3B8EEA" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2668B3" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6EEF8" />

    <!--
        Contrôles de ModernWpf (champs, boutons, listes déroulantes, menus) : mêmes gris que le reste,
        au lieu des couleurs de Windows.
    -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F7F8FA" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CFD2D8" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#CFD2D8" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F0F1F4" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E6E7EA" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CFD2D8" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#CFD2D8" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F7F8FA" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CFD2D8" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#CFD2D8" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF" />

    <!-- Éditeur de code : ligne courante, sélection, marque des lignes en erreur -->
    <SolidColorBrush x:Key="CodeCurrentLineBrush" Color="#F0F1F4" />
    <SolidColorBrush x:Key="CodeSelectionBrush" Color="#ADD6FF" />
    <SolidColorBrush x:Key="CodeErrorLineBrush" Color="#FBE3E4" />

</ResourceDictionary>