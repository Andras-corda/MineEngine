<!-- Couleurs propres à Mine Engine pour le thème sombre. Les mêmes clés existent dans LightPalette.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Fonds et surfaces : gris neutres et contrastés. Les barres latérales et les panneaux ancrés
        sont les plus sombres, la zone centrale plus claire, les cartes encore plus claires.
    -->
    <SolidColorBrush x:Key="HubBackgroundBrush" Color="#2B2C30" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="CardBrush" Color="#34363B" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#3B3D43" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3E4046" />
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#22344C" />
    <SolidColorBrush x:Key="CardSelectedBorderBrush" Color="#3B8EEA" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#233C5C" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#3B8EEA" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#3A3C42" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#C3C6CD" />
    <SolidColorBrush x:Key="LinkBrush" Color="#6CB6FF" />
    <SolidColorBrush x:Key="PreviewGridBrush" Color="#34363B" />

    <!-- Texte -->
    <SolidColorBrush x:Key="StrongTextBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="HintBrush" Color="#9C9FA6" />

    <!-- Inspecteur : badges de type, aperçus de texture -->
    <SolidColorBrush x:Key="TypeBadgeBrush" Color="#3A3C42" />
    <SolidColorBrush x:Key="TypeBadgeTextBrush" Color="#C3C6CD" />
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="PreviewBorderBrush" Color="#3E4046" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#2E3034" />

    <!-- Journal et diagnostics -->
    <SolidColorBrush x:Key="LogDebugBrush" Color="#8A8A94" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#4CC37A" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#E0A93A" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#FF6B6B" />

    <!-- Sélection dans les listes et arbres : sélection bleue, plus discrète que l'accent de ModernWpf -->
    <SolidColorBrush x:Key="ListBoxItemUnselectedBackgroundPointerOverThemeBrush" Color="#34363B" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#233C5C" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#29466B" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#34363B" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#233C5C" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#29466B" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#2A5080" />

    <!-- Accent bleu plein : bouton principal, onglet actif. Remplace aussi les boutons d'accent de ModernWpf. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2F7FD8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3B8EEA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2668B3" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#2F7FD8" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3B8EEA" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2668B3" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6EEF8" />

    <!--
        Contrôles de ModernWpf (champs, boutons, listes déroulantes, menus) : mêmes gris que le reste,
        au lieu des couleurs de Windows.
    -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#2E3035" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#34363B" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#26272B" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#44464D" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#44464D" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#34363B" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3D3F45" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2E3035" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#44464D" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#44464D" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#2E3035" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#34363B" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#26272B" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#44464D" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#44464D" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B2C30" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2B2C30" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#2B2C30" />

    <!-- Éditeur de code : ligne courante, sélection, marque des lignes en erreur -->
    <SolidColorBrush x:Key="CodeCurrentLineBrush" Color="#303237" />
    <SolidColorBrush x:Key="CodeSelectionBrush" Color="#264F78" />
    <SolidColorBrush x:Key="CodeErrorLineBrush" Color="#3A1F24" />

</ResourceDictionary>