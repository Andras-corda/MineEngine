<!-- Couleurs propres à Mine Engine pour le thème sombre. Les mêmes clés existent dans LightPalette.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonds et surfaces (palette de l'accueil, reprise dans tout l'éditeur et dans les panneaux AvalonDock) -->
    <SolidColorBrush x:Key="HubBackgroundBrush" Color="#1F1F22" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1A1A1D" />
    <SolidColorBrush x:Key="CardBrush" Color="#27272B" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#2E2E33" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#38383E" />
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#2E2531" />
    <SolidColorBrush x:Key="CardSelectedBorderBrush" Color="#C98BD0" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#3A2C3E" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#D493DA" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#333338" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#B9B9C2" />
    <SolidColorBrush x:Key="LinkBrush" Color="#E2A8E9" />
    <SolidColorBrush x:Key="PreviewGridBrush" Color="#303036" />

    <!-- Texte -->
    <SolidColorBrush x:Key="StrongTextBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="HintBrush" Color="#A1A1AB" />

    <!-- Inspecteur : badges de type, aperçus de texture -->
    <SolidColorBrush x:Key="TypeBadgeBrush" Color="#333338" />
    <SolidColorBrush x:Key="TypeBadgeTextBrush" Color="#B9B9C2" />
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#1A1A1D" />
    <SolidColorBrush x:Key="PreviewBorderBrush" Color="#38383E" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#38383E" />

    <!-- Journal et diagnostics -->
    <SolidColorBrush x:Key="LogDebugBrush" Color="#8A8A94" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#4CC37A" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#E0A93A" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#FF6B6B" />

    <!-- Sélection dans les listes et arbres : remplace l'accent vif de ModernWpf par la sélection de l'accueil -->
    <SolidColorBrush x:Key="ListBoxItemUnselectedBackgroundPointerOverThemeBrush" Color="#2E2E33" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#3A2C3E" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#44344A" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#2E2E33" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#3A2C3E" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#44344A" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#4E3B55" />

</ResourceDictionary>