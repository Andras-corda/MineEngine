<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:MineEngine.Editor.Converters">

    <!--
        Style de base de Mine Engine, celui de l'accueil : fonds gris neutres, cartes arrondies,
        accent bleu, onglets soulignés. Toutes les vues et fenêtres fusionnent ce dictionnaire ;
        les couleurs viennent du thème actif (MineEngine.Core/Theming, appliqué par WpfThemeService).
    -->

    <!-- Icônes (glyphes, géométries et styles d'icônes), voir docs/ICONS.md -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MineEngine.Editor;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisible" />
    <conv:FilePathToImageConverter x:Key="FilePathToImage" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />

    <!--
        Cadres de groupe : le modèle classique de WPF dessine un double liseré blanc,
        très visible en thème sombre. Ce modèle simple suit les couleurs du thème.
    -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="10,8,10,0"
                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="11"
                                              TextElement.Foreground="{DynamicResource HintBrush}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,12,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!--
        Les styles nommés dérivent du style du thème (BasedOn) : sans cela, le contrôle
        reprendrait l'apparence classique de WPF et resterait clair en mode sombre.
        Champ de saisie : l'erreur de validation s'affiche en info-bulle.
    -->
    <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="3,2" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinWidth" Value="70" />
    </Style>

    <!-- Briques de l'accueil, reprises partout : barre latérale, cartes, onglets soulignés, badges, sections. -->

    <sys:Boolean x:Key="True">True</sys:Boolean>


    <!-- Entrée de la barre latérale ; Tag = vrai quand la page est affichée. -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="5" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,7"
                                Background="{DynamicResource AccentLineBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="14,8" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Onglet souligné ("Tous les projets", "Récents") ; Tag = vrai quand il est actif. -->
    <Style x:Key="UnderlineTab" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent">
                        <ContentPresenter Margin="0,4,0,6" />
                        <Border x:Name="Line" Height="2" CornerRadius="1" Background="{DynamicResource AccentLineBrush}" Visibility="Hidden" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
    </Style>

    <Style x:Key="SectionCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
    </Style>

    <Style x:Key="MonoHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Carte de projet dans la liste (élément de ListBox sans le style de sélection par défaut). -->
    <Style x:Key="ProjectItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Style="{StaticResource Card}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CardSelectedBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton de barre d'outils (éditeur de code) : cadre discret, icône, libellé et raccourci. -->
    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="4" BorderThickness="1" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Action principale d'une barre d'outils (Enregistrer) : fond bleu plein. -->
    <Style x:Key="PrimaryToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="4" BorderThickness="1" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Raccourci clavier affiché dans un bouton ("Ctrl+S"). -->
    <Style x:Key="ShortcutHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Bouton texte discret (barre de statut, liens d'action). -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="3" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Titre de panneau en petites capitales ("EXPLORATEUR", "PROPRIÉTÉS"). -->
    <Style x:Key="PanelCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Section du panneau Détails, façon Unreal : titre en capitales, lignes libellé / valeur. -->
    <Style x:Key="DetailsSection" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="DetailsLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DetailsValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
        <Setter Property="Margin" Value="8,3,0,3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Bandeau d'information (fichier généré, aperçu...). -->
    <Style x:Key="InfoBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardSelectedBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!--
        Onglets soulignés pour les TabControl des fenêtres (Paramètres...), comme "Tous les projets /
        Récents" sur l'accueil. Style nommé et non implicite : AvalonDock dérive aussi de TabItem.
    -->
    <Style x:Key="UnderlineTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <StackPanel Background="Transparent" Margin="0,0,16,0">
                        <ContentPresenter ContentSource="Header" Margin="0,4,0,6" />
                        <Border x:Name="Line" Height="2" CornerRadius="1" Background="{DynamicResource AccentLineBrush}" Visibility="Hidden" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UnderlineTabControl" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource UnderlineTabItem}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel IsItemsHost="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" />
                        </StackPanel>
                        <ContentPresenter ContentSource="SelectedContent" Margin="0,12,0,0" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grilles de données : transparentes sur le fond de carte, lignes sans quadrillage. -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>