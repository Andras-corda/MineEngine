<Window x:Class="MineEngine.Editor.Views.NewElementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MineEngine.Editor.Localization"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:views="clr-namespace:MineEngine.Editor.Views"
        xmlns:creation="clr-namespace:MineEngine.Editor.ViewModels.Creation"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource HubBackgroundBrush}"
        Title="{l:Tr 'Create'}"
        Width="940" Height="640" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <!--
        Creation window (V0.7.14): the categories on the left, what they hold in the middle, then the
        name typed directly and the templates of the choice. DataContext: NewElementViewModel.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A card of the lists (choices and templates): no default selection style. -->
            <Style x:Key="ChoiceItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" Style="{StaticResource Card}" Padding="10,8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CardSelectedBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ItemsPanelTemplate x:Key="Wrap">
                <WrapPanel />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="{l:Tr 'Create'}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="110" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{l:Tr 'Cancel'}" IsCancel="True" MinWidth="110" />
        </StackPanel>

        <!-- Categories -->
        <ListBox x:Name="CategoryList" DockPanel.Dock="Left" Width="230" Margin="0,0,16,0" BorderThickness="0" Background="Transparent"
                 ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                 AutomationProperties.Name="{l:Tr 'Categories'}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="Padding" Value="10,7" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type creation:NewElementCategory}">
                    <StackPanel Orientation="Horizontal">
                        <views:IconView Icon="{Binding Icon}" IconSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding SelectedCategory.Title}" Style="{StaticResource PanelTitle}" FontSize="16" />

            <!-- What the category holds -->
            <ListBox x:Name="EntryList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                     ItemsSource="{Binding SelectedCategory.Entries}" SelectedItem="{Binding SelectedEntry}"
                     ItemsPanel="{StaticResource Wrap}" ItemContainerStyle="{StaticResource ChoiceItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{l:Tr 'Elements'}" MouseDoubleClick="OnEntryDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type creation:NewElementEntry}">
                        <DockPanel Width="190" Height="74">
                            <views:IconView x:Name="Icon" DockPanel.Dock="Left" Icon="{Binding Icon}" IconSize="22" Margin="0,2,10,0" VerticalAlignment="Top" />
                            <StackPanel x:Name="Text">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource FieldHint}" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Text" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- The choice: name and templates -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <views:IconView Icon="{Binding SelectedEntry.Icon}" IconSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedEntry.Label}" Style="{StaticResource PanelTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedEntry.Description}" Style="{StaticResource FieldHint}" />

                    <TextBlock Text="{Binding NameHint}" Margin="0,6,0,4" />
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr 'Name'}"
                             IsEnabled="{Binding IsComing, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource LogErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Visibility="{Binding HasTemplates, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                        <TextBlock Text="{l:Tr 'Template'}" Margin="0,0,0,6" />
                        <ListBox x:Name="TemplateList" BorderThickness="0" Background="Transparent" MaxHeight="170"
                                 ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                 ItemsPanel="{StaticResource Wrap}" ItemContainerStyle="{StaticResource ChoiceItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{l:Tr 'Templates'}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type creation:NewElementTemplate}">
                                    <StackPanel Width="170">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource FieldHint}" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
