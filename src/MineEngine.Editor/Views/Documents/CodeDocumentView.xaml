<UserControl x:Class="MineEngine.Editor.Views.Documents.CodeDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:docs="clr-namespace:MineEngine.Editor.ViewModels.Documents"
             xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">

    <!--
        Onglet de code : barre d'outils (fil d'Ariane, Enregistrer, Rechercher, Formater),
        bandeau éventuel (code généré, verrouillé...), éditeur avec numéros de ligne,
        blocs repliables et marques des erreurs de compilation.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Barre de recherche (Ctrl+F, F3) aux couleurs du thème ; celle d'AvalonEdit est blanche. -->
            <Style TargetType="search:SearchPanel">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="search:SearchPanel">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="5" Margin="0,6,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Arrow">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Name="PART_searchTextBox" Width="210" Padding="6,3"
                                             Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Content="{l:Tr 'Aa'}" MinWidth="0" Margin="8,0,0,0" ToolTip="{l:Tr 'Match case'}"
                                              IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <CheckBox Content="{l:Tr 'Word'}" MinWidth="0" Margin="4,0,0,0" ToolTip="{l:Tr 'Whole word'}"
                                              IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.ChevronUp}" Margin="4,0,0,0" ToolTip="{l:Tr 'Previous (Shift+F3)'}"
                                            Command="search:SearchCommands.FindPrevious" />
                                    <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.ChevronDown}" ToolTip="{l:Tr 'Next (F3)'}"
                                            Command="search:SearchCommands.FindNext" />
                                    <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Close}" ToolTip="{l:Tr 'Close (Esc)'}"
                                            Command="search:SearchCommands.CloseSearchPanel" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource HubBackgroundBrush}">
        <!-- Barre d'outils : fil d'Ariane à gauche, actions à droite -->
        <Border DockPanel.Dock="Top" Padding="12,6" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding FormatCommand}" ToolTip="{l:Tr 'Reindent the file (Ctrl+Shift+F)'}"
                            Visibility="{Binding IsJava, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Format}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr 'Format'}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnFindClick" ToolTip="{l:Tr 'Find and replace in the file'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Search}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr 'Find'}" />
                            <TextBlock Style="{StaticResource ShortcutHint}" Text="{l:Tr 'Ctrl+F'}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryToolbarButton}" Command="{Binding SaveCommand}" ToolTip="{l:Tr 'Save this file'}"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Save}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:Tr 'Save'}" />
                            <TextBlock Style="{StaticResource ShortcutHint}" Text="{l:Tr 'Ctrl+S'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Breadcrumb}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type docs:BreadcrumbSegment}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource HintBrush}" />
                                <TextBlock x:Name="Separator" Text="  &#x203A;  " FontSize="12" Foreground="{DynamicResource HintBrush}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Bandeau : code généré (avec Verrouiller), code verrouillé (avec Déverrouiller), erreur d'enregistrement -->
        <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="10,8,10,2"
                Visibility="{Binding Banner, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Command="{Binding LockCommand}" Margin="10,0,0,0"
                        Visibility="{Binding CanLock, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                        ToolTip="{l:Tr 'Mine Engine will no longer rewrite this file: you will be able to edit it by hand'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Lock}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr 'Lock to edit'}" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Command="{Binding UnlockCommand}" Margin="10,0,0,0"
                        Visibility="{Binding CanUnlock, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                        ToolTip="{l:Tr 'Give the file back to Mine Engine: it will be regenerated at the next build and the changes made by hand will be lost'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Unlock}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr 'Unlock'}" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" Margin="0,2,8,0"
                           Foreground="{DynamicResource AccentLineBrush}" />
                <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <avalonEdit:TextEditor x:Name="Editor"
                               IsReadOnly="{Binding IsReadOnly}"
                               ShowLineNumbers="True"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="{DynamicResource CodeFontSize}"
                               WordWrap="{DynamicResource CodeWordWrap}"
                               Padding="6,4,0,0"
                               Background="{DynamicResource HubBackgroundBrush}"
                               Foreground="{DynamicResource StrongTextBrush}"
                               LineNumbersForeground="{DynamicResource HintBrush}"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
