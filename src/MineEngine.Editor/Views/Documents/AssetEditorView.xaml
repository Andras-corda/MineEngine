<UserControl x:Class="MineEngine.Editor.Views.Documents.AssetEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MineEngine.Editor.Views">

    <!--
        Editing tab of an element of the mod. DataContext: AssetEditorDocumentViewModel.
        The editor comes from the templates of InspectorTemplates.xaml (one per asset type),
        centered in the tab, without the header and the General card shown in the Inspector.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
                <ResourceDictionary Source="../InspectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- In the tab, the General card (type, name, identifier) is left to the Inspector. -->
            <DataTemplate x:Key="CommonAssetFields" />
            <HorizontalAlignment x:Key="AssetTabsAlignment">Center</HorizontalAlignment>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource HubBackgroundBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28" MaxWidth="760" HorizontalAlignment="Center">
            <!-- Editor of the asset (name and identifier are edited in the Inspector) -->
            <ContentControl Content="{Binding Asset}" Focusable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
