<UserControl x:Class="MineEngine.Editor.Views.Graphs.GraphDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:graphs="clr-namespace:MineEngine.Editor.ViewModels.Graphs"
             xmlns:assets="clr-namespace:MineEngine.Editor.ViewModels.Assets"
             xmlns:local="clr-namespace:MineEngine.Editor.Views.Graphs"
             Focusable="True" FocusVisualStyle="{x:Null}">

    <!--
        Éditeur nodal (façon Blueprints d'Unreal). DataContext : GraphDocumentViewModel.
        Les nœuds et les fils sont dessinés dans un canevas "monde" que la vue déplace et
        zoome ; les gestes de la souris sont gérés par le code-behind.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:PinTypeBrushConverter x:Key="PinBrush" />
            <local:NodeCategoryBrushConverter x:Key="CategoryBrush" />
            <local:CommentBrushConverter x:Key="CommentBrush" />

            <!-- Broche : triangle pour l'exécution, rond pour une valeur ; pleine quand elle est reliée. -->
            <DataTemplate x:Key="PinTemplate" DataType="{x:Type graphs:GraphPinViewModel}">
                <Border x:Name="Hit" Tag="pin" Width="18" Height="18" Background="Transparent" Cursor="Cross"
                        ToolTip="{Binding ToolTipText}">
                    <Grid>
                        <Ellipse x:Name="Dot" Width="10" Height="10" StrokeThickness="2"
                                 Stroke="{Binding Type, Converter={StaticResource PinBrush}}" Fill="Transparent" />
                        <Path x:Name="Arrow" Data="M 0,0 L 8,5 L 0,10 Z" StrokeThickness="1.6" Visibility="Collapsed"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"
                              Stroke="{DynamicResource StrongTextBrush}" Fill="Transparent" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter TargetName="Dot" Property="Fill" Value="{Binding Type, Converter={StaticResource PinBrush}}" />
                        <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource StrongTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExec}" Value="True">
                        <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding CanConnect}" Value="False">
                        <Setter TargetName="Hit" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="NodeField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="4,1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="2,2,6,2" />
            </Style>

            <!-- Entrée : broche, libellé et, si elle n'est pas reliée, sa valeur. -->
            <DataTemplate x:Key="InputTemplate" DataType="{x:Type graphs:GraphPinViewModel}">
                <StackPanel Orientation="Horizontal" MinHeight="24">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PinTemplate}" Focusable="False" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="2,0,6,0" FontSize="12"
                               Foreground="{DynamicResource BadgeTextBrush}" />
                    <TextBox x:Name="Number" Style="{StaticResource NodeField}" Width="56" Visibility="Collapsed"
                             Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="Text" Style="{StaticResource NodeField}" Width="130" Visibility="Collapsed"
                             Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox x:Name="Flag" Visibility="Collapsed" MinWidth="0" Margin="2,0,6,0" VerticalAlignment="Center"
                              IsChecked="{Binding BoolValue}" />
                    <ComboBox x:Name="Choice" Visibility="Collapsed" Width="130" Margin="2,2,6,2" FontSize="12" MinHeight="0"
                              ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}" DisplayMemberPath="Name" />
                    <ComboBox x:Name="Suggest" Visibility="Collapsed" Width="150" Margin="2,2,6,2" FontSize="12" MinHeight="0"
                              IsEditable="True" IsTextSearchEnabled="False" FontFamily="Consolas" ItemsSource="{Binding Suggestions}"
                              Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" />
                    <ComboBox x:Name="Reference" Visibility="Collapsed" Width="170" Margin="2,2,6,2" FontSize="12"
                              IsEditable="True" IsTextSearchEnabled="False" FontFamily="Consolas"
                              ItemsSource="{Binding Picker.Suggestions}" ToolTip="{Binding Picker.Text}"
                              Text="{Binding Picker.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static graphs:PinEditorKind.Number}">
                        <Setter TargetName="Number" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static graphs:PinEditorKind.Text}">
                        <Setter TargetName="Text" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static graphs:PinEditorKind.Boolean}">
                        <Setter TargetName="Flag" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static graphs:PinEditorKind.Reference}">
                        <Setter TargetName="Reference" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static graphs:PinEditorKind.Choice}">
                        <Setter TargetName="Choice" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static graphs:PinEditorKind.Suggest}">
                        <Setter TargetName="Suggest" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Sortie : libellé puis broche, alignés à droite. -->
            <DataTemplate x:Key="OutputTemplate" DataType="{x:Type graphs:GraphPinViewModel}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" MinHeight="24">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="6,0,2,0" FontSize="12"
                               Foreground="{DynamicResource BadgeTextBrush}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PinTemplate}" Focusable="False" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <!-- Un nœud. -->
            <DataTemplate x:Key="NodeTemplate" DataType="{x:Type graphs:GraphNodeViewModel}">
                <Border x:Name="NodeRoot" Tag="node" MinWidth="170" CornerRadius="7" BorderThickness="1.5"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        SizeChanged="OnNodeSizeChanged" Loaded="OnNodeLoaded" PreviewMouseLeftButtonDown="OnNodePreviewMouseDown"
                        ToolTipService.ShowOnDisabled="True" ToolTip="{Binding HoverText}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
                    </Border.Effect>
                    <StackPanel>
                        <Border x:Name="Header" Tag="header" CornerRadius="5.5,5.5,0,0" Padding="2,3"
                                Background="{Binding Category, Converter={StaticResource CategoryBrush}}" Cursor="SizeAll"
                                ToolTip="{Binding Description}">
                            <DockPanel>
                                <ContentControl DockPanel.Dock="Left" Content="{Binding ExecInput}" ContentTemplate="{StaticResource PinTemplate}"
                                                Focusable="False" />
                                <ContentControl DockPanel.Dock="Right" Content="{Binding ExecOutput}" ContentTemplate="{StaticResource PinTemplate}"
                                                Focusable="False" />
                                <!-- The node is described by a tooltip (T): its message shows over the node. -->
                                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" FontSize="11"
                                           Foreground="White" Opacity="0.85" VerticalAlignment="Center" Margin="4,0"
                                           ToolTip="{Binding AttachedTooltip}"
                                           Visibility="{Binding AttachedTooltip, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}" />
                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" Margin="6,0" />
                            </DockPanel>
                        </Border>
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource InputTemplate}" Focusable="False" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource OutputTemplate}" Focusable="False" />
                        </Grid>
                        <!-- Switch and Sequence: one more output, like "Add pin" in Blueprints. -->
                        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,-4,6,4" Padding="6,1" FontSize="11"
                                Command="{Binding AddPinCommand}" Visibility="{Binding CanAddPin, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{l:Tr 'Add an output (right-click on the node: remove the last one)'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.NewItem}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="{l:Tr 'Add pin'}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="NodeRoot" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasWarning}" Value="True">
                        <Setter TargetName="NodeRoot" Property="BorderBrush" Value="{DynamicResource LogWarningBrush}" />
                        <Setter TargetName="NodeRoot" Property="ToolTip" Value="{Binding IssueText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter TargetName="NodeRoot" Property="BorderBrush" Value="{DynamicResource LogErrorBrush}" />
                        <Setter TargetName="NodeRoot" Property="ToolTip" Value="{Binding IssueText}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                            <Condition Binding="{Binding HasError}" Value="False" />
                            <Condition Binding="{Binding HasWarning}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="NodeRoot" Property="BorderThickness" Value="2" />
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Redirection : un point sur le fil. Les deux côtés sont ses broches (on en tire un fil),
                 le point se déplace comme l'en-tête d'un nœud. Taille : GraphDocumentViewModel.RerouteWidth × RerouteHeight. -->
            <DataTemplate x:Key="RerouteTemplate" DataType="{x:Type graphs:GraphNodeViewModel}">
                <Grid x:Name="NodeRoot" Tag="node" Width="30" Height="18" Background="Transparent"
                      SizeChanged="OnNodeSizeChanged" Loaded="OnNodeLoaded" PreviewMouseLeftButtonDown="OnNodePreviewMouseDown"
                      ToolTip="{Binding Description}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="9" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="In" Tag="pin" DataContext="{Binding RerouteInput}" Background="Transparent" Cursor="Cross">
                        <Rectangle x:Name="InLine" Height="2.2" Width="5" HorizontalAlignment="Right"
                                   Fill="{Binding Type, Converter={StaticResource PinBrush}}" />
                    </Border>
                    <Border x:Name="Out" Grid.Column="2" Tag="pin" DataContext="{Binding RerouteOutput}" Background="Transparent" Cursor="Cross">
                        <Rectangle x:Name="OutLine" Height="2.2" Width="5" HorizontalAlignment="Left"
                                   Fill="{Binding Type, Converter={StaticResource PinBrush}}" />
                    </Border>
                    <Ellipse x:Name="Knot" Tag="header" Grid.Column="1" Width="12" Height="12" Cursor="SizeAll" StrokeThickness="1.5"
                             Fill="{Binding RerouteType, Converter={StaticResource PinBrush}}" Stroke="Transparent" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsExecReroute}" Value="True">
                        <Setter TargetName="Knot" Property="Fill" Value="{DynamicResource StrongTextBrush}" />
                        <Setter TargetName="InLine" Property="Fill" Value="{DynamicResource StrongTextBrush}" />
                        <Setter TargetName="OutLine" Property="Fill" Value="{DynamicResource StrongTextBrush}" />
                        <Setter TargetName="InLine" Property="Height" Value="2.8" />
                        <Setter TargetName="OutLine" Property="Height" Value="2.8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRerouteReference}" Value="True">
                        <Setter TargetName="In" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="Knot" Property="Stroke" Value="{Binding RerouteType, Converter={StaticResource PinBrush}}" />
                        <Setter TargetName="Knot" Property="Fill" Value="{DynamicResource HubBackgroundBrush}" />
                        <Setter TargetName="Knot" Property="StrokeThickness" Value="2.5" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Knot" Property="Stroke" Value="{DynamicResource AccentLineBrush}" />
                        <Setter TargetName="Knot" Property="Width" Value="14" />
                        <Setter TargetName="Knot" Property="Height" Value="14" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>


            <!-- Comment (C on a selection), like in Blueprints: its box is drawn behind the wires (CommentBackTemplate);
                 here only its title (moved like a header) and its resize grip catch the mouse. -->
            <DataTemplate x:Key="CommentTemplate" DataType="{x:Type graphs:GraphNodeViewModel}">
                <Grid x:Name="NodeRoot" Tag="node" Width="{Binding Width}" Height="{Binding Height}"
                      PreviewMouseLeftButtonDown="OnNodePreviewMouseDown">
                    <Border x:Name="Header" Tag="header" VerticalAlignment="Top" Height="34" CornerRadius="6,6,0,0" Cursor="SizeAll"
                            BorderThickness="2" BorderBrush="Transparent" ToolTip="{Binding HoverText}" ToolTipService.InitialShowDelay="200"
                            Background="{Binding CommentColor, Converter={StaticResource CommentBrush}, ConverterParameter=header}">
                        <DockPanel Margin="10,0">
                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" FontSize="12"
                                       Foreground="White" Opacity="0.8" VerticalAlignment="Center"
                                       Visibility="{Binding HoverText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}" />
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding AnnotationText}" FontSize="16" FontWeight="SemiBold" Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsEditingTitle, Converter={StaticResource InverseBoolToVisibility}}" />
                                <!-- Double-click on the title: it is edited here (Enter or Escape to finish). -->
                                <TextBox Tag="comment-edit" Text="{Binding AnnotationText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" MinHeight="0"
                                         Padding="4,1" Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVisibility}}"
                                         LostKeyboardFocus="OnCommentEditLostFocus" PreviewKeyDown="OnCommentEditKeyDown" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <!-- Edges and corners: resize, like the comments of Blueprints. -->
                    <Border Tag="resize:l" Width="6" HorizontalAlignment="Left" Margin="-3,34,0,8" Background="Transparent" Cursor="SizeWE" />
                    <Border Tag="resize:r" Width="6" HorizontalAlignment="Right" Margin="0,8,-3,8" Background="Transparent" Cursor="SizeWE" />
                    <Border Tag="resize:t" Height="5" VerticalAlignment="Top" Margin="8,-3,8,0" Background="Transparent" Cursor="SizeNS" />
                    <Border Tag="resize:b" Height="6" VerticalAlignment="Bottom" Margin="8,0,8,-3" Background="Transparent" Cursor="SizeNS" />
                    <Border Tag="resize:tl" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0" Background="Transparent" Cursor="SizeNWSE" />
                    <Border Tag="resize:tr" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Background="Transparent" Cursor="SizeNESW" />
                    <Border Tag="resize:bl" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4" Background="Transparent" Cursor="SizeNESW" />
                    <Border Tag="resize:br" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" Background="Transparent"
                            Cursor="SizeNWSE" ToolTip="{l:Tr 'Resize the comment'}">
                        <Path Data="M 15,5 L 5,15 M 15,10 L 10,15" Stroke="{DynamicResource HintBrush}" StrokeThickness="1.4" />
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Box of a comment, behind the wires and the nodes. -->
            <DataTemplate x:Key="CommentBackTemplate" DataType="{x:Type graphs:GraphNodeViewModel}">
                <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="6" BorderThickness="1.5"
                        Background="{Binding CommentColor, Converter={StaticResource CommentBrush}, ConverterParameter=fill}"
                        BorderBrush="{Binding CommentColor, Converter={StaticResource CommentBrush}, ConverterParameter=header}" />
            </DataTemplate>

            <DataTemplate x:Key="NothingTemplate">
                <Grid />
            </DataTemplate>

            <!-- Tooltip (T on a selection): a small bubble; its message shows when the mouse is over it or over the nodes it describes. -->
            <DataTemplate x:Key="TooltipTemplate" DataType="{x:Type graphs:GraphNodeViewModel}">
                <Border x:Name="NodeRoot" Tag="node" Background="Transparent" PreviewMouseLeftButtonDown="OnNodePreviewMouseDown"
                        ToolTip="{Binding HoverText}" ToolTipService.InitialShowDelay="100">
                    <Border x:Name="Bubble" Tag="header" Cursor="SizeAll" CornerRadius="11,11,11,2" Padding="7,3" BorderThickness="1.5"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentLineBrush}" />
                            <TextBlock Text="{l:Tr 'Tooltip'}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                        </StackPanel>
                    </Border>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                        <Setter TargetName="Bubble" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <local:NodeTemplateSelector x:Key="NodeTemplates" NodeTemplate="{StaticResource NodeTemplate}" RerouteTemplate="{StaticResource RerouteTemplate}"
                                        CommentTemplate="{StaticResource CommentTemplate}" TooltipTemplate="{StaticResource TooltipTemplate}" />
            <local:NodeTemplateSelector x:Key="BackTemplates" NodeTemplate="{StaticResource NothingTemplate}" RerouteTemplate="{StaticResource NothingTemplate}"
                                        CommentTemplate="{StaticResource CommentBackTemplate}" TooltipTemplate="{StaticResource NothingTemplate}" />

            <!-- Fil entre deux broches. -->
            <DataTemplate x:Key="ConnectionTemplate" DataType="{x:Type graphs:GraphConnectionViewModel}">
                <Grid>
                    <!-- Halo of the wire under the mouse (Backspace breaks it). -->
                    <Path x:Name="Halo" Data="{Binding Geometry}" StrokeThickness="8" IsHitTestVisible="False" Opacity="0.35"
                          Stroke="{DynamicResource AccentLineBrush}" Visibility="Collapsed" />
                    <Path x:Name="Wire" Data="{Binding Geometry}" StrokeThickness="2.2" IsHitTestVisible="False"
                          Stroke="{Binding Type, Converter={StaticResource PinBrush}}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsExec}" Value="True">
                        <Setter TargetName="Wire" Property="Stroke" Value="{DynamicResource StrongTextBrush}" />
                        <Setter TargetName="Wire" Property="StrokeThickness" Value="2.8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsHovered}" Value="True">
                        <Setter TargetName="Halo" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Wire" Property="StrokeThickness" Value="3.6" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Entrée du menu d'ajout. -->
            <DataTemplate x:Key="ChoiceTemplate" DataType="{x:Type graphs:NodeChoiceViewModel}">
                <DockPanel Margin="0,2">
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,0,8,0"
                            Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CategoryLabel}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource HintBrush}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource HintBrush}" />
                    </StackPanel>
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Corps en nœuds sur toute la largeur (la définition est dans l'Inspecteur) ; une structure, une interface ou une énumération montre sa définition ici. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="DefinitionColumn" Width="320" MinWidth="220" />
            <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
            <ColumnDefinition x:Name="BodyColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <local:DefinitionPanel x:Name="DefinitionPane" DataContext="{Binding Definition}" />
        <GridSplitter x:Name="DefinitionSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}"
                      ResizeBehavior="PreviousAndNext" />

    <Grid x:Name="Root" Grid.Column="2" Background="{DynamicResource HubBackgroundBrush}" ClipToBounds="True"
          MouseLeftButtonDown="OnRootMouseLeftButtonDown" MouseRightButtonDown="OnRootMouseRightButtonDown"
          MouseDown="OnRootMouseDown" MouseMove="OnRootMouseMove" MouseLeave="OnRootMouseLeave" MouseUp="OnRootMouseUp" MouseWheel="OnRootMouseWheel"
          LostMouseCapture="OnRootLostMouseCapture" SizeChanged="OnRootSizeChanged"
          AllowDrop="True" DragOver="OnRootDragOver" Drop="OnRootDrop">

        <!-- Quadrillage (déplacé et zoomé avec le monde) -->
        <Rectangle x:Name="GridLayer" IsHitTestVisible="False" Visibility="{DynamicResource GraphGridVisibility}" />

        <!-- Monde : fils, fil en cours, nœuds -->
        <Canvas x:Name="World" IsHitTestVisible="True">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Zoom" />
                    <TranslateTransform x:Name="Pan" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <!-- Boxes of the comments, behind everything else. -->
            <ItemsControl ItemsSource="{Binding Nodes}" ItemTemplateSelector="{StaticResource BackTemplates}" Focusable="False" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Connections}" ItemTemplate="{StaticResource ConnectionTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Path x:Name="PendingWire" StrokeThickness="2.2" StrokeDashArray="4 2" IsHitTestVisible="False" Visibility="Collapsed" />
            <ItemsControl x:Name="NodesHost" ItemsSource="{Binding Nodes}" ItemTemplateSelector="{StaticResource NodeTemplates}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Style.Triggers>
                            <!-- The title of a comment stays under the nodes it frames. -->
                            <DataTrigger Binding="{Binding IsComment}" Value="True">
                                <Setter Property="Panel.ZIndex" Value="-1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Canvas>

        <!-- Rectangle de sélection (coordonnées de l'écran) -->
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="Marquee" Visibility="Collapsed" StrokeThickness="1" StrokeDashArray="3 2"
                       Stroke="{DynamicResource AccentLineBrush}" Fill="{DynamicResource CardSelectedBrush}" Opacity="0.6" />
        </Canvas>

        <!-- Graphe vide -->
        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" IsHitTestVisible="False"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{l:Tr 'Empty graph'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource HintBrush}"
                           Text="{l:Tr 'Right-click to add a node. Start with an event (&quot;Right-click on a block&quot;), then connect its white output to a condition or an action.'}" />
            </StackPanel>
        </Border>

        <!-- Barre d'outils -->
        <Border Style="{StaticResource Card}" Padding="6,4" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Badge}" VerticalAlignment="Center" Margin="4,0,8,0">
                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding KindLabel}" />
                </Border>
                <Button Style="{StaticResource FlatButton}" Click="OnAddNodeClick" ToolTip="{l:Tr 'Add a node (right-click in the graph)'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.NewItem}" />
                        <TextBlock Text="{l:Tr 'Add a node'}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="OnFrameAllClick" ToolTip="{l:Tr 'Show the whole graph (F)'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.FullScreen}" />
                        <TextBlock Text="{l:Tr 'Show all'}" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="ZoomLabel" Text="100 %" VerticalAlignment="Center" Margin="8,0,6,0" FontSize="12"
                           Foreground="{DynamicResource HintBrush}" />
            </StackPanel>
        </Border>

        <!-- Snapping to the grid: moved nodes stay aligned, and the wires straight. -->
        <Border Style="{StaticResource Card}" Padding="4" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top">
            <ToggleButton IsChecked="{Binding Options.SnapToGrid}" Padding="8,3" MinHeight="0" Focusable="False"
                          AutomationProperties.Name="{l:Tr 'Snap to the grid'}"
                          ToolTip="{l:Tr 'Snap to the grid: moved nodes and resized comments are placed on the grid, so that they stay aligned and the wires stay straight. Same option as Settings > Editors.'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.GridView}" />
                    <TextBlock Text="{l:Tr 'Grid'}" />
                </StackPanel>
            </ToggleButton>
        </Border>

        <!-- Aide et messages -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" IsHitTestVisible="False">
            <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,6"
                    Visibility="{Binding StatusText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" MaxWidth="480" />
            </Border>
            <TextBlock FontSize="11" Foreground="{DynamicResource HintBrush}" TextWrapping="Wrap"
                       Text="{l:Tr 'Right-click: add (on a node: align...) · Drag a pin: connect · Alt+click: disconnect · Right-drag or middle button: pan · Wheel: zoom · Del or Backspace: delete · Ctrl+D: duplicate · Double-click a wire: reroute · C: comment · T: tooltip'}" />
        </StackPanel>

        <!-- Menu d'ajout de nœud (placé au point du clic) -->
        <Canvas>
            <Border x:Name="Palette" Visibility="Collapsed" Width="340" Style="{StaticResource Card}" Padding="8"
                    Background="{DynamicResource SidebarBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelCaption}" Text="{l:Tr 'ADD A NODE'}" Margin="2,0,0,6" />
                    <TextBox x:Name="PaletteSearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                             Text="{Binding PaletteSearch, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnPaletteSearchKeyDown" />
                    <ListBox x:Name="PaletteList" MaxHeight="330" ItemsSource="{Binding PaletteChoices}" ItemTemplate="{StaticResource ChoiceTemplate}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseUp="OnPaletteListMouseUp" KeyDown="OnPaletteListKeyDown" />
                </DockPanel>
            </Border>
        </Canvas>
    </Grid>
    </Grid>
</UserControl>
