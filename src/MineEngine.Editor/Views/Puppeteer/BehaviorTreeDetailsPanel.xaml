<UserControl x:Class="MineEngine.Editor.Views.Puppeteer.BehaviorTreeDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:bt="clr-namespace:MineEngine.Editor.ViewModels.Puppeteer"
             xmlns:local="clr-namespace:MineEngine.Editor.Views.Puppeteer">

    <!--
        Puppeteer part of the Inspector: settings of the selected node, decorator or service,
        its decorators and services, then the blackboard of the tree.
        DataContext: BehaviorTreeDocumentViewModel.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BtCategoryBrushConverter x:Key="CategoryBrush" />

            <!-- A setting in Details: label, then a field depending on its type. -->
            <DataTemplate x:Key="ParameterTemplate" DataType="{x:Type bt:BtParameterViewModel}">
                <StackPanel Margin="0,0,0,8">
                    <DockPanel x:Name="LabelRow">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Range}" FontSize="11" Foreground="{DynamicResource HintBrush}" VerticalAlignment="Bottom" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" ToolTip="{Binding Hint}" />
                    </DockPanel>
                    <TextBox x:Name="Number" Visibility="Collapsed" Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox x:Name="Flag" Visibility="Collapsed" Content="{Binding Label}" IsChecked="{Binding BoolValue}" />
                    <ComboBox x:Name="Choice" Visibility="Collapsed" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}" DisplayMemberPath="Label" />
                    <ComboBox x:Name="Key" Visibility="Collapsed" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding KeyValue}" DisplayMemberPath="Label" />
                    <TextBlock x:Name="KeyHint" Visibility="Collapsed" Style="{StaticResource FieldHint}" Text="{Binding MissingKeyHint}"
                               Foreground="{DynamicResource LogWarningBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <ComboBox x:Name="Goal" Visibility="Collapsed" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding GoalOptions}" SelectedValuePath="Value" SelectedValue="{Binding GoalValue}" DisplayMemberPath="Label" />
                    <TextBlock x:Name="GoalHint" Visibility="Collapsed" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{DynamicResource LogWarningBrush}"
                               Text="{l:Tr 'No public goal yet: open another tree and tick &quot;Public goal&quot;.'}" />
                    <ComboBox x:Name="Sound" Visibility="Collapsed" HorizontalAlignment="Stretch" IsEditable="True" IsTextSearchEnabled="False"
                              FontFamily="Consolas" ItemsSource="{Binding Picker.Suggestions}" ToolTip="{Binding Picker.Text}"
                              Text="{Binding Picker.Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static bt:BtEditorKind.Number}">
                        <Setter TargetName="Number" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static bt:BtEditorKind.Boolean}">
                        <Setter TargetName="Flag" Property="Visibility" Value="Visible" />
                        <Setter TargetName="LabelRow" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static bt:BtEditorKind.Choice}">
                        <Setter TargetName="Choice" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static bt:BtEditorKind.Key}">
                        <Setter TargetName="Key" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasNoCompatibleKey}" Value="True">
                        <Setter TargetName="KeyHint" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static bt:BtEditorKind.Goal}">
                        <Setter TargetName="Goal" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasNoGoal}" Value="True">
                        <Setter TargetName="GoalHint" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Editor}" Value="{x:Static bt:BtEditorKind.Sound}">
                        <Setter TargetName="Sound" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Decorator or service listed in Details: a click selects it. -->
            <DataTemplate x:Key="AttachmentRowTemplate" DataType="{x:Type bt:BtAttachmentViewModel}">
                <DockPanel Margin="0,0,0,3">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}"
                            ToolTip="{l:Tr 'Remove'}" Click="OnRemoveAttachmentClick" />
                    <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Stretch" Padding="0,2" Click="OnSelectAttachmentClick">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,0,8,0"
                                    Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                                <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource HintBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DockPanel>
            </DataTemplate>

            <!-- Blackboard key: name, type, uses, deletion. -->
            <DataTemplate x:Key="KeyTemplate" DataType="{x:Type bt:BlackboardKeyViewModel}">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,0,6,0"
                             ToolTip="{Binding UsageLabel}" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static bt:BlackboardKeyViewModel.Types}" SelectedItem="{Binding Type}" DisplayMemberPath="Label"
                              HorizontalAlignment="Stretch" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Margin="4,0,0,0"
                            ToolTip="{l:Tr 'Delete the key'}" Click="OnRemoveKeyClick" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- The tree itself -->
        <Border Style="{StaticResource DetailsSection}">
            <StackPanel>
                <CheckBox Content="{l:Tr 'Public goal'}" IsChecked="{Binding IsPublicGoal}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{l:Tr 'A public goal can be reused by the other trees of the project with the &quot;Run a goal&quot; task (it shares the blackboard of the mob).'}" />
            </StackPanel>
        </Border>

        <!-- Selected element -->
        <Border Style="{StaticResource DetailsSection}">
            <StackPanel>
                <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'SELECTED NODE'}" Margin="0,0,0,8" />

                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="{l:Tr 'Select a node, a decorator (blue, above) or a service (green, below) to see and change its settings.'}" />

                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="0,0,0,4">
                        <Border DockPanel.Dock="Left" Width="5" CornerRadius="2" Margin="0,0,8,0"
                                Background="{Binding SelectedItem.Category, Converter={StaticResource CategoryBrush}}" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding SelectedItem.CategoryLabel}" />
                        </Border>
                        <TextBlock Text="{Binding SelectedItem.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding SelectedItem.Description}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource HintBrush}" />
                    <TextBlock Text="{Binding SelectedItem.IssueText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource LogWarningBrush}"
                               Visibility="{Binding SelectedItem.IssueText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}" />

                    <ItemsControl ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource ParameterTemplate}" Focusable="False" />

                    <!-- Attached piece: order and removal -->
                    <WrapPanel Visibility="{Binding SelectedAttachment, Converter={StaticResource NullToCollapsed}}" Margin="0,4,0,0">
                        <Button Content="{l:Tr 'Move up'}" Padding="10,4" Margin="0,0,6,6" Click="OnMoveAttachmentUpClick" />
                        <Button Content="{l:Tr 'Move down'}" Padding="10,4" Margin="0,0,6,6" Click="OnMoveAttachmentDownClick" />
                        <Button Content="{l:Tr 'Remove'}" Padding="10,4" Margin="0,0,6,6" Click="OnRemoveSelectedAttachmentClick" />
                        <Button Content="{l:Tr 'Show the node'}" Padding="10,4" Margin="0,0,6,6" Click="OnSelectOwnerClick" />
                    </WrapPanel>

                    <!-- Node: its decorators and services -->
                    <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel Visibility="{Binding SelectedNode.HasParentPin, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,8,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnAddDecoratorClick" Padding="4,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.NewItem}" />
                                        <TextBlock Text="{l:Tr 'Add'}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'DECORATORS'}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedNode.Decorators.Count, Converter={StaticResource ZeroToVisible}}"
                                       Text="{l:Tr 'Conditions (the node only starts if they are true) or modifiers (loop, cooldown...).'}" />
                            <ItemsControl ItemsSource="{Binding SelectedNode.Decorators}" ItemTemplate="{StaticResource AttachmentRowTemplate}" Focusable="False" />

                            <DockPanel Margin="0,10,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnAddServiceClick" Padding="4,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.NewItem}" />
                                        <TextBlock Text="{l:Tr 'Add'}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'SERVICES'}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedNode.Services.Count, Converter={StaticResource ZeroToVisible}}"
                                       Text="{l:Tr 'Regular updates of the blackboard while the node runs (spot a target...).'}" />
                            <ItemsControl ItemsSource="{Binding SelectedNode.Services}" ItemTemplate="{StaticResource AttachmentRowTemplate}" Focusable="False" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Blackboard -->
        <Border Style="{StaticResource DetailsSection}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnAddKeyClick" Padding="4,1"
                            ToolTip="{l:Tr 'Add a key to the blackboard'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.NewItem}" />
                            <TextBlock Text="{l:Tr 'Key'}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource PanelCaption}" Text="BLACKBOARD" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="{l:Tr 'The memory of the mob: nodes store and read values in it (target, position, counter...). Each mob has its own.'}" />
                <ItemsControl ItemsSource="{Binding Keys}" ItemTemplate="{StaticResource KeyTemplate}" Focusable="False" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
