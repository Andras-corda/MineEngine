<Window x:Class="MineEngine.Editor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Width="560" Height="380" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary Source="EditorStyles.xaml" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="100" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Annuler" IsCancel="True" MinWidth="100" Padding="10,4" />
        </StackPanel>

        <TabControl>
            <TabItem Header="Apparence">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource PanelTitle}" Text="Thème" />
                    <RadioButton GroupName="Theme" Margin="0,4" IsChecked="{Binding IsSystemTheme}"
                                 Content="Identique à Windows" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="28,0,0,6"
                               Text="Passe automatiquement en clair ou en sombre selon le réglage de Windows." />
                    <RadioButton GroupName="Theme" Margin="0,4" IsChecked="{Binding IsLightTheme}" Content="Clair" />
                    <RadioButton GroupName="Theme" Margin="0,4" IsChecked="{Binding IsDarkTheme}" Content="Sombre" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                               Text="Le thème est appliqué immédiatement pour vous permettre de le voir. Annuler rétablit le thème précédent." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
