<Window x:Class="MineEngine.Editor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MineEngine.Editor.Localization"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource HubBackgroundBrush}"
        Title="{l:Tr 'Paramètres'}"
        Width="600" Height="540" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Tr 'Enregistrer'}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110"
                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
            <Button Content="{l:Tr 'Annuler'}" IsCancel="True" MinWidth="110" />
        </StackPanel>

        <TabControl Style="{StaticResource UnderlineTabControl}">
            <TabItem Header="{l:Tr 'Apparence'}">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Thème'}" />
                    <RadioButton GroupName="Theme" Margin="0,4" IsChecked="{Binding IsSystemTheme}" Content="{l:Tr 'Identique à Windows'}" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="28,0,0,6"
                               Text="{l:Tr 'Passe automatiquement en clair ou en sombre selon le réglage de Windows.'}" />
                    <RadioButton GroupName="Theme" Margin="0,4" IsChecked="{Binding IsLightTheme}" Content="{l:Tr 'Clair'}" />
                    <RadioButton GroupName="Theme" Margin="0,4" IsChecked="{Binding IsDarkTheme}" Content="{l:Tr 'Sombre'}" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                               Text="{l:Tr 'Le thème est appliqué immédiatement pour vous permettre de le voir. Annuler rétablit le thème précédent.'}" />

                    <TextBlock Style="{StaticResource PanelTitle}" Margin="0,20,0,6" Text="{l:Tr 'Langue'}" />
                    <ComboBox Width="300" HorizontalAlignment="Left" ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding Language}" DisplayMemberPath="NativeName" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                               Text="{l:Tr 'La nouvelle langue sera utilisée au prochain démarrage de Mine Engine.'}"
                               Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{l:Tr 'Sauvegarde'}">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Sauvegarde automatique'}" />
                    <ui:NumberBox Header="{l:Tr 'Intervalle (minutes)'}" Width="300" HorizontalAlignment="Left"
                                  Minimum="0" Maximum="{Binding MaxAutoSaveMinutes}" SmallChange="1" LargeChange="5"
                                  SpinButtonPlacementMode="Inline"
                                  Value="{Binding AutoSaveMinutes, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,16"
                               Text="{l:Tr 'Le projet ouvert est enregistré automatiquement à cet intervalle s\'il a été modifié. 0 désactive la sauvegarde automatique.'}" />

                    <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Sauvegardes de secours'}" />
                    <ui:NumberBox Header="{l:Tr 'Nombre de sauvegardes conservées'}" Width="300" HorizontalAlignment="Left"
                                  Minimum="1" Maximum="{Binding MaxBackupsToKeep}" SmallChange="1" LargeChange="5"
                                  SpinButtonPlacementMode="Inline"
                                  Value="{Binding BackupsToKeep, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                               Text="{l:Tr 'À chaque enregistrement (au plus une fois toutes les 10 minutes), une copie du projet est rangée dans .mineengine\\backups. Les plus anciennes sont supprimées.'}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
