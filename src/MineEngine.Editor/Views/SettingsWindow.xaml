<Window x:Class="MineEngine.Editor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MineEngine.Editor.Localization"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:MineEngine.Editor.ViewModels"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource HubBackgroundBrush}"
        Title="{l:Tr 'Settings'}"
        Width="800" Height="700" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
                <Setter Property="Margin" Value="0,18,0,6" />
            </Style>

            <Style x:Key="SettingsCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,2" />
            </Style>

            <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinWidth" Value="100" />
            </Style>

            <!-- Raccourcis regroupés par menu. -->
            <CollectionViewSource x:Key="ShortcutGroups" Source="{Binding Shortcuts}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Category" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <!-- Liste de choix sous forme de cartes (thèmes, langues). -->
            <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="{l:Tr 'Restore defaults'}" Command="{Binding ResetCommand}" MinWidth="110" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Tr 'Save'}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="110"
                        Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
                <Button Content="{l:Tr 'Cancel'}" IsCancel="True" MinWidth="110" />
            </StackPanel>
        </DockPanel>

        <TabControl Style="{StaticResource UnderlineTabControl}">
            <!-- Général -->
            <TabItem Header="{l:Tr 'General'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Startup'}" />
                        <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding ReopenLastProject}"
                                  Content="{l:Tr 'Reopen the last project at startup'}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="28,0,0,0"
                                   Text="{l:Tr 'Otherwise, Mine Engine opens on the home page.'}" />

                        <TextBlock Style="{StaticResource SettingsSection}" Text="{l:Tr 'Dashboard'}" />
                        <RadioButton GroupName="DashboardView" IsChecked="{Binding DashboardListView}" Margin="0,4"
                                     Content="{l:Tr 'List'}" AutomationProperties.Name="{l:Tr 'Dashboard as a list'}" />
                        <RadioButton GroupName="DashboardView" IsChecked="{Binding DashboardTileView}" Margin="0,4"
                                     Content="{l:Tr 'Grid (tiles)'}" AutomationProperties.Name="{l:Tr 'Dashboard as a grid'}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                   Text="{l:Tr 'Display of the elements when a project opens; the buttons of the toolbar still switch it.'}" />

                        <TextBlock Style="{StaticResource SettingsSection}" Text="{l:Tr 'Autosave'}" />
                        <ui:NumberBox Header="{l:Tr 'Interval (minutes)'}" Width="300" HorizontalAlignment="Left"
                                      Minimum="0" Maximum="{Binding MaxAutoSaveMinutes}" SmallChange="1" LargeChange="5"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding AutoSaveMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                   Text="{l:Tr 'The open project is saved automatically at this interval if it was changed. 0 turns autosave off.'}" />

                        <TextBlock Style="{StaticResource SettingsSection}" Text="{l:Tr 'Backups'}" />
                        <ui:NumberBox Header="{l:Tr 'Number of backups kept'}" Width="300" HorizontalAlignment="Left"
                                      Minimum="1" Maximum="{Binding MaxBackupsToKeep}" SmallChange="1" LargeChange="5"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding BackupsToKeep, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                   Text="{l:Tr 'At each save (at most once every 10 minutes), a copy of the project is stored in .mineengine\\backups. The oldest ones are deleted.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Apparence -->
            <TabItem Header="{l:Tr 'Appearance'}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Style="{StaticResource SettingsSection}" Text="{l:Tr 'Accent color'}" />
                        <ListBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="ToolTip" Value="{Binding Name}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="22" Height="22">
                                        <Ellipse Fill="{Binding Swatch}" Stroke="{DynamicResource HintBrush}" StrokeThickness="1" />
                                        <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource HintBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Color}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0" Text="{Binding SelectedAccent.Name}" />

                        <TextBlock Style="{StaticResource SettingsSection}" Text="{l:Tr 'Interface size'}" />
                        <ComboBox Width="160" HorizontalAlignment="Left" ItemsSource="{Binding ScaleChoices}"
                                  SelectedItem="{Binding SelectedScale}" DisplayMemberPath="Label" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                   Text="{l:Tr 'Makes the text and controls of every window larger or smaller. Applied when you save.'}" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitle}" Text="{l:Tr 'Theme'}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                               Text="{l:Tr 'The theme is applied immediately so you can see it. Cancel restores the previous theme. Export writes the theme with all its colors: edit it, then import it to create your own.'}" />

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldHint}" Margin="0,4,0,0" Text="{Binding ThemeMessage}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource SettingsButton}" Content="{l:Tr 'Import...'}" Command="{Binding ImportThemeCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="{l:Tr 'Export...'}" Command="{Binding ExportThemeCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="{l:Tr 'Delete'}" Command="{Binding RemoveThemeCommand}" />
                    </StackPanel>
                    <ListBox x:Name="ThemeList" Style="{StaticResource ChoiceList}" MinHeight="120"
                             ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <!-- Aperçu : fond, carte, texte et accent du thème -->
                                    <Border DockPanel.Dock="Left" Width="56" Height="32" CornerRadius="4" Margin="0,0,12,0"
                                            Background="{Binding Background}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid Margin="5">
                                            <Border Background="{Binding Card}" CornerRadius="2" />
                                            <Border Width="18" Height="3" Background="{Binding Text}" CornerRadius="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" />
                                            <Border Width="12" Height="6" Background="{Binding Accent}" CornerRadius="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource StrongTextBrush}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource FieldHint}" Margin="0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Langue -->
            <TabItem Header="{l:Tr 'Language'}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitle}" Text="{l:Tr 'Interface language'}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                               Text="{l:Tr 'To translate Mine Engine, export a template: it contains every interface text with its English version. Texts an imported language does not translate stay in English.'}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                               Text="{l:Tr 'The new language will be used the next time Mine Engine starts.'}"
                               Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldHint}" Margin="0,4,0,0" Text="{Binding LanguageMessage}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource SettingsButton}" Content="{l:Tr 'Import...'}" Command="{Binding ImportLanguageCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="{l:Tr 'Export a template...'}" Command="{Binding ExportLanguageTemplateCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="{l:Tr 'Delete'}" Command="{Binding RemoveLanguageCommand}" />
                    </StackPanel>
                    <ListBox Style="{StaticResource ChoiceList}" MinHeight="120"
                             ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource StrongTextBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource FieldHint}" Margin="0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Éditeurs -->
            <TabItem Header="{l:Tr 'Editors'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Code editor'}" />
                        <ui:NumberBox Header="{l:Tr 'Text size'}" Width="300" HorizontalAlignment="Left"
                                      Minimum="{Binding MinCodeFontSize}" Maximum="{Binding MaxCodeFontSize}" SmallChange="1" LargeChange="2"
                                      SpinButtonPlacementMode="Inline"
                                      Value="{Binding CodeFontSize, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Style="{StaticResource SettingsCheck}" Margin="0,10,0,2" IsChecked="{Binding CodeWordWrap}"
                                  Content="{l:Tr 'Word wrap'}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="28,0,0,0"
                                   Text="{l:Tr 'Long lines continue on the next line instead of scrolling horizontally.'}" />

                        <TextBlock Style="{StaticResource SettingsSection}" Text="{l:Tr 'Graph editor'}" />
                        <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding GraphShowGrid}"
                                  Content="{l:Tr 'Show the grid'}" />
                        <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding GraphSnapToGrid}"
                                  Content="{l:Tr 'Snap nodes to the grid'}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="28,0,0,0"
                                   Text="{l:Tr 'A moved node lands on the nearest grid point when you release it.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Programmes externes -->
            <TabItem Header="{l:Tr 'Programs'}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelTitle}" Text="{l:Tr 'Open with'}" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldHint}" Margin="0,0,0,8"
                               Text="{l:Tr 'These programs are offered by &quot;Open with&quot; (right-click in the Explorer or the Dashboard) for files whose extension is listed. *: all files.'}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldHint}" Margin="0,4,0,0" Text="{Binding ProgramMessage}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource SettingsButton}" Content="{l:Tr 'Add...'}" Command="{Binding AddProgramCommand}" />
                        <Button Style="{StaticResource SettingsButton}" Content="{l:Tr 'Detect installed programs'}" Command="{Binding DetectProgramsCommand}" />
                    </StackPanel>
                    <Grid>
                        <TextBlock Margin="8" Style="{StaticResource FieldHint}" Visibility="{Binding Programs.Count, Converter={StaticResource ZeroToVisible}}"
                                   Text="{l:Tr 'No program. Add your image, sound or code editor, or let Mine Engine look for the installed ones.'}" />
                        <ListBox ItemsSource="{Binding Programs}" Style="{StaticResource ChoiceList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ExternalProgramRowViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="0" Padding="6,3" Margin="0,0,6,0"
                                                 ToolTip="{l:Tr 'Name shown in the menu'}" />
                                        <TextBox Grid.Column="1" Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" MinHeight="0" Padding="6,3" Margin="0,0,8,0"
                                                 FontFamily="Cascadia Mono, Consolas" ToolTip="{l:Tr 'Extensions separated by semicolons (png;jpg) or * for all files'}" />
                                        <TextBlock x:Name="ProgramPath" Grid.Column="2" Text="{Binding Path}" VerticalAlignment="Center" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="{DynamicResource HintBrush}" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Margin="6,0,0,0"
                                                ToolTip="{l:Tr 'Remove this program'}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.RemoveProgramCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Exists}" Value="False">
                                            <Setter TargetName="ProgramPath" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Raccourcis -->
            <TabItem Header="{l:Tr 'Shortcuts'}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0"
                                   Text="{l:Tr 'Click in a command\'s box, then press the shortcut you want. Backspace or Delete alone remove the shortcut, Esc cancels. Fixed shortcuts:'}" />
                        <ItemsControl ItemsSource="{Binding FixedShortcuts}" Focusable="False" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource FieldHint}" Margin="0,0,14,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ListBox x:Name="ShortcutList" ItemsSource="{Binding Source={StaticResource ShortcutGroups}}" Style="{StaticResource ChoiceList}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource PanelCaption}" Margin="6,10,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ShortcutRowViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource StrongTextBrush}" />
                                        <TextBlock Text="{Binding Conflict}" FontSize="11" Foreground="{DynamicResource LogWarningBrush}"
                                                   Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" MinHeight="0" Padding="6,3"
                                             Text="{Binding DisplayGesture, Mode=OneWay}" PreviewKeyDown="OnShortcutKeyDown"
                                             ToolTip="{l:Tr 'Press the shortcut you want'}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Command="{Binding ClearCommand}"
                                                ToolTip="{l:Tr 'Remove the shortcut'}" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Undo}" Command="{Binding ResetCommand}"
                                                ToolTip="{l:Tr 'Default shortcut'}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Débogage (V0.6.4) -->
            <TabItem Header="{l:Tr 'Debug'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Debug mode'}" />
                        <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding DebugMode}" Content="{l:Tr 'Turn on the debug mode of Mine Engine'}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="28,0,0,0" TextWrapping="Wrap"
                                   Text="{l:Tr 'Shows the detailed messages in the Output and the log file (duration of each step of the validation, the generation and the build), asks Gradle for the full stack of its errors, adds a Debug menu and shows the memory used in the status bar.'}" />

                        <TextBlock Style="{StaticResource SettingsSection}" Text="{l:Tr 'Crash reports'}" />
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'Whatever the debug mode, every unexpected error of Mine Engine writes a report (version, system, open project, last messages and the error) in %LOCALAPPDATA%\\MineEngine\\crashes. A session that did not close normally is reported at the next start. Mine Engine > Crash reports opens the folder: join a report to a bug report on GitHub.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
