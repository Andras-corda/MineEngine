<UserControl x:Class="MineEngine.Editor.Views.Panels.ProjectExplorerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MineEngine.Editor.Views"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:panels="clr-namespace:MineEngine.Editor.ViewModels.Panels"
             xmlns:docs="clr-namespace:MineEngine.Editor.ViewModels.Documents"
             xmlns:java="clr-namespace:MineEngine.Minecraft.Java;assembly=MineEngine.Minecraft">

    <!--
        Explorateur façon VS Code : arborescence du projet, recherche de fichiers,
        structure du fichier ouvert et rappel de la cible du projet.
        DataContext : MainViewModel.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Menu contextuel d'un nœud ; Tag du nœud = MainViewModel. -->
            <ContextMenu x:Key="NodeMenu" x:Shared="False"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{l:Tr 'Ouvrir'}" CommandParameter="{Binding}"
                          Command="{Binding PlacementTarget.Tag.Explorer.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <!-- Rempli à l'ouverture du menu (voir OpenWithMenu). -->
                <MenuItem Header="{l:Tr 'Ouvrir avec'}" Tag="openWith" />
                <Separator />
                <MenuItem Header="{l:Tr 'Nouvelle classe Java'}">
                    <MenuItem Header="{l:Tr 'Écouteur d\'événements du jeu...'}" CommandParameter="{x:Static java:JavaClassKind.EventListener}"
                              Command="{Binding PlacementTarget.Tag.Explorer.NewJavaClassCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{l:Tr 'Classe utilitaire...'}" CommandParameter="{x:Static java:JavaClassKind.Utility}"
                              Command="{Binding PlacementTarget.Tag.Explorer.NewJavaClassCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{l:Tr 'Classe vide...'}" CommandParameter="{x:Static java:JavaClassKind.Empty}"
                              Command="{Binding PlacementTarget.Tag.Explorer.NewJavaClassCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </MenuItem>
                <MenuItem Header="{l:Tr 'Nouveau fichier...'}"
                          Command="{Binding PlacementTarget.Tag.Explorer.NewFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="{l:Tr 'Nouveau dossier...'}"
                          Command="{Binding PlacementTarget.Tag.Explorer.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="{l:Tr 'Renommer...'}" CommandParameter="{Binding}"
                          Command="{Binding PlacementTarget.Tag.Explorer.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="{l:Tr 'Mettre à la corbeille'}" CommandParameter="{Binding}"
                          Command="{Binding PlacementTarget.Tag.Explorer.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="{l:Tr 'Copier le chemin'}" CommandParameter="{Binding}"
                          Command="{Binding PlacementTarget.Tag.Explorer.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="{l:Tr 'Afficher dans l\'Explorateur Windows'}" CommandParameter="{Binding}"
                          Command="{Binding PlacementTarget.Tag.Explorer.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>

            <DataTemplate x:Key="NodeContent" DataType="{x:Type panels:FileNodeViewModel}">
                <DockPanel Background="Transparent">
                    <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="8,0,4,0" Fill="{DynamicResource AccentLineBrush}"
                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Tr 'Modifications non enregistrées'}" />
                    <views:IconView DockPanel.Dock="Left" Icon="{Binding Icon}" IconSize="12"
                               Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SidebarBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête et actions -->
        <DockPanel Grid.Row="0" Margin="12,8,6,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Code}" ToolTip="{l:Tr 'Nouvelle classe Java (écouteur d\'événements)'}"
                        Command="{Binding Explorer.NewJavaClassCommand}" CommandParameter="{x:Static java:JavaClassKind.EventListener}" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.File}" ToolTip="{l:Tr 'Nouveau fichier'}" Command="{Binding Explorer.NewFileCommand}" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.NewFolder}" ToolTip="{l:Tr 'Nouveau dossier'}" Command="{Binding Explorer.NewFolderCommand}" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Refresh}" ToolTip="{l:Tr 'Actualiser'}" Command="{Binding Explorer.RefreshCommand}" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.ChevronUp}" ToolTip="{l:Tr 'Tout réduire'}" Command="{Binding Explorer.CollapseAllCommand}" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.FolderOpen}" ToolTip="{l:Tr 'Ouvrir le dossier du projet dans Windows'}"
                        Command="{Binding Explorer.RevealProjectCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'EXPLORATEUR'}" />
        </DockPanel>

        <!-- Recherche -->
        <Grid Grid.Row="1" Margin="10,2,10,6">
            <TextBox x:Name="SearchBox" Padding="26,4,6,4" Text="{Binding Explorer.SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Search}" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Foreground="{DynamicResource HintBrush}" />
            <TextBlock Text="{l:Tr 'Rechercher un fichier...'}" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource HintBrush}"
                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
        </Grid>

        <!-- Arborescence, ou résultats de recherche -->
        <Grid Grid.Row="2">
            <TextBlock Text="{l:Tr 'Aucun projet ouvert.'}" Margin="14,6" Foreground="{DynamicResource HintBrush}"
                       Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}" />
            <TreeView x:Name="Tree" ItemsSource="{Binding Explorer.Roots}" Background="Transparent" BorderThickness="0"
                      Visibility="{Binding Explorer.IsSearching, Converter={StaticResource InverseBoolToVisibility}}"
                      SelectedItemChanged="OnSelectedItemChanged" KeyDown="OnTreeKeyDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}" />
                        <Setter Property="ToolTip" Value="{Binding FullPath}" />
                        <EventSetter Event="MouseDoubleClick" Handler="OnNodeDoubleClick" />
                        <EventSetter Event="ContextMenuOpening" Handler="OnNodeMenuOpening" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type panels:FileNodeViewModel}" ItemsSource="{Binding Children}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NodeContent}" Focusable="False" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <ListBox ItemsSource="{Binding Explorer.SearchResults}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding Explorer.IsSearching, Converter={StaticResource BoolToVisibility}}"
                     ItemTemplate="{StaticResource NodeContent}" SelectionChanged="OnSearchResultSelected">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="12,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0,1,0,0"
                      BorderBrush="{DynamicResource CardBorderBrush}" ResizeDirection="Rows" />

        <!-- Structure du fichier ouvert -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelCaption}" Margin="12,4,12,6" TextTrimming="CharacterEllipsis">
                <Run Text="{l:Tr 'STRUCTURE'}" /><Run Text="{Binding ActiveDocument.FileName, Mode=OneWay, StringFormat=' · {0}'}" />
            </TextBlock>
            <Grid>
                <TextBlock Margin="14,0,14,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource HintBrush}"
                           Text="{l:Tr 'Ouvrez un fichier de code (double-clic dans l\'arborescence) pour voir sa structure.'}"
                           Visibility="{Binding HasActiveDocument, Converter={StaticResource InverseBoolToVisibility}}" />
                <ListBox ItemsSource="{Binding ActiveDocument.Outline}" Background="Transparent" BorderThickness="0"
                         Visibility="{Binding HasActiveDocument, Converter={StaticResource BoolToVisibility}}"
                         SelectionChanged="OnOutlineSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,3" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type docs:OutlineItem}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LineLabel}" FontSize="11" Foreground="{DynamicResource HintBrush}" Margin="8,0,0,0" />
                                <views:IconView DockPanel.Dock="Left" Icon="{Binding Icon}" IconSize="12"
                                           Foreground="{DynamicResource AccentLineBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- Projet : cible et MDK -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="10,6,10,10" Padding="10,8"
                Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" FontSize="11" Margin="0,2,7,0" Foreground="{DynamicResource HintBrush}" />
                    <TextBlock Text="{Binding ProjectStatus}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding Project.TargetDescription}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                           Foreground="{DynamicResource HintBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
