<UserControl x:Class="MineEngine.Editor.Views.Panels.TagsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:vm="clr-namespace:MineEngine.Editor.ViewModels"
             x:Name="Root">

    <!--
        Tags tab (V0.7.1, like the Elements Tag of MCreator), shown as a table like the Global tab:
        each row is a tag, with the kind of what it groups, its namespace, its name, its entries and
        "replace". DataContext: MainViewModel.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToolText" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="28" />
            </Style>

            <Style x:Key="RowItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Reference}" />
            </Style>

            <Style x:Key="Cell" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="IsEnabled" Value="{Binding DataContext.Tags.CanEdit, ElementName=Root}" />
            </Style>

            <Style x:Key="CellText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="IsEnabled" Value="{Binding DataContext.Tags.CanEdit, ElementName=Root}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource HubBackgroundBrush}">
        <DockPanel Margin="16,12,16,8" DataContext="{Binding Tags}"
                   Visibility="{Binding DataContext.HasProject, ElementName=Root, Converter={StaticResource BoolToVisibility}}">

            <!-- Actions -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolText}" Command="{Binding AddCommand}"
                        AutomationProperties.AutomationId="AddTag" AutomationProperties.Name="{l:Tr 'New tag'}"
                        ToolTip="{l:Tr 'Adds a tag: a name for a group of blocks, items, entities, biomes...'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.NewItem}" Margin="0,0,6,0" />
                        <TextBlock Text="{l:Tr 'New tag'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'TAGS'}" />
                    <TextBlock Style="{StaticResource FieldHint}" Text="{Binding Summary}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldHint}" Margin="2,8,0,0" TextWrapping="Wrap"
                       Text="{l:Tr 'Namespace: your id for the tags of the mod; minecraft to add entries to a tag of the game (logs, mineable/pickaxe...); c for the common tags shared by the mods (c:ores, c:ingots/ruby). Entries, separated by commas: an element (minecraft:oak_log, or ruby for the mod), a tag (#minecraft:logs), or an optional entry of another mod ending with ? (othermod:ruby?).'}" />

            <!-- Headers -->
            <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" MinWidth="170" />
                    <ColumnDefinition Width="1.1*" MinWidth="125" />
                    <ColumnDefinition Width="1.4*" MinWidth="110" />
                    <ColumnDefinition Width="2.6*" MinWidth="160" />
                    <ColumnDefinition Width="1.2*" MinWidth="130" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'KIND'}" />
                <TextBlock Grid.Column="1" Style="{StaticResource PanelCaption}" Text="{l:Tr 'NAMESPACE'}" />
                <TextBlock Grid.Column="2" Style="{StaticResource PanelCaption}" Text="{l:Tr 'NAME'}" />
                <TextBlock Grid.Column="3" Style="{StaticResource PanelCaption}" Text="{l:Tr 'ENTRIES'}" />
                <TextBlock Grid.Column="4" Style="{StaticResource PanelCaption}" Text="{l:Tr 'ADD AN ELEMENT'}" />
                <TextBlock Grid.Column="5" Style="{StaticResource PanelCaption}" Text="{l:Tr 'REPLACE'}"
                           ToolTip="{l:Tr 'Replace the entries of the other mods and of Minecraft'}" />
            </Grid>

            <Grid>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           Foreground="{DynamicResource HintBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                           Text="{l:Tr 'No tag yet. A tag groups elements under one name (#mymod:ores), used by recipes, graphs and other tags; a tag of Minecraft (#minecraft:logs) receives the entries of the mod.'}" />

                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Continue" AutomationProperties.AutomationId="TagRows">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TagRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" MinWidth="170" />
                                    <ColumnDefinition Width="1.1*" MinWidth="125" />
                                    <ColumnDefinition Width="1.4*" MinWidth="110" />
                                    <ColumnDefinition Width="2.6*" MinWidth="160" />
                                    <ColumnDefinition Width="1.2*" MinWidth="130" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource Cell}" AutomationProperties.Name="{l:Tr 'Kind'}"
                                          ItemsSource="{Binding Source={x:Static vm:TagsViewModel.Registries}}" SelectedItem="{Binding Registry}"
                                          ToolTip="{Binding Registry.Label}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Grid.Column="1" Style="{StaticResource Cell}" IsEditable="True" FontFamily="Consolas"
                                          ItemsSource="{Binding DataContext.Tags.Namespaces, ElementName=Root}"
                                          Text="{Binding Namespace, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Tr 'Namespace'}" />
                                <TextBox Grid.Column="2" Style="{StaticResource CellText}" Text="{Binding TagPath}"
                                         AutomationProperties.Name="{l:Tr 'Name'}" ToolTip="{Binding Reference}" />
                                <TextBox Grid.Column="3" Style="{StaticResource CellText}" Text="{Binding EntriesLine}"
                                         AutomationProperties.Name="{l:Tr 'Entries'}" ToolTip="{Binding Values}" />
                                <DockPanel Grid.Column="4" Margin="0,0,8,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.NewItem}"
                                            Command="{Binding AddSuggestionCommand}" Margin="4,0,0,0"
                                            AutomationProperties.Name="{l:Tr 'Add'}" ToolTip="{l:Tr 'Add the element to the entries'}" />
                                    <ComboBox Style="{StaticResource Cell}" Margin="0" FontFamily="Consolas"
                                              ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Suggestion}"
                                              AutomationProperties.Name="{l:Tr 'Element to add'}" />
                                </DockPanel>
                                <CheckBox Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" IsChecked="{Binding Replace}"
                                          IsEnabled="{Binding DataContext.Tags.CanEdit, ElementName=Root}"
                                          AutomationProperties.Name="{l:Tr 'Replace'}" ToolTip="{l:Tr 'Replace the entries of the other mods and of Minecraft'}" />
                                <Button Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}"
                                        Command="{Binding RemoveCommand}"
                                        AutomationProperties.Name="{l:Tr 'Delete the tag'}" ToolTip="{l:Tr 'Delete the tag'}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
