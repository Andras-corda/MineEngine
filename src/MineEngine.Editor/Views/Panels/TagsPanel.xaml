<UserControl x:Class="MineEngine.Editor.Views.Panels.TagsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:vm="clr-namespace:MineEngine.Editor.ViewModels"
             x:Name="Root">

    <!--
        Tags tab (V0.7.1, like the Elements Tag of MCreator): the tags of the mod on the left, the
        selected tag on the right (kind, namespace, name, entries). DataContext: MainViewModel.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Rows of the editor, like the Properties of the elements. -->
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="150" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Row" TargetType="WrapPanel">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
            <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="WrapCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource HubBackgroundBrush}">
        <DockPanel Margin="16,12,16,8" DataContext="{Binding Tags}"
                   Visibility="{Binding DataContext.HasProject, ElementName=Root, Converter={StaticResource BoolToVisibility}}">

            <!-- Tags of the mod -->
            <DockPanel DockPanel.Dock="Left" Width="300" Margin="0,0,16,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Padding="10,4" Command="{Binding AddCommand}" AutomationProperties.Name="{l:Tr 'New tag'}"
                            ToolTip="{l:Tr 'Adds a tag: a name for a group of blocks, items, entities, biomes...'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.NewItem}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:Tr 'New tag'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'TAGS'}" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding Summary}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <Grid>
                    <TextBlock Foreground="{DynamicResource HintBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="2,8"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                               Text="{l:Tr 'No tag yet. A tag groups elements under one name (#mymod:ores), used by recipes, graphs and other tags; a tag of Minecraft (#minecraft:logs) receives the entries of the mod.'}" />
                    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="0"
                             AutomationProperties.AutomationId="TagRows">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Reference}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TagRowViewModel}">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Reference}" FontFamily="Consolas" Foreground="{DynamicResource StrongTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource HintBrush}">
                                        <Run Text="{Binding RegistryLabel, Mode=OneWay}" /> · <Run Text="{Binding Summary, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>

            <!-- Selected tag -->
            <Grid>
                <TextBlock Foreground="{DynamicResource HintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="{l:Tr 'Select a tag, or create one.'}" />
                <DockPanel DataContext="{Binding SelectedRow}" Visibility="{Binding DataContext.Tags.HasSelection, ElementName=Root, Converter={StaticResource BoolToVisibility}}"
                           IsEnabled="{Binding DataContext.Tags.CanEdit, ElementName=Root}">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Command="{Binding RemoveCommand}"
                                    AutomationProperties.Name="{l:Tr 'Delete the tag'}" ToolTip="{l:Tr 'Delete the tag'}" />
                            <TextBlock Text="{Binding Reference}" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Kind'}" />
                            <ComboBox Width="320" ItemsSource="{Binding Source={x:Static vm:TagsViewModel.Registries}}" SelectedItem="{Binding Registry}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="{l:Tr 'Kind'}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Namespace'}" />
                            <ComboBox Width="200" IsEditable="True" FontFamily="Consolas" ItemsSource="{Binding DataContext.Tags.Namespaces, ElementName=Root}"
                                      Text="{Binding Namespace, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Tr 'Namespace'}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Name'}" />
                            <TextBox Width="320" FontFamily="Consolas" Text="{Binding TagPath}" AutomationProperties.Name="{l:Tr 'Name'}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'Your id for the tags of the mod; minecraft to add entries to a tag of the game (logs, mineable/pickaxe...); c for the common tags shared by the mods (c:ores, c:ingots/ruby).'}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Replace the entries of the other mods and of Minecraft'}" IsChecked="{Binding Replace}" />
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Entries'}" Margin="0,12,0,4" />
                        <WrapPanel Margin="0,0,0,6">
                            <ComboBox Width="320" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Suggestion}" FontFamily="Consolas"
                                      AutomationProperties.Name="{l:Tr 'Element to add'}" />
                            <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Add'}" Command="{Binding AddSuggestionCommand}" Margin="6,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="{l:Tr 'One entry per line: an element (minecraft:oak_log, or ruby for the mod), a tag (#minecraft:logs), or an optional entry of another mod ending with ? (othermod:ruby?).'}" />
                    <TextBox Text="{Binding Values}" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MinHeight="160" AutomationProperties.Name="{l:Tr 'Entries'}" />
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
