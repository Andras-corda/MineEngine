<UserControl x:Class="MineEngine.Editor.Views.Panels.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:docs="clr-namespace:MineEngine.Editor.ViewModels.Documents"
             xmlns:graphs="clr-namespace:MineEngine.Editor.ViewModels.Graphs"
             xmlns:graphviews="clr-namespace:MineEngine.Editor.Views.Graphs"
             xmlns:bt="clr-namespace:MineEngine.Editor.ViewModels.Puppeteer"
             xmlns:puppeteer="clr-namespace:MineEngine.Editor.Views.Puppeteer"
             xmlns:assets="clr-namespace:MineEngine.Editor.ViewModels.Assets"
             xmlns:sparkle="clr-namespace:MineEngine.Editor.ViewModels.Sparkle"
             xmlns:views="clr-namespace:MineEngine.Editor.Views.Panels">

    <!--
        Panneau Détails / Inspecteur, façon Unreal et Unity : la cible (asset sélectionné ou
        onglet de code actif) puis ses propriétés par sections. DataContext : MainViewModel.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
                <ResourceDictionary Source="../InspectorTemplates.xaml" />
                <ResourceDictionary Source="../Sparkle/SparkleTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <graphviews:NodeCategoryBrushConverter x:Key="CategoryBrush" />

            <!-- Name and identifier of an element, edited here whatever its editor (undone with Ctrl+Z). -->
            <DataTemplate x:Key="IdentityFields" DataType="{x:Type assets:AssetViewModel}">
                <Border Style="{StaticResource DetailsSection}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'ELEMENT'}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'In-game name'}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr 'In-game name'}" />
                        <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Identifier'}" Margin="0,8,0,3" />
                        <TextBox Text="{Binding ResourceIdText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                 AutomationProperties.Name="{l:Tr 'Identifier'}" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ResourceIdRule}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding HasGameId, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding FullResourceId}" FontFamily="Consolas" />
                            <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'In-game identifier'}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Element selected in the Dashboard: its name and identifier, then information (it is edited in its tab, opened with Edit). -->
            <DataTemplate x:Key="AssetSummaryTemplate" DataType="{x:Type assets:AssetViewModel}">
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource IdentityFields}" Focusable="False" />
                    <Border Style="{StaticResource DetailsSection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'INFORMATION'}" Margin="0,0,0,6" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding TypeLabel}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Type'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding FolderLabel}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Folder'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding IssueLabel}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'State'}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding SummaryLines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type assets:SummaryLine}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding Value}" TextWrapping="Wrap"
                                                       MaxWidth="220" TextAlignment="Right" />
                                            <TextBlock Style="{StaticResource DetailsLabel}" Text="{Binding Label}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DetailsSection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'USED BY'}" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="{l:Tr 'Nothing uses this element.'}"
                                       Visibility="{Binding IsUsed, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding UsedBy}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type assets:AssetLinkViewModel}">
                                        <Button Style="{StaticResource FlatButton}" Padding="2,2" HorizontalContentAlignment="Left" Content="{Binding Label}"
                                                Command="{Binding DataContext.OpenAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding TargetId}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'USES'}" Margin="0,10,0,6"
                                       Visibility="{Binding HasUses, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Uses}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type assets:AssetLinkViewModel}">
                                        <Button Style="{StaticResource FlatButton}" Padding="2,2" HorizontalContentAlignment="Left" Content="{Binding Label}"
                                                Command="{Binding DataContext.OpenAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding TargetId}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Button Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left" Padding="14,5" Margin="0,0,0,10" AutomationProperties.Name="{l:Tr 'Edit the element'}"
                            Command="{Binding DataContext.OpenAssetEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Rename}" />
                            <TextBlock Text="{l:Tr 'Edit the element'}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Text="{l:Tr 'The element is edited in its own tab (double-click in the Dashboard, or Edit the element).'}" />
                </StackPanel>
            </DataTemplate>

            <views:DetailsTemplateSelector x:Key="DetailsTemplates" AssetTemplate="{StaticResource AssetSummaryTemplate}" />


            <!-- Ligne libellé / valeur d'une section. -->
            <Style x:Key="DetailsRow" TargetType="DockPanel">
                <Setter Property="LastChildFill" Value="True" />
            </Style>

            <!-- Onglet de code : propriétés du fichier, structure, actions. -->
            <DataTemplate DataType="{x:Type docs:CodeDocumentViewModel}">
                <StackPanel>
                    <Border Style="{StaticResource DetailsSection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'PROPERTIES'}" Margin="0,0,0,6" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding Language}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Type'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding EncodingLabel}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Encoding'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding IndentationLabel}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Indentation'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding LineCount}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Lines'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding CaretLabel}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Cursor'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock x:Name="State" DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{l:Tr 'Saved'}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'State'}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DetailsSection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'STRUCTURE'}" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource FieldHint}" Text="{l:Tr 'No recognized symbol in this file.'}"
                                       Visibility="{Binding Outline.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Outline}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type docs:OutlineItem}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding LineLabel, StringFormat={l:Tr 'line {0}'}}"
                                                       Foreground="{DynamicResource LinkBrush}" />
                                            <TextBlock Style="{StaticResource DetailsLabel}" FontFamily="Cascadia Mono, Consolas" Text="{Binding Name}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10"
                            Visibility="{Binding Banner, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" Margin="0,2,8,0"
                                       Foreground="{DynamicResource AccentLineBrush}" />
                            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" FontSize="12" />
                        </DockPanel>
                    </Border>

                    <WrapPanel>
                        <Button Style="{DynamicResource AccentButtonStyle}" Content="{l:Tr 'Save'}" Padding="12,5" Margin="0,0,6,6"
                                Command="{Binding DataContext.SaveDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="{l:Tr 'Reload'}" Padding="12,5" Margin="0,0,6,6"
                                Command="{Binding DataContext.ReloadDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Content="{l:Tr 'Show in Windows'}" Padding="12,5" Margin="0,0,6,6"
                                Command="{Binding DataContext.RevealDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </WrapPanel>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                        <Setter TargetName="State" Property="Text" Value="{l:Tr 'Modified'}" />
                        <Setter TargetName="State" Property="Foreground" Value="{DynamicResource LogWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                        <Setter TargetName="State" Property="Text" Value="{l:Tr 'Read-only'}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <!-- Onglet de graphe : résumé, définition, nœud sélectionné, problèmes (un clic montre le nœud). -->
            <DataTemplate DataType="{x:Type graphs:GraphDocumentViewModel}">
                <StackPanel>
                    <ContentControl Content="{Binding DataContext.DetailsAsset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ContentTemplate="{StaticResource IdentityFields}" Focusable="False" />
                    <Border Style="{StaticResource DetailsSection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{Binding DetailsBadge}" Margin="0,0,0,6" />
                            <DockPanel Visibility="{Binding IsEventGraph, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding EventCount}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Events'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding NodeCount}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Nodes'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding Connections.Count}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Wires'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding IssueSummary}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'State'}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Définition (nom, variables, paramètres...) : comme le panneau « My Blueprint » d'Unreal.
                         Une structure, une interface ou une énumération n'a pas de nœuds : sa définition reste dans l'onglet. -->
                    <Border Margin="-10,0,-10,10" Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}">
                        <graphviews:DefinitionPanel DataContext="{Binding Definition}" />
                    </Border>

                    <Border Style="{StaticResource DetailsSection}" Visibility="{Binding SelectedNode, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel DataContext="{Binding SelectedNode}">
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,0,8,0"
                                        Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'SELECTED NODE'}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource HintBrush}" />
                            <TextBlock Text="{Binding IssueText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource LogWarningBrush}"
                                       Visibility="{Binding IssueText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}" />

                            <!-- Switch: its cases. -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsSwitch, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Cases (one per line)'}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding SwitchCases, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="70" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource HintBrush}"
                                           Text="{l:Tr 'Each case is an output of the node; a value that matches no case runs Default. Wires follow the position of the case.'}" />
                            </StackPanel>

                            <!-- Comment: title, color, tooltip. Tooltip: its message. -->
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsComment, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Title'}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AnnotationText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Color'}" Margin="0,10,0,4" />
                                <ListBox ItemsSource="{Binding CommentColors}" SelectedItem="{Binding CommentColor}" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="22" Height="22" CornerRadius="4" Background="{Binding}" ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Tooltip of the comment'}" Margin="0,10,0,4" />
                                <TextBox Text="{Binding CommentTooltip, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource HintBrush}"
                                           Text="{l:Tr 'Shown when the mouse is over the title of the comment. Moving the comment moves the nodes inside it.'}" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsTooltip, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Message'}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AnnotationText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource HintBrush}"
                                           Text="{l:Tr 'Shown only when the mouse is over the bubble or over the nodes it describes (they show a small i).'}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DetailsSection}" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'PROBLEMS'}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type graphs:GraphIssueItem}">
                                        <Button Style="{StaticResource FlatButton}" Padding="2,3" HorizontalContentAlignment="Stretch"
                                                Click="OnGraphIssueClick" ToolTip="{l:Tr 'Show the node'}">
                                            <DockPanel>
                                                <TextBlock x:Name="Icon" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Warning}"
                                                           Margin="0,2,8,0" Foreground="{DynamicResource LogWarningBrush}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource StrongTextBrush}" />
                                            </DockPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="Icon" Property="Text" Value="{StaticResource Glyph.Error}" />
                                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="{l:Tr 'Graph changes are saved with the project (Ctrl+S) and undone with Ctrl+Z. They are translated to Java at build time.'}" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- Sparkle tab: name and identifier, the system, then the selected emitter (its whole stack) or module (its settings). -->
            <DataTemplate DataType="{x:Type sparkle:SparkleDocumentViewModel}">
                <StackPanel>
                    <ContentControl Content="{Binding DataContext.DetailsAsset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ContentTemplate="{StaticResource IdentityFields}" Focusable="False" />
                    <Border Style="{StaticResource DetailsSection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'PARTICLE SYSTEM'}" Margin="0,0,0,6" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding Emitters.Count}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Emitters'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding IssueSummary}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'State'}" />
                            </DockPanel>
                            <TextBlock Text="{Binding PerformanceSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource HintBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="{l:Tr 'Click an emitter or one of its modules on the canvas to edit it here. Right-click on the canvas to add an emitter.'}"
                               Visibility="{Binding HasNothingSelected, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Selected comment (title, color, tooltip) or tooltip (message). -->
                    <Border Style="{StaticResource DetailsSection}" Visibility="{Binding HasSelectedNote, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedNote}">
                            <StackPanel Visibility="{Binding IsComment, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'COMMENT'}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Title'}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr 'Title of the comment'}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Color'}" Margin="0,10,0,4" />
                                <ListBox ItemsSource="{Binding CommentColors}" SelectedItem="{Binding Color}" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="22" Height="22" CornerRadius="4" Background="{Binding}" ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Tooltip of the comment'}" Margin="0,10,0,4" />
                                <TextBox Text="{Binding Tooltip, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource HintBrush}"
                                           Text="{l:Tr 'Shown when the mouse is over the title of the comment. Moving the comment moves the emitters inside it.'}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsTooltip, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'TOOLTIP'}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Message'}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                         AutomationProperties.Name="{l:Tr 'Message of the tooltip'}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource StrongTextBrush}"
                                           Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{l:Tr 'Describes:'}" />
                                    <Run Text="{Binding TargetNames, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource HintBrush}"
                                           Text="{l:Tr 'Shown only when the mouse is over the bubble or over the emitters it describes (they show a small i).'}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Selected emitter: its head, then its whole stack, or only the selected module. -->
                    <Border Style="{StaticResource DetailsSection}" Visibility="{Binding HasSelectedEmitter, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedEmitter}">
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,0,8,0" Background="#FF8A5CD6" />
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'EMITTER'}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Name'}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr 'Name of the emitter'}" />
                            <CheckBox Content="{l:Tr 'Shown in the preview'}" IsChecked="{Binding Preview}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Role}" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource HintBrush}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{l:Tr 'Duplicate'}" Padding="10,3" Margin="0,0,6,0" Command="{Binding DuplicateCommand}" />
                                <Button Content="{l:Tr 'Delete'}" Padding="10,3" Command="{Binding DeleteCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding SelectedModule}" ContentTemplate="{StaticResource SparkleModuleSettingsTemplate}" Focusable="False"
                                    Visibility="{Binding HasSelectedModule, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6" />
                    <StackPanel Visibility="{Binding HasSelectedModule, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding SelectedEmitter.Sections}" ItemTemplate="{StaticResource SparkleSectionSettingsTemplate}"
                                      Focusable="False" Margin="0,0,0,6" />
                    </StackPanel>
                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Content="{l:Tr 'Show all the modules of the emitter'}"
                            Command="{Binding SelectedEmitter.SelectCommand}"
                            Visibility="{Binding HasSelectedModule, Converter={StaticResource BoolToVisibility}}" />

                    <Border Style="{StaticResource DetailsSection}" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource LogWarningBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="{l:Tr 'The graphs play the system with the nodes &quot;Play a particle system&quot; (at a position or on an entity), with its identifier.'}" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- Puppeteer tab: summary, selected node, blackboard and problems. -->
            <DataTemplate DataType="{x:Type bt:BehaviorTreeDocumentViewModel}">
                <StackPanel>
                    <ContentControl Content="{Binding DataContext.DetailsAsset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ContentTemplate="{StaticResource IdentityFields}" Focusable="False" />
                    <Border Style="{StaticResource DetailsSection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'BEHAVIOR TREE'}" Margin="0,0,0,6" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding TaskCount}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Tasks'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding Keys.Count}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Blackboard keys'}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource DetailsValue}" Text="{Binding IssueSummary}" />
                                <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'State'}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource DetailsLabel}" Text="{l:Tr 'Mobs that follow it'}" Margin="0,6,0,2" />
                            <TextBlock Text="{Binding UsedByText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource StrongTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Selected node and blackboard, like Unreal's Details and Blackboard panels. -->
                    <Border Margin="-10,0,-10,0" Padding="10,0">
                        <puppeteer:BehaviorTreeDetailsPanel />
                    </Border>

                    <Border Style="{StaticResource DetailsSection}" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'PROBLEMS'}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type graphs:GraphIssueItem}">
                                        <Button Style="{StaticResource FlatButton}" Padding="2,3" HorizontalContentAlignment="Stretch"
                                                Click="OnTreeIssueClick" ToolTip="{l:Tr 'Show the element'}">
                                            <DockPanel>
                                                <TextBlock x:Name="Icon" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Warning}"
                                                           Margin="0,2,8,0" Foreground="{DynamicResource LogWarningBrush}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource StrongTextBrush}" />
                                            </DockPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="Icon" Property="Text" Value="{StaticResource Glyph.Error}" />
                                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="{l:Tr 'Changes to the tree are saved with the project (Ctrl+S) and undone with Ctrl+Z. Each mob that follows it gets its own copy when the mod is built.'}" />
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- Editing tab of an element: its name and identifier are edited here (the tab only shows its settings). -->
            <DataTemplate DataType="{x:Type docs:AssetEditorDocumentViewModel}">
                <ContentControl Content="{Binding Asset}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SidebarBrush}">
        <TextBlock Margin="14" TextWrapping="Wrap" Foreground="{DynamicResource HintBrush}"
                   Text="{l:Tr 'Select an element in the Dashboard, or open a file from the Explorer, to see its details.'}"
                   Visibility="{Binding HasDetails, Converter={StaticResource InverseBoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="10">
                <!-- Cible -->
                <Border Style="{StaticResource DetailsSection}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Details.DetailsBadge}" />
                            </Border>
                            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'TARGET'}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Details.DetailsTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource StrongTextBrush}" />
                        <TextBlock Style="{StaticResource MonoHint}" Text="{Binding Details.DetailsSubtitle}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding Details}" IsEnabled="{Binding CanEdit}" Focusable="False"
                                ContentTemplateSelector="{StaticResource DetailsTemplates}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
