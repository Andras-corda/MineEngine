<UserControl x:Class="MineEngine.Editor.Views.Panels.NodeLibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:graphs="clr-namespace:MineEngine.Editor.ViewModels.Graphs"
             xmlns:graphViews="clr-namespace:MineEngine.Editor.Views.Graphs">

    <!--
        Nodes window (V0.6.2), in the spirit of the MCreator palette: domains on the left,
        search on top, colored blocks to drag onto the graph or to double-click.
        DataContext: NodeLibraryViewModel.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <graphViews:NodeGroupBrushConverter x:Key="GroupBrush" />

            <Style x:Key="GroupItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,0,0,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="GroupTemplate" DataType="{x:Type graphs:NodeGroupItem}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2" Margin="0,0,7,0" VerticalAlignment="Center"
                            Background="{Binding Key, Converter={StaticResource GroupBrush}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource HintBrush}" />
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </DataTemplate>

            <!-- A node: a colored block, as in MCreator. -->
            <DataTemplate x:Key="NodeTemplate" DataType="{x:Type graphs:NodeLibraryItem}">
                <Border CornerRadius="5" Padding="9,6" Margin="0,0,0,5" Cursor="Hand" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Title}"
                        Background="{Binding GroupKey, Converter={StaticResource GroupBrush}}"
                        PreviewMouseLeftButtonDown="OnNodeMouseDown" MouseMove="OnNodeMouseMove">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'NODES'}" Margin="10,8,10,4" />

        <!-- Search -->
        <Grid Grid.Row="1" Margin="10,2,10,6" IsEnabled="{Binding HasDocument}">
            <TextBox x:Name="SearchBox" Padding="26,4,6,4" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Search}" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Foreground="{DynamicResource HintBrush}" />
            <TextBlock Text="{l:Tr 'Search nodes...'}" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource HintBrush}"
                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
        </Grid>

        <!-- Domains and nodes: domains on the left when the panel is wide, above the nodes when it is narrow (see OnBodySizeChanged). -->
        <Grid x:Name="Body" Grid.Row="2" Margin="6,0,6,0" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}"
              SizeChanged="OnBodySizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ListBox x:Name="GroupList" Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ItemTemplate="{StaticResource GroupTemplate}"
                     ItemContainerStyle="{StaticResource GroupItem}" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:Tr 'Node domains'}" />

            <ScrollViewer x:Name="NodeScroller" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="NodeList" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NodeTemplate}" Margin="0,0,4,0"
                              AutomationProperties.Name="{l:Tr 'Nodes'}" />
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Margin="14,10" TextWrapping="Wrap" Foreground="{DynamicResource HintBrush}"
                   Text="{l:Tr 'Open a graph or a behavior tree to see the nodes you can add to it.'}"
                   Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVisibility}}" />

        <TextBlock Grid.Row="3" Margin="10,6,10,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource HintBrush}"
                   Text="{l:Tr 'Drag a node onto the graph or the tree, or double-click it to add it at the center of the view. Decorators and services go on a node: drop them onto it, or select it and double-click.'}" />
    </Grid>
</UserControl>
