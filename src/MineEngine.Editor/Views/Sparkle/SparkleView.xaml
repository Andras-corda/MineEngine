<UserControl x:Class="MineEngine.Editor.Views.Sparkle.SparkleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:sp="clr-namespace:MineEngine.Editor.ViewModels.Sparkle"
             xmlns:local="clr-namespace:MineEngine.Editor.Views.Sparkle"
             xmlns:sparkle="clr-namespace:MineEngine.Assets.Sparkle;assembly=MineEngine.Assets"
             xmlns:graphviews="clr-namespace:MineEngine.Editor.Views.Graphs"
             xmlns:views="clr-namespace:MineEngine.Editor.Views"
             Focusable="True" FocusVisualStyle="{x:Null}" KeyDown="OnKeyDown">

    <!--
        Sparkle: particle system editor (like Unreal's Niagara). DataContext: SparkleDocumentViewModel.
        On the left the square preview (it can be detached in its own window) and the user parameters
        under it, on the right the canvas where the emitters are nodes (right-click: add, drag the
        head: move, click: edit in Properties), framed by comments and described by tooltips, and the
        timeline at the bottom. Gestures are handled by the code-behind.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <graphviews:CommentBrushConverter x:Key="CommentBrush" />

            <!-- Small box of a node: the lines keep the height of their text. -->
            <Style x:Key="NodeCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Arrow" />
            </Style>

            <!-- A line of the stack of a node: switch (optional modules), title, summary of the settings. -->
            <DataTemplate x:Key="NodeModuleTemplate" DataType="{x:Type sp:SparkleModuleViewModel}">
                <Border x:Name="Row" Tag="module" Padding="6,3" Margin="0,1" CornerRadius="4" Background="Transparent" BorderThickness="1"
                        BorderBrush="Transparent" ToolTip="{Binding Description}">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource NodeCheck}" IsChecked="{Binding Enabled}" Margin="0,0,4,0"
                                  Visibility="{Binding IsOptional, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Title}" />
                        <TextBlock x:Name="Summary" DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="11" Margin="8,0,0,0" MaxWidth="120"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource StrongTextBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                        <Setter TargetName="Title" Property="Opacity" Value="0.45" />
                        <Setter TargetName="Summary" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A part of the stack on the node: its title, then its modules. -->
            <DataTemplate x:Key="NodeSectionTemplate" DataType="{x:Type sp:SparkleSectionViewModel}">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource HintBrush}" Margin="6,2,0,1" />
                    <ItemsControl ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource NodeModuleTemplate}" Focusable="False" />
                </StackPanel>
            </DataTemplate>

            <!-- An emitter: head (box "shown in the preview", name, ID), then its stack of modules. -->
            <DataTemplate x:Key="NodeTemplate" DataType="{x:Type sp:SparkleEmitterViewModel}">
                <Border x:Name="Card" Tag="node" Width="250" CornerRadius="7" BorderThickness="1.5"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" />
                    </Border.Effect>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Tag="head" Height="44" Padding="8,0" CornerRadius="6,6,0,0" Cursor="SizeAll"
                                Background="#FF8A5CD6" ToolTip="{l:Tr 'Drag to move the emitter; click to edit it in Properties'}">
                            <DockPanel VerticalAlignment="Center">
                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource NodeCheck}" IsChecked="{Binding Preview}" Margin="0,0,4,0"
                                          ToolTip="{l:Tr 'Shown in the preview'}" AutomationProperties.Name="{l:Tr 'Shown in the preview'}" />
                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="#40000000" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EventId, StringFormat=ID {0}}" FontSize="11" Foreground="White" />
                                </Border>
                                <!-- Described by a tooltip: its message shows over the i. -->
                                <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" FontSize="12"
                                           Foreground="White" Opacity="0.85" VerticalAlignment="Center" Margin="4,0,6,0" Cursor="Help"
                                           ToolTip="{Binding AttachedTooltip}" ToolTipService.InitialShowDelay="100"
                                           Visibility="{Binding HasTooltip, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="2,0,6,0" />
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding NodeSections}" ItemTemplate="{StaticResource NodeSectionTemplate}" Focusable="False" Margin="4,0,4,6" />
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Preview}" Value="False">
                        <Setter TargetName="Card" Property="Opacity" Value="0.7" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Comment: a colored frame with a title; the title moves it (and the emitters inside), the corner resizes it. -->
            <DataTemplate x:Key="CommentTemplate" DataType="{x:Type sp:SparkleNoteViewModel}">
                <Grid Tag="comment" Width="{Binding Width}" Height="{Binding Height}">
                    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1.5"
                            Background="{Binding Color, Converter={StaticResource CommentBrush}, ConverterParameter=fill}"
                            BorderBrush="{Binding Color, Converter={StaticResource CommentBrush}, ConverterParameter=header}" />
                    <Border x:Name="Header" Tag="comment-head" VerticalAlignment="Top" Height="34" CornerRadius="6,6,0,0" Cursor="SizeAll"
                            BorderThickness="2" BorderBrush="Transparent" ToolTip="{Binding HoverText}" ToolTipService.InitialShowDelay="200"
                            Background="{Binding Color, Converter={StaticResource CommentBrush}, ConverterParameter=header}">
                        <DockPanel Margin="10,0">
                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" FontSize="12"
                                       Foreground="White" Opacity="0.8" VerticalAlignment="Center"
                                       Visibility="{Binding HoverText, Converter={StaticResource EmptyToVisible}, ConverterParameter=Invert}" />
                            <TextBlock Text="{Binding Text}" FontSize="16" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Tag="comment-resize" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                            Background="Transparent" Cursor="SizeNWSE" ToolTip="{l:Tr 'Resize the comment'}">
                        <Path Data="M 15,5 L 5,15 M 15,10 L 10,15" Stroke="{DynamicResource HintBrush}" StrokeThickness="1.4" />
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Tooltip: a small bubble; its message shows over it and over the emitters it describes. -->
            <DataTemplate x:Key="TooltipTemplate" DataType="{x:Type sp:SparkleNoteViewModel}">
                <Border x:Name="Bubble" Tag="tooltip" Cursor="SizeAll" CornerRadius="11,11,11,2" Padding="7,3" BorderThickness="1.5"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        ToolTip="{Binding HoverText}" ToolTipService.InitialShowDelay="100">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Info}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentLineBrush}" />
                        <TextBlock Text="{l:Tr 'Tooltip'}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
                        <Setter TargetName="Bubble" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Menus of the canvas (opened where the right-click happened). "Add template emitter" is filled by the
                 code-behind with the templates (beam, fountain...). -->
            <ContextMenu x:Key="CanvasMenu">
                <MenuItem Header="{l:Tr 'Add empty emitter'}" Click="OnAddEmptyClick" FontWeight="SemiBold">
                    <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.NewItem}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Add template emitter'}" Tag="templates">
                    <MenuItem.Icon><views:IconView Icon="SparkleGeometry" IconSize="14" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Paste the emitter'}" InputGestureText="Ctrl+V" Click="OnPasteClick" Tag="paste">
                    <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Paste}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:Tr 'Add a comment'}" InputGestureText="C" Click="OnAddCommentClick" />
                <MenuItem Header="{l:Tr 'Add a tooltip'}" InputGestureText="T" Click="OnAddTooltipClick" />
                <Separator />
                <MenuItem Header="{l:Tr 'Show all'}" InputGestureText="F" Click="OnFrameAllClick">
                    <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.FullScreen}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Snapping'}" IsCheckable="True" IsChecked="{Binding SnapToGrid}"
                          ToolTip="{l:Tr 'The emitters and the notes stop on the lines of the grid'}" />
            </ContextMenu>
            <ContextMenu x:Key="NodeMenu">
                <MenuItem Header="{l:Tr 'Shown in the preview'}" IsCheckable="True" IsChecked="{Binding Preview}" />
                <Separator />
                <MenuItem Header="{l:Tr 'Copy the emitter'}" InputGestureText="Ctrl+C" Click="OnCopyClick">
                    <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Copy}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr 'Duplicate the emitter'}" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
                <MenuItem Header="{l:Tr 'Delete the emitter'}" InputGestureText="Del" Command="{Binding DeleteCommand}">
                    <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Delete}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:Tr 'Add a comment around it'}" InputGestureText="C" Click="OnAddCommentClick" />
                <MenuItem Header="{l:Tr 'Describe it with a tooltip'}" InputGestureText="T" Click="OnAddTooltipClick" />
            </ContextMenu>
            <ContextMenu x:Key="NoteMenu">
                <MenuItem Header="{l:Tr 'Delete'}" InputGestureText="Del" Click="OnDeleteNoteClick">
                    <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Delete}" /></MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

            <!-- A user parameter: name, type and delete on a line, its value under them. -->
            <DataTemplate x:Key="UserParameterTemplate" DataType="{x:Type sp:SparkleUserParameterViewModel}">
                <Border Margin="0,0,0,6" Padding="6" CornerRadius="5" Background="{DynamicResource CardBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource CardBorderBrush}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Command="{Binding DeleteCommand}"
                                    ToolTip="{l:Tr 'Delete the parameter (the linked settings keep its value)'}" AutomationProperties.Name="{l:Tr 'Delete the parameter'}" />
                            <ComboBox DockPanel.Dock="Right" Width="116" Margin="6,0" ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding Type}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="{l:Tr 'Type of the parameter'}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" AutomationProperties.Name="{l:Tr 'Name of the parameter'}" />
                        </DockPanel>
                        <TextBox Margin="0,4,0,0" Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr 'Value of the parameter'}"
                                 Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,4,0,0" Visibility="{Binding IsVector, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="X" Foreground="#E06C6C" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" MinWidth="40" />
                            <TextBlock Grid.Column="2" Text="Y" Foreground="#7CC46A" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,4,0" />
                            <TextBox Grid.Column="3" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" MinWidth="40" />
                            <TextBlock Grid.Column="4" Text="Z" Foreground="#6C9BE0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,4,0" />
                            <TextBox Grid.Column="5" Text="{Binding Z, UpdateSourceTrigger=PropertyChanged}" MinWidth="40" />
                        </Grid>
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding IsColor, Converter={StaticResource BoolToVisibility}}">
                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="4" Margin="0,0,6,0" BorderThickness="1"
                                    BorderBrush="{DynamicResource CardBorderBrush}" Background="{Binding ColorPreview}" />
                            <TextBox Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        </DockPanel>
                        <CheckBox Margin="0,4,0,0" Content="{l:Tr 'Yes'}" IsChecked="{Binding BoolValue}"
                                  Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <Style x:Key="TimelineButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource HubBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Bar: identifier, problems and resources of the system, preview window. -->
        <Border Padding="10,6" Background="{DynamicResource SidebarBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorderBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource BadgeText}" Text="SPARKLE" />
                </Border>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource HintBrush}">
                    <Run Text="{l:Tr 'Identifier in the graphs:'}" />
                    <Run Text="{Binding SystemId, Mode=OneWay}" FontFamily="Consolas" Foreground="{DynamicResource StrongTextBrush}" />
                </TextBlock>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding DetachPreviewCommand}" Margin="10,0,0,0"
                        AutomationProperties.Name="{l:Tr 'Detach the preview'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.OpenInNew}" />
                        <TextBlock x:Name="DetachText" Text="{l:Tr 'Detach the preview'}" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnFrameAllClick" Margin="10,0,0,0"
                        ToolTip="{l:Tr 'Show all the emitters (F)'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.FullScreen}" />
                        <TextBlock Text="{l:Tr 'Show all'}" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding IssueSummary}"
                           Foreground="{DynamicResource HintBrush}" />
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PerformanceSummary}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource HintBrush}" Margin="14,0,0,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="360" MinWidth="180" />
                <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Preview (square), the user parameters and the problems of the system under it -->
            <DockPanel x:Name="PreviewHost" Margin="10,10,0,10">
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Issues}" Focusable="False" Margin="0,6,0,0" MaxHeight="140">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Text" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Margin="0,1"
                                       Foreground="{DynamicResource LogWarningBrush}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <local:SquarePanel x:Name="PreviewSquare" DockPanel.Dock="Top" VerticalAlignment="Top">
                    <ContentControl x:Name="PreviewSlot" Focusable="False" />
                </local:SquarePanel>
                <!-- User parameters: the settings of the modules can be linked to them (in Properties). -->
                <DockPanel Margin="0,10,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="AddParameterButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="OnAddParameterClick"
                                AutomationProperties.Name="{l:Tr 'Add a parameter'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.NewItem}" />
                                <TextBlock Text="{l:Tr 'Add a parameter'}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'USER PARAMETERS'}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Text="{l:Tr 'Values of the system that the settings of the modules are linked to (the link is chosen next to the setting, in Properties).'}"
                               Visibility="{Binding HasUserParameters, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding UserParameters}" ItemTemplate="{StaticResource UserParameterTemplate}" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>

            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ===== Canvas of the emitters ===== -->
            <Grid x:Name="Root" Grid.Column="2" Margin="0,0,0,0" Background="{DynamicResource HubBackgroundBrush}" ClipToBounds="True"
                  MouseLeftButtonDown="OnRootMouseLeftButtonDown" MouseRightButtonUp="OnRootMouseRightButtonUp" MouseDown="OnRootMouseDown"
                  MouseMove="OnRootMouseMove" MouseUp="OnRootMouseUp" MouseWheel="OnRootMouseWheel" LostMouseCapture="OnRootLostMouseCapture"
                  SizeChanged="OnRootSizeChanged">
                <Rectangle x:Name="GridLayer" IsHitTestVisible="False" Visibility="{DynamicResource GraphGridVisibility}" />

                <!-- Help, behind the nodes. -->
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" IsHitTestVisible="False" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource HintBrush}"
                           Text="{l:Tr 'Right-click: add an emitter, or the menu of an emitter · Drag a head: move · Click: edit in Properties · Drag the space: scroll · Wheel: zoom · Del or Backspace: delete · Ctrl+C / Ctrl+V: copy, paste · Ctrl+D: duplicate · C: comment · T: tooltip · F: show all'}" />

                <Canvas x:Name="World">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Zoom" />
                            <TranslateTransform x:Name="Pan" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <!-- Comments, behind the wires and the emitters. -->
                    <ItemsControl x:Name="CommentsHost" ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource CommentTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComment}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Links}" Focusable="False" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sp:SparkleLinkViewModel}">
                                <Path x:Name="Wire" Data="{Binding Geometry}" StrokeThickness="2.6" Stroke="#FF8A5CD6" StrokeLineJoin="Round" Opacity="0.9" />
                                <DataTemplate.Triggers>
                                    <!-- Death: violet, time: teal, location: orange. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static sparkle:SparkleEventKind.Time}">
                                        <Setter TargetName="Wire" Property="Stroke" Value="#FF3CC6B4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static sparkle:SparkleEventKind.Location}">
                                        <Setter TargetName="Wire" Property="Stroke" Value="#FFF0A040" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                        <Setter TargetName="Wire" Property="StrokeDashArray" Value="4 2" />
                                        <Setter TargetName="Wire" Property="Stroke" Value="{DynamicResource LogWarningBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="NodesHost" ItemsSource="{Binding Emitters}" ItemTemplate="{StaticResource NodeTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <!-- Tooltips, above the emitters. -->
                    <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource TooltipTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTooltip}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Canvas>

                <!-- Empty system -->
                <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'No emitter'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StrongTextBrush}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource HintBrush}"
                                   Text="{l:Tr 'Right-click in this space to add an emitter, then click it to edit its modules in Properties.'}" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- ===== Timeline ===== -->
        <Border Grid.Row="2" Padding="10,6" Background="{DynamicResource SidebarBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}"
                DataContext="{Binding Player}">
            <DockPanel>
                <!-- The whole width for the slider, the time on its right. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="110"
                               FontFamily="Consolas" Foreground="{DynamicResource StrongTextBrush}" FontSize="12" />
                    <Slider Minimum="0" Maximum="{Binding Duration}" Value="{Binding Time}" VerticalAlignment="Center"
                            SmallChange="0.0166667" LargeChange="0.5" IsMoveToPointEnabled="True" AutomationProperties.Name="{l:Tr 'Timeline'}" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource TimelineButton}" Content="&#xE892;" Command="{Binding ToStartCommand}"
                            ToolTip="{l:Tr 'Go to the start'}" AutomationProperties.Name="{l:Tr 'Go to the start'}" />
                    <Button Style="{StaticResource TimelineButton}" Content="&#xE76B;" Command="{Binding StepBackCommand}"
                            ToolTip="{l:Tr 'Previous frame'}" AutomationProperties.Name="{l:Tr 'Previous frame'}" />
                    <Button x:Name="ReverseButton" Style="{StaticResource TimelineButton}" Content="&#xE768;" Command="{Binding ReverseCommand}"
                            ToolTip="{l:Tr 'Play backward'}" AutomationProperties.Name="{l:Tr 'Play backward'}">
                        <Button.LayoutTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Button.LayoutTransform>
                    </Button>
                    <Button Style="{StaticResource TimelineButton}" Content="&#xE769;" Command="{Binding PauseCommand}"
                            ToolTip="{l:Tr 'Pause (Space: play or pause)'}" AutomationProperties.Name="{l:Tr 'Pause'}" />
                    <Button x:Name="PlayButton" Style="{StaticResource TimelineButton}" Content="&#xE768;" Command="{Binding PlayCommand}"
                            ToolTip="{l:Tr 'Play'}" AutomationProperties.Name="{l:Tr 'Play'}" />
                    <Button Style="{StaticResource TimelineButton}" Content="&#xE71A;" Command="{Binding StopCommand}"
                            ToolTip="{l:Tr 'Stop (back to the start)'}" AutomationProperties.Name="{l:Tr 'Stop'}" />
                    <Button Style="{StaticResource TimelineButton}" Content="&#xE76C;" Command="{Binding StepForwardCommand}"
                            ToolTip="{l:Tr 'Next frame'}" AutomationProperties.Name="{l:Tr 'Next frame'}" />
                    <Button Style="{StaticResource TimelineButton}" Content="&#xE893;" Command="{Binding ToEndCommand}"
                            ToolTip="{l:Tr 'Go to the end'}" AutomationProperties.Name="{l:Tr 'Go to the end'}" />
                    <ToggleButton Width="30" Height="28" Margin="4,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="13" Content="&#xE8EE;"
                                  IsChecked="{Binding IsLooping}" ToolTip="{l:Tr 'Loop: play again from the start at the end'}"
                                  AutomationProperties.Name="{l:Tr 'Loop'}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ParticleText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource HintBrush}" FontSize="12" />
                <TextBlock Text="{l:Tr '(loops forever: first seconds)'}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource HintBrush}" FontSize="11"
                           Visibility="{Binding IsInfinite, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
