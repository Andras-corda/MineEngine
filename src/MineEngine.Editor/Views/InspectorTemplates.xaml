    <DataTemplate DataType="{x:Type assets:LootEntryViewModel}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" ToolTip="{l:Tr 'Remove the entry'}"
                            VerticalAlignment="Top" Command="{Binding RemoveCommand}" />
                    <views:PropertyRow Label="{l:Tr 'Gives an item?'}" Help="{l:Tr 'Unchecked, the entry gives nothing: with its weight, a chance that the roll gives nothing.'}">
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Check to enable'}" IsChecked="{Binding GivesItem}" />
                    </views:PropertyRow>
                </DockPanel>
                <views:PropertyRow Label="{l:Tr 'Item'}" Help="{l:Tr 'An item, or a tag: one of its items at random.'}" IsEnabled="{Binding GivesItem}">
                    <ContentControl Style="{StaticResource RowPicker}" Content="{Binding ItemPicker}" />
                </views:PropertyRow>
                <views:PropertyRow Label="{l:Tr 'Weight'}" Help="{l:Tr 'Chance of this entry against the others of the pool: an entry of weight 3 comes 3 times as often as one of weight 1.'}">
                    <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="{Binding MaxWeight}" SmallChange="1"
                                  Value="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" />
                </views:PropertyRow>
                <views:PropertyRow Label="{l:Tr 'Count'}" Help="{l:Tr 'Number of items, between the two values.'}" IsEnabled="{Binding GivesItem}">
                    <StackPanel Orientation="Horizontal">
                        <ui:NumberBox Style="{StaticResource RowNumber}" Width="110" Minimum="0" Maximum="{Binding MaxCount}" SmallChange="1"
                                      Value="{Binding CountMin, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{l:Tr 'to'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:NumberBox Style="{StaticResource RowNumber}" Width="110" Minimum="0" Maximum="{Binding MaxCount}" SmallChange="1"
                                      Value="{Binding CountMax, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </views:PropertyRow>
                <views:PropertyRow Label="{l:Tr 'Chance (%)'}" Help="{l:Tr 'Chance that the entry gives something when it is drawn. 100: always.'}">
                    <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="100" SmallChange="5"
                                  Value="{Binding Chance, UpdateSourceTrigger=PropertyChanged}" />
                </views:PropertyRow>
                <views:PropertyRow Label="{l:Tr 'Silk Touch'}" Help="{l:Tr 'Block drop table: what the tool that breaks the block must have.'}">
                    <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding SilkTouchChoices}" SelectedValue="{Binding SilkTouch}" />
                </views:PropertyRow>
                <views:PropertyRow Label="{l:Tr 'More with Looting'}" Help="{l:Tr 'Mob drop table: up to this many more items per level of Looting of the weapon. 0: none.'}" IsEnabled="{Binding GivesItem}">
                    <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxCount}" SmallChange="1"
                                  Value="{Binding LootingBonus, UpdateSourceTrigger=PropertyChanged}" />
                </views:PropertyRow>
                <views:PropertyRow Label="{l:Tr 'Conditions and functions'}" HorizontalContentAlignment="Stretch"
                                   Help="{l:Tr 'Killed by a player and smelted on fire: mob drop table. Survives the explosion: block drop table.'}">
                    <UniformGrid Columns="2">
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Killed by a player'}" IsChecked="{Binding KilledByPlayer}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Survives the explosion'}" IsChecked="{Binding SurvivesExplosion}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Smelted when on fire'}" IsChecked="{Binding SmeltIfOnFire}" IsEnabled="{Binding GivesItem}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Enchanted at random'}" IsChecked="{Binding EnchantRandomly}" IsEnabled="{Binding GivesItem}" />
                    </UniformGrid>
                </views:PropertyRow>
            </StackPanel>
        </Border>
    </DataTemplate>

