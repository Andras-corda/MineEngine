<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assets="clr-namespace:MineEngine.Editor.ViewModels.Assets">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="EditorStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Propriétés communes à tous les assets. -->
    <DataTemplate x:Key="CommonAssetFields" DataType="{x:Type assets:AssetViewModel}">
        <GroupBox Header="Général" Padding="8,4" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Type" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabel}" Text="{Binding TypeLabel}" FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Nom affiché" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Identifiant" />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" FontFamily="Consolas"
                         Text="{Binding ResourceIdText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldHint}" Text="{Binding ResourceIdRule}" />

                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Identifiant en jeu" />
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" FontFamily="Consolas"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Text="{Binding FullResourceId, Mode=OneWay}" />
            </Grid>
        </GroupBox>
    </DataTemplate>

    <!-- Texture : aperçu, chemin et boutons. -->
    <DataTemplate x:Key="TextureFields" DataType="{x:Type assets:TexturedAssetViewModel}">
        <GroupBox Header="Texture" Padding="8,4" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="72" Height="72" BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1" Background="{DynamicResource PreviewBackgroundBrush}"
                        HorizontalAlignment="Left" Margin="0,4,12,4">
                    <Image Source="{Binding TextureFullPath, Converter={StaticResource FilePathToImage}}"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Margin="4" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TextureLabel}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="Choisir..." Command="{Binding ChooseTextureCommand}" />
                        <Button Style="{StaticResource ToolButton}" Content="Retirer" Command="{Binding ClearTextureCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                               Text="Image PNG, idéalement 16 x 16 pixels. Elle est copiée dans le dossier Textures du projet." />
                </StackPanel>
            </Grid>
        </GroupBox>
    </DataTemplate>

    <DataTemplate DataType="{x:Type assets:ItemAssetViewModel}">
        <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="640" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CommonAssetFields}" Focusable="False" />
            <GroupBox Header="Item" Padding="8,4" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Taille de pile" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding MaxStackSize, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHint}"
                               Text="{Binding StackSizeHint}" />
                </Grid>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TextureFields}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type assets:BlockAssetViewModel}">
        <StackPanel Grid.IsSharedSizeScope="True" MaxWidth="640" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CommonAssetFields}" Focusable="False" />
            <GroupBox Header="Bloc" Padding="8,4" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Dureté" />
                    <TextBox Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Hardness, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHint}"
                               Text="{Binding HardnessHint}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Résistance" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
                             Text="{Binding Resistance, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHint}"
                               Text="{Binding ResistanceHint}" />
                </Grid>
            </GroupBox>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TextureFields}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
