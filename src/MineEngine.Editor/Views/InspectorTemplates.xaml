    <!-- Mob (V0.7.9, Entity.md): one tab per window of the spec. -->
    <DataTemplate DataType="{x:Type assets:MobAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <TabControl Style="{StaticResource UnderlineTabControl}" HorizontalContentAlignment="{DynamicResource AssetTabsAlignment}">
                <TabItem Header="{l:Tr 'Visual'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Model'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding ModelChoices}" SelectedValue="{Binding MobModel}" />
                        </WrapPanel>
                        <ContentControl Content="{Binding CustomModel}" Focusable="False"
                                        Visibility="{Binding ShowsModelPicker, Converter={StaticResource BoolToVisibility}}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Model visual scale'}" />
                            <ComboBox Style="{StaticResource RowCombo}" Width="160" ItemsSource="{Binding ValueModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding VisualScaleMode}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Width="110" Minimum="{Binding MinScale}" Maximum="{Binding MaxScale}" SmallChange="0.1"
                                          Value="{Binding VisualScaleValue, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsVisualScaleDynamic, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ComboBox Width="220" Margin="0,2" ItemsSource="{Binding FunctionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding VisualScaleFunction}" Visibility="{Binding IsVisualScaleDynamic, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <ContentControl Content="{Binding MainTexture}" Focusable="False" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,4" Text="{Binding TextureHint}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Margin="0,2,0,8" Content="{l:Tr 'The texture has transparency (see-through pixels)'}"
                                  IsChecked="{Binding TextureTransparent}" />
                        <ContentControl Content="{Binding AppearanceList}" Focusable="False" />

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Bounding box'}" Margin="0,8,0,4" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{Binding HitboxHint}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Margin="0,2,0,4" Content="{l:Tr 'Custom size'}" IsChecked="{Binding UseCustomHitbox}" />
                        <StackPanel IsEnabled="{Binding UseCustomHitbox}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Width and depth (blocks)'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0.1" Maximum="{Binding MaxHitbox}" SmallChange="0.1"
                                              Value="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Height (blocks)'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0.1" Maximum="{Binding MaxHitbox}" SmallChange="0.1"
                                              Value="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Shadow radius (blocks)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxShadowRadius}" SmallChange="0.1"
                                          Value="{Binding ShadowRadius, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Seat of a rider (Y, blocks)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxPassengerOffset}" SmallChange="0.1"
                                          Value="{Binding PassengerOffset, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Height where an entity riding this one sits.'}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Margin="0,4,0,2" Content="{l:Tr 'Disable collisions (nothing pushes it, it pushes nothing)'}"
                                  IsChecked="{Binding NoCollision}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Bounding box scale'}" />
                            <ComboBox Style="{StaticResource RowCombo}" Width="160" ItemsSource="{Binding ValueModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding HitboxScaleMode}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Width="110" Minimum="{Binding MinScale}" Maximum="{Binding MaxScale}" SmallChange="0.1"
                                          Value="{Binding HitboxScaleValue, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsHitboxScaleDynamic, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ComboBox Width="220" Margin="0,2" ItemsSource="{Binding FunctionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding HitboxScaleFunction}" Visibility="{Binding IsHitboxScaleDynamic, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                   Text="{l:Tr 'A dynamic scale is given by a function of the project that takes the mob (or nothing) and returns a number.'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Variations and layers'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Margin="0,0,0,4" Content="{l:Tr 'Has variations'}" IsChecked="{Binding HasVariations}" />
                        <StackPanel Visibility="{Binding HasVariations, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="{l:Tr 'Each new mob takes one of these textures at random; it is saved in its NBT data (Variant).'}" />
                            <ItemsControl ItemsSource="{Binding VariationRows}" Focusable="False" />
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{l:Tr 'Add a variation'}" Command="{Binding AddVariationCommand}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Margin="0,14,0,4" Content="{l:Tr 'Has many layers'}" IsChecked="{Binding HasLayers}" />
                        <StackPanel Visibility="{Binding HasLayers, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="{l:Tr 'Textures drawn over the mob with the same model (eyes, armor, saddle). Functions of the project (the mob → yes / no) can decide when each one shows, glows and turns red.'}" />
                            <ItemsControl ItemsSource="{Binding LayerRows}" Focusable="False" />
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{l:Tr 'Add a layer'}" Command="{Binding AddLayerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Attributes'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Base'}" Margin="0,0,0,4" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Characteristic'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding KindChoices}" SelectedValue="{Binding Kind}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Type'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding CreatureTypeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding CreatureType}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Movement speed'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxMovementSpeed}" SmallChange="0.01"
                                          Value="{Binding MovementSpeed, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Zombie: 0.23; cow: 0.2; spider: 0.3.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Step height'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxStepHeight}" SmallChange="0.1"
                                          Value="{Binding StepHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Follow range'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="{Binding MaxFollowRange}" SmallChange="1"
                                          Value="{Binding FollowRange, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Tracking range (chunks)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="{Binding MaxTrackingRange}" SmallChange="1"
                                          Value="{Binding TrackingRange, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Health points'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="{Binding MaxHealth}" SmallChange="1" LargeChange="10"
                                          Value="{Binding Health, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Knockback'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxKnockback}" SmallChange="0.1"
                                          Value="{Binding Knockback, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Knockback resistance'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="1" SmallChange="0.1"
                                          Value="{Binding KnockbackResistance, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Attack strength'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxAttackDamage}" SmallChange="0.5"
                                          Value="{Binding AttackDamage, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Armor'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxArmor}" SmallChange="1"
                                          Value="{Binding Armor, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Experience given'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxExperience}" SmallChange="1"
                                          Value="{Binding Experience, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Margin="0,14,0,4" Content="{l:Tr 'Tamable'}" IsChecked="{Binding Tamable}" />
                        <StackPanel Visibility="{Binding Tamable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="{l:Tr 'Items that tame it, with their chance for each item given (bones: 33 %). A tamed mob follows its owner and sits when its owner clicks it. Only the Animal family can be tamed.'}" />
                            <ItemsControl ItemsSource="{Binding TamingRows}" Focusable="False" />
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{l:Tr 'Add an item'}" Command="{Binding AddTamingItemCommand}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Margin="0,14,0,4" Content="{l:Tr 'Ridable'}" IsChecked="{Binding Ridable}" />
                        <StackPanel Visibility="{Binding Ridable, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Style="{StaticResource WrapCheck}" Margin="0,2" Content="{l:Tr 'Forward movement'}" IsChecked="{Binding RidingForward}" />
                            <CheckBox Style="{StaticResource WrapCheck}" Margin="0,2" Content="{l:Tr 'Strafe movement'}" IsChecked="{Binding RidingStrafe}" />
                            <CheckBox Style="{StaticResource WrapCheck}" Margin="0,2" Content="{l:Tr 'Needs a saddle'}" IsChecked="{Binding RidingNeedsSaddle}" />
                            <WrapPanel Style="{StaticResource Row}" IsEnabled="{Binding RidingNeedsSaddle}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Layer of the saddle'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding SaddleLayerChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding RidingSaddleLayer}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'The layer shown once a saddle is put on it (right-click with a saddle).'}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Margin="0,14,0,4" Content="{l:Tr 'Is a water entity'}" IsChecked="{Binding IsWaterEntity}" />
                        <StackPanel Visibility="{Binding IsWaterEntity, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource WrapCheck}" Width="250" Content="{l:Tr 'Can breathe in fluids'}" IsChecked="{Binding WaterBreathes}" />
                                <ComboBox Width="220" Margin="0,2" ItemsSource="{Binding FunctionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding WaterBreathesFunction}" ToolTip="{l:Tr 'Function (the mob → yes / no) that decides instead of the box'}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <CheckBox Style="{StaticResource WrapCheck}" Width="250" Content="{l:Tr 'Can be pushed by fluids'}" IsChecked="{Binding WaterPushed}" />
                                <ComboBox Width="220" Margin="0,2" ItemsSource="{Binding FunctionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding WaterPushedFunction}" ToolTip="{l:Tr 'Function (the mob → yes / no) that decides instead of the box'}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Fluid'}" />
                                <ContentControl Style="{StaticResource RowPicker}" Content="{Binding WaterFluid}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Fluid it lives in (minecraft:water by default).'}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Is immune to'}" Margin="0,14,0,4" />
                        <ContentControl Content="{Binding ImmunityOptions}" ContentTemplate="{StaticResource MobToggleGrid}" Focusable="False" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,2" Text="{l:Tr 'Damage types of the project:'}"
                                   Visibility="{Binding HasDamageTypes, Converter={StaticResource BoolToVisibility}}" />
                        <ContentControl Content="{Binding DamageTypeImmunityOptions}" ContentTemplate="{StaticResource MobToggleGrid}" Focusable="False" />
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Is vulnerable to'}" Margin="0,14,0,4" />
                        <ContentControl Content="{Binding VulnerabilityOptions}" ContentTemplate="{StaticResource MobToggleGrid}" Focusable="False" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Spawn'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10" Visibility="{Binding IsVehicle, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Text="{l:Tr 'This mob is a vehicle (Special properties): it is placed by its item, so it neither spawns nor has an egg.'}" />
                        </Border>
                        <StackPanel IsEnabled="{Binding IsNotVehicle}">
                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Margin="0,0,0,6" Content="{l:Tr 'Enable spawning of the entity'}"
                                  IsChecked="{Binding SpawnsNaturally}" />
                        <StackPanel IsEnabled="{Binding SpawnsNaturally}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Spawn weight'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="{Binding MaxSpawnWeight}" SmallChange="1"
                                              Value="{Binding SpawnWeight, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Compared to other creatures: zombie 100, cow 8, creeper 100.'}" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Spawn group size'}" />
                                <ComboBox Style="{StaticResource RowCombo}" Width="170" ItemsSource="{Binding GroupModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding GroupMode}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Width="110" Minimum="1" Maximum="{Binding MaxGroupSize}" SmallChange="1"
                                              Value="{Binding SpawnMinGroup, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsGroupDynamic, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Width="110" Minimum="1" Maximum="{Binding MaxGroupSize}" SmallChange="1"
                                              Value="{Binding SpawnMaxGroup, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsGroupRange, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox Width="220" Margin="0,2" ItemsSource="{Binding FunctionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding GroupFunction}" Visibility="{Binding IsGroupDynamic, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Dimensions'}" Margin="0,10,0,4" />
                            <ContentControl Content="{Binding DimensionOptions}" ContentTemplate="{StaticResource MobToggleGrid}" Focusable="False" />
                            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Biomes of the Overworld'}" Margin="0,10,0,4" />
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'None checked: the whole Overworld.'}" />
                            <ContentControl Content="{Binding BiomeOptions}" ContentTemplate="{StaticResource MobToggleGrid}" Focusable="False" />

                            <CheckBox Style="{StaticResource WrapCheck}" Margin="0,10,0,4" Content="{l:Tr 'Is attached to structures (spawns only inside them)'}"
                                      IsChecked="{Binding InStructures}" />
                            <ContentControl Content="{Binding StructureOptions}" ContentTemplate="{StaticResource MobToggleGrid}" Focusable="False"
                                            Visibility="{Binding InStructures, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'A monster spawns in the dark, an animal on grass, a creature on any ground.'}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource WrapCheck}" Margin="0,12,0,2" Content="{l:Tr 'Enable despawn (far from the players)'}" IsChecked="{Binding Despawns}" />
                        <WrapPanel Style="{StaticResource Row}" IsEnabled="{Binding Despawns}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Custom despawn condition'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding FunctionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding DespawnFunction}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Function (the mob → yes / no); none: the rule of the game.'}" />

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Spawn egg'}" Margin="0,14,0,4" />
                        <CheckBox Style="{StaticResource WrapCheck}" Margin="0,0,0,6" Content="{l:Tr 'Spawn egg'}" IsChecked="{Binding HasSpawnEgg}" />
                        <StackPanel IsEnabled="{Binding HasSpawnEgg}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Background color'}" />
                                <TextBox Width="110" FontFamily="Consolas"
                                         Text="{Binding EggPrimaryText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <Border Width="28" Height="28" Margin="8,0,0,0" CornerRadius="14" BorderThickness="1"
                                        BorderBrush="{DynamicResource PreviewBorderBrush}" Background="{Binding EggPrimaryPreview}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Spot color'}" />
                                <TextBox Width="110" FontFamily="Consolas"
                                         Text="{Binding EggSecondaryText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <Border Width="28" Height="28" Margin="8,0,0,0" CornerRadius="14" BorderThickness="1"
                                        BorderBrush="{DynamicResource PreviewBorderBrush}" Background="{Binding EggSecondaryPreview}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Creative tab'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding CreativeTabChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding EggCreativeTab}" />
                            </WrapPanel>
                            <ContentControl Content="{Binding EggTexture}" Focusable="False" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Spawn in game'}" Margin="0,12,0,2" />
                        <TextBox IsReadOnly="True" FontFamily="Consolas" Text="{Binding SummonCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Special properties'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Margin="0,0,0,4" Content="{l:Tr 'Is a boss'}" IsChecked="{Binding IsBoss}" />
                        <StackPanel Visibility="{Binding IsBoss, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Style="{StaticResource WrapCheck}" Margin="0,2" Content="{l:Tr 'Show the health bar'}" IsChecked="{Binding BossShowBar}" />
                            <WrapPanel Style="{StaticResource Row}" IsEnabled="{Binding BossShowBar}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Color'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding BossColorChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding BossColor}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}" IsEnabled="{Binding BossShowBar}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Type'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding BossOverlayChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding BossOverlay}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Minecraft has seven colors of bar: the closest one is used. A custom bar (widget) will come later.'}" />
                        </StackPanel>

                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Margin="0,14,0,4" Content="{l:Tr 'Is a golem'}" IsChecked="{Binding IsGolem}" />
                        <StackPanel Visibility="{Binding IsGolem, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Block activator'}" />
                                <ContentControl Style="{StaticResource RowPicker}" Content="{Binding GolemActivator}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Detection function'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding FunctionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding GolemFunction}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                       Text="{l:Tr 'Without function: placing the block on a column of two identical blocks builds the mob, like a snow golem. With a function (the position of the block → yes / no), the mob appears where it says yes.'}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource StackedLabel}" FontWeight="SemiBold" Margin="0,14,0,2" Text="{l:Tr 'Vehicle'}" />
                        <WrapPanel>
                            <CheckBox Style="{StaticResource WrapCheck}" Margin="0,0,16,4" Content="{l:Tr 'Is a boat'}" IsChecked="{Binding IsBoat}" IsEnabled="{Binding CanBeBoat}" />
                            <CheckBox Style="{StaticResource WrapCheck}" Margin="0,0,16,4" Content="{l:Tr 'Is a minecart'}" IsChecked="{Binding IsMinecart}" IsEnabled="{Binding CanBeMinecart}" />
                        </WrapPanel>
                        <StackPanel IsEnabled="{Binding IsVehicle}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Rarity'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding RarityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding VehicleRarity}" />
                            </WrapPanel>
                            <ContentControl Content="{Binding VehicleTexture}" Focusable="False" />
                            <TextBlock Style="{StaticResource RowHint}" Text="{Binding VehicleItemHint}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'A boat floats on water; a minecart is placed on a rail and runs along it. The player rides it and drives it; broken, it gives back its item. A vehicle neither spawns nor has an egg or AI.'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Events and triggers'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{l:Tr 'Connect an event of the mob to a node graph: what happens there runs on the server when the event occurs. No event is used by default.'}" />
                        <ItemsControl ItemsSource="{Binding Events}" Focusable="False" ItemTemplate="{StaticResource EventLinkCard}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'AI'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10" Visibility="{Binding IsVehicle, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Text="{l:Tr 'This mob is a vehicle (Special properties): it has no AI, only its rider moves it.'}" />
                        </Border>
                        <StackPanel IsEnabled="{Binding IsNotVehicle}">
                        <!-- Ce qui pilote le mob : la liste de comportements ou un arbre Puppeteer (V0.6). -->
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Driven by'}" />
                            <ComboBox Width="300" Margin="0,2,8,2" ItemsSource="{Binding TreeChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding TreeId}" />
                            <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Open in Puppeteer'}" Command="{Binding OpenTreeCommand}"
                                    Visibility="{Binding UsesBehaviorTree, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Create a Puppeteer tree'}" Command="{Binding CreateTreeCommand}"
                                    Visibility="{Binding UsesBehaviorTree, Converter={StaticResource InverseBoolToVisibility}}"
                                    ToolTip="{l:Tr 'Describe the AI with nodes (selectors, sequences, tasks), like Unreal\'s Behavior Trees'}" />
                        </WrapPanel>
                        <Border Style="{StaticResource InfoBanner}" Margin="0,4,0,8"
                                Visibility="{Binding UsesBehaviorTree, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="{l:Tr 'The Puppeteer tree replaces the list of behaviors (it is kept if you go back to it). The mob always swims so it does not drown.'}" />
                        </Border>

                        <StackPanel Visibility="{Binding UsesBehaviorTree, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,8"
                                       Text="{l:Tr 'Behaviors by priority order: the first one that can act wins over the next ones. Targeting behaviors choose who to attack.'}" />
                            <ItemsControl ItemsSource="{Binding Goals}" Focusable="False" />
                            <WrapPanel Margin="0,4,0,0">
                                <ComboBox Width="230" Margin="0,2,8,2" ItemsSource="{Binding GoalKindChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding NewGoalKind}" />
                                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Add'}" Command="{Binding AddGoalCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsAnimal, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Breeding'}" Margin="0,0,0,4" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Breeding item'}" />
                                <ContentControl Style="{StaticResource RowPicker}" Content="{Binding BreedingItem}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Given to two adults, it makes them breed (cow: minecraft:wheat).'}" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Sounds and loot'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,6"
                                   Text="{l:Tr 'A sound from the project (&quot;goblin_roar&quot;) or from Minecraft (&quot;minecraft:entity.zombie.ambient&quot;); empty for the default sound.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Ambient sound'}" />
                            <ContentControl Style="{StaticResource RowPicker}" Content="{Binding AmbientSound}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Hurt sound'}" />
                            <ContentControl Style="{StaticResource RowPicker}" Content="{Binding HurtSound}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Death sound'}" />
                            <ContentControl Style="{StaticResource RowPicker}" Content="{Binding DeathSound}" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Loot'}" Margin="0,12,0,4" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Drop table'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding LootTableChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding DropTable}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'A drop table of the project replaces the list below (looting, killed by a player...).'}" />
                        <StackPanel IsEnabled="{Binding UsesDropList}">
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,6" Text="{l:Tr 'Items dropped on death, each with a random quantity.'}" />
                            <ItemsControl ItemsSource="{Binding Drops}" Focusable="False" />
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{l:Tr 'Add an item'}" Command="{Binding AddDropCommand}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
