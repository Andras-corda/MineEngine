                            <TextBox Width="120" FontFamily="Consolas" Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Color of the particles and of the potion, #RRGGBB.'}" />
                        <ContentControl Content="{Binding IconTexture}" Focusable="False" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Icon of 18 x 18 pixels, shown in the inventory.'}" />
                        <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Identifier in the graphs'}" Margin="0,8,0,2" />
                        <TextBox IsReadOnly="True" FontFamily="Consolas" Text="{Binding FullId, Mode=OneWay}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="{l:Tr 'Effects'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Per level of the effect (level II doubles them). 0 for no change.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Speed (%)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="-100" Maximum="500" SmallChange="5" Value="{Binding SpeedPercent, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Attack damage'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="-100" Maximum="100" SmallChange="0.5" Value="{Binding AttackDamage, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Armor'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="-30" Maximum="30" SmallChange="1" Value="{Binding Armor, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Maximum health'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="-100" Maximum="100" SmallChange="2" Value="{Binding MaxHealth, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'At regular intervals'}" Margin="0,10,0,4" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Healing'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="100" SmallChange="0.5" Value="{Binding HealAmount, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Damage'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="100" SmallChange="0.5" Value="{Binding DamageAmount, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Every (ticks)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="1200" SmallChange="10" Value="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Regeneration: 1 health every 50 ticks; Poison: 1 damage every 25 ticks (20 ticks = 1 second).'}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="{l:Tr 'Potion'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <CheckBox Style="{StaticResource WrapCheck}" Margin="0,4" IsChecked="{Binding HasPotion}"
                                  Content="{l:Tr 'Has a potion (also splash, lingering and tipped arrows)'}" />
                        <WrapPanel Style="{StaticResource Row}" IsEnabled="{Binding HasPotion}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Duration (seconds)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="3600" SmallChange="10" Value="{Binding PotionSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{l:Tr 'The potions are in the creative inventory (Brewing tab). Graphs give the effect with the node &quot;Give an effect&quot;.'}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DataTemplate>

