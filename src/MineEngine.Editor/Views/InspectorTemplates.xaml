<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:MineEngine.Editor.Views"
                    xmlns:graphs="clr-namespace:MineEngine.Editor.Views.Graphs"
                    xmlns:l="clr-namespace:MineEngine.Editor.Localization"
                    xmlns:ui="http://schemas.modernwpf.com/2019"
                    xmlns:assets="clr-namespace:MineEngine.Editor.ViewModels.Assets">

    <!--
        Inspector des assets, organisé en onglets comme les éditeurs de MCreator :
        Item    : Visuel, Propriétés, Nourriture.
        Bloc    : Visuel, Propriétés, Récolte, Item.
        Mob     : Apparence, Attributs, IA, Apparition, Sons et butin.
        Recette : type, grille de l'établi ou four, résultat.
        Texture et Son : fichier, aperçu, remplacement.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Mise en forme d'une ligne : libellé à gauche, contrôle à droite. Quand l'Inspector
        est étroit, le contrôle passe sous son libellé (WrapPanel).
    -->
    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="Width" Value="150" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Row" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <!-- Champ texte : libellé au-dessus, zone de saisie sur toute la largeur. -->
    <Style x:Key="FieldRow" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style x:Key="StackedLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="RowNumber" TargetType="ui:NumberBox">
        <Setter Property="Width" Value="160" />
        <Setter Property="Margin" Value="0,2,8,2" />
        <Setter Property="SpinButtonPlacementMode" Value="Inline" />
    </Style>
    <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="230" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Value" />
    </Style>
    <!-- Case à cocher dont le texte revient à la ligne au lieu d'être coupé. -->
    <Style x:Key="WrapCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TabContent" TargetType="StackPanel">
        <Setter Property="Margin" Value="4,10,4,4" />
    </Style>

    <!-- Propriétés communes à tous les assets. -->
    <!-- Alignment of the tab headers of an element (Appearance, Attributes...): left in the Inspector, centered in the editing tab. -->
    <HorizontalAlignment x:Key="AssetTabsAlignment">Left</HorizontalAlignment>

    <DataTemplate x:Key="CommonAssetFields" DataType="{x:Type assets:AssetViewModel}">
        <GroupBox Header="{l:Tr 'General'}" Padding="8,4" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Type'}" />
                    <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </WrapPanel>
                <StackPanel Style="{StaticResource FieldRow}">
                    <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'In-game name'}" />
                    <TextBox Style="{StaticResource FieldBox}" Margin="0" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FieldRow}">
                    <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Identifier'}" />
                    <TextBox Style="{StaticResource FieldBox}" Margin="0" FontFamily="Consolas"
                             Text="{Binding ResourceIdText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Style="{StaticResource RowHint}" Text="{Binding ResourceIdRule}" />
                <WrapPanel Style="{StaticResource Row}" Visibility="{Binding HasGameId, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'In-game identifier'}" />
                    <TextBlock FontFamily="Consolas" VerticalAlignment="Center" Text="{Binding FullResourceId}" />
                </WrapPanel>

                <!-- Liens par identifiant interne : renommer cet asset met à jour ces assets. -->
                <StackPanel Margin="0,6,0,2" Visibility="{Binding IsUsed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Used by'}" />
                    <ItemsControl ItemsSource="{Binding UsedBy}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type assets:AssetLinkViewModel}">
                                <TextBlock Margin="0,1" TextWrapping="Wrap">
                                    <Hyperlink Command="{Binding DataContext.OpenAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding TargetId}">
                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </DataTemplate>

    <!-- Un emplacement de texture : aperçu, choix d'une texture du projet, import. -->
    <DataTemplate DataType="{x:Type assets:TextureSlotViewModel}">
        <DockPanel Margin="0,4">
            <!-- Double-click on the preview: the texture browser (every texture as a grid). -->
            <Border DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,12,0" BorderThickness="1" VerticalAlignment="Top" Cursor="Hand"
                    BorderBrush="{DynamicResource PreviewBorderBrush}" Background="{DynamicResource PreviewBackgroundBrush}"
                    ToolTip="{l:Tr 'Double-click: choose among all the textures'}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding BrowseCommand}" />
                </Border.InputBindings>
                <Image Source="{Binding FullPath, Converter={StaticResource FilePathToImage}}"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Margin="4" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <ComboBox Margin="0,4" HorizontalAlignment="Stretch" ItemsSource="{Binding Options}"
                          DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedTextureId}" />
                <TextBlock Text="{Binding PathLabel}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource HintBrush}" Margin="0,0,0,4" />
                <WrapPanel>
                    <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Browse...'}" Command="{Binding BrowseCommand}"
                            ToolTip="{l:Tr 'Every texture of the project as a grid (or double-click the preview)'}" />
                    <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Import...'}" Command="{Binding ImportCommand}"
                            ToolTip="{l:Tr 'Import a PNG image: it becomes a Texture asset'}" />
                    <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Remove'}" Command="{Binding ClearCommand}" />
                    <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Open'}" Command="{Binding OpenCommand}"
                            ToolTip="{l:Tr 'Show the Texture asset'}" />
                </WrapPanel>
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <!--
        A texture slot as a square tile (faces of a block laid out as an unfolded cube): double-click to
        choose among all the textures, right-click to import or remove.
    -->
    <DataTemplate x:Key="TextureTile" DataType="{x:Type assets:TextureSlotViewModel}">
        <Grid Width="92" Height="96" Margin="2">
            <Border BorderThickness="1" BorderBrush="{DynamicResource PreviewBorderBrush}" Margin="0,0,0,8" Cursor="Hand" Background="Transparent"
                    ToolTip="{Binding PathLabel}" AutomationProperties.Name="{Binding Label}">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding BrowseCommand}" />
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Tr 'Browse...'}" Command="{Binding BrowseCommand}" />
                        <MenuItem Header="{l:Tr 'Import...'}" Command="{Binding ImportCommand}" />
                        <MenuItem Header="{l:Tr 'Remove'}" Command="{Binding ClearCommand}" />
                        <MenuItem Header="{l:Tr 'Open'}" Command="{Binding OpenCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border Margin="10,10,10,14" Background="{DynamicResource PreviewBackgroundBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource PreviewBorderBrush}">
                    <Image Source="{Binding FullPath, Converter={StaticResource FilePathToImage}}" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Stretch="Uniform" />
                </Border>
            </Border>
            <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="4,0,0,0" Padding="2,0"
                       Background="{DynamicResource HubBackgroundBrush}" TextTrimming="CharacterEllipsis" MaxWidth="86" />
        </Grid>
    </DataTemplate>

    <!-- 3D model of an item, a block or a mob: choice among the models of the project, or import. -->
    <DataTemplate DataType="{x:Type assets:ModelPickerViewModel}">
        <StackPanel Margin="0,4,0,8">
            <TextBlock Text="{l:Tr '3D model'}" FontWeight="SemiBold" />
            <ComboBox Margin="0,4" HorizontalAlignment="Stretch" ItemsSource="{Binding Options}" AutomationProperties.Name="{l:Tr '3D model'}"
                      DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedModelId}" />
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Browse...'}" Command="{Binding BrowseCommand}"
                        ToolTip="{l:Tr 'Every 3D model of the project and of Minecraft, as a grid with a search'}" />
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Import a model...'}" Command="{Binding ImportCommand}"
                        ToolTip="{l:Tr 'Import a Blockbench or Java JSON model and bind its textures'}" />
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Open'}" Command="{Binding OpenCommand}"
                        ToolTip="{l:Tr 'Show the model: its textures, variants and layers'}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Hint}" />
        </StackPanel>
    </DataTemplate>

    <!--
        Item, bloc ou son : saisie libre avec suggestions. La recherche automatique est
        désactivée, sinon "ruby" serait complété en "ruby_ore" pendant la frappe.
    -->
    <DataTemplate DataType="{x:Type assets:ReferencePickerViewModel}">
        <ComboBox IsEditable="True" IsTextSearchEnabled="False" FontFamily="Consolas"
                  HorizontalAlignment="Stretch" ItemsSource="{Binding Suggestions}" ToolTip="{Binding Text}"
                  Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
    </DataTemplate>

    <Style x:Key="RowPicker" TargetType="ContentControl">
        <Setter Property="Width" Value="230" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Carte d'un élément de liste (comportement d'IA, butin). -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource PreviewBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Propriétés d'inventaire (items et forme item des blocs). -->
    <DataTemplate x:Key="InventoryFields" DataType="{x:Type assets:InventoryAssetViewModel}">
        <StackPanel>
            <WrapPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Rarity'}" />
                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding RarityChoices}" SelectedValue="{Binding Rarity}" />
            </WrapPanel>
            <WrapPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Stack size'}" />
                <ui:NumberBox Style="{StaticResource RowNumber}" IsEnabled="{Binding CanEditStackSize}"
                              Minimum="{Binding MinStackSize}" Maximum="{Binding MaxStackSizeLimit}" SmallChange="1" LargeChange="16"
                              Value="{Binding MaxStackSize, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource RowHint}" Text="{Binding StackSizeHint}" />
            <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Resists fire and lava (like netherite)'}" Margin="0,4"
                      IsChecked="{Binding FireResistant}" />

            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Tooltip'}" Margin="0,12,0,4" />
            <TextBox Style="{StaticResource FieldBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding TooltipText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource FieldHint}" Text="{l:Tr 'Text shown under the name, one line per line. Minecraft color codes are accepted (for example §6 for gold).'}" />

            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Creative tabs'}" Margin="0,12,0,4" />
            <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Mod tab'}" Margin="0,2,0,6" IsChecked="{Binding InModCreativeTab}" />
            <ItemsControl ItemsSource="{Binding CreativeTabOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type assets:CreativeTabOptionViewModel}">
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- Appearances of an item, a block or a mob: other looks switched by the appearance nodes of the graphs. -->
    <DataTemplate DataType="{x:Type assets:AppearanceListViewModel}">
        <StackPanel Margin="0,12,0,0">
            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Appearances'}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding Hint}" />
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type assets:AppearanceRowViewModel}">
                        <Border Style="{StaticResource Card}" Padding="8,6" Margin="0,0,0,6">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Margin="0,0,10,0" VerticalAlignment="Top"
                                        Background="{DynamicResource AccentLineBrush}" ToolTip="{l:Tr 'Number given to the appearance nodes'}">
                                    <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource ToolButton}" Content="▲" Command="{Binding MoveUpCommand}" ToolTip="{l:Tr 'Move up'}" />
                                    <Button Style="{StaticResource ToolButton}" Content="▼" Command="{Binding MoveDownCommand}" ToolTip="{l:Tr 'Move down'}" />
                                    <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Remove'}" Command="{Binding RemoveCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4" ToolTip="{l:Tr 'Name of the appearance (only for you)'}" />
                                    <StackPanel Visibility="{Binding CanUseModels, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{l:Tr '3D model'}" FontSize="12" Margin="0,2,0,2" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ModelOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Id" SelectedValue="{Binding ModelId}" AutomationProperties.Name="{l:Tr '3D model'}" />
                                    </StackPanel>
                                    <ContentControl Content="{Binding Texture}" Focusable="False" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.NewItem}" />
                    <TextBlock Text="{l:Tr 'Add an appearance'}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Item ===================== -->
    <DataTemplate DataType="{x:Type assets:ItemAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <TabControl Style="{StaticResource UnderlineTabControl}" HorizontalContentAlignment="{DynamicResource AssetTabsAlignment}">
                <TabItem Header="{l:Tr 'Visual'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <ContentControl Content="{Binding CustomModel}" Focusable="False" />
                        <StackPanel Visibility="{Binding UsesCustomModel, Converter={StaticResource InverseBoolToVisibility}}">
                            <ContentControl Content="{Binding MainTexture}" Focusable="False" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,8"
                                       Text="{l:Tr 'PNG image, ideally 16 x 16 pixels. An imported image becomes a reusable Texture asset.'}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Glint effect (like an enchanted book)'}" Margin="0,4" IsChecked="{Binding HasGlint}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Held like a tool (diagonally in the hand)'}" Margin="0,4" IsChecked="{Binding Handheld}" />
                        <ContentControl Content="{Binding AppearanceList}" Focusable="False" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Type'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Item type'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding KindChoices}" SelectedValue="{Binding Kind}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="{l:Tr 'A tool, weapon or armor uses Minecraft\'s behavior (mining, damage, defense); its durability comes from its material.'}" />

                        <StackPanel Visibility="{Binding IsTool, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Material'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding TierChoices}" SelectedValue="{Binding Tier}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Sets the durability, mining speed, enchantability and repair material.'}" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Added damage'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="-100" Maximum="{Binding MaxAttack}" SmallChange="0.5"
                                              Value="{Binding AttackDamage, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Attack speed'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="-4" Maximum="{Binding MaxAttack}" SmallChange="0.1"
                                              Value="{Binding AttackSpeed, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{l:Tr 'Iron sword: 3 and -2.4; axe: 6 and -3.1. The damage is added to the material\'s; a lower speed hits less often.'}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsArmor, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Material'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding ArmorMaterialChoices}" SelectedValue="{Binding ArmorMaterial}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{l:Tr 'Sets the defense, durability and look of the worn armor (Minecraft\'s for this material).'}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Properties'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}" IsEnabled="{Binding CanEditDurability}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Durability'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxDurability}"
                                          SmallChange="1" LargeChange="50"
                                          Value="{Binding Durability, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="{l:Tr 'Number of uses before breaking; 0 = none. Iron: 250, diamond: 1561. An item with durability does not stack.'}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryFields}" Focusable="False" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Cannot be repaired on an anvil with a material'}" Margin="0,8,0,4" IsChecked="{Binding NoRepair}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Food'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'This item is edible'}" FontWeight="SemiBold" Margin="0,0,0,8" IsChecked="{Binding IsFood}" />
                        <StackPanel IsEnabled="{Binding IsFood}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Nutrition'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxNutrition}" SmallChange="1"
                                              Value="{Binding Nutrition, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'In half drumsticks: 4 = two drumsticks (apple), 8 = steak.'}" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Saturation'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxSaturation}" SmallChange="0.1"
                                              Value="{Binding Saturation, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Delays hunger. Apple: 0.3; steak: 0.8.'}" />
                            <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Always edible, even when not hungry'}" Margin="0,4" IsChecked="{Binding AlwaysEdible}" />
                            <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Meat (wolves can eat it)'}" Margin="0,4" IsChecked="{Binding IsMeat}" />
                            <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Eaten twice as fast (like berries)'}" Margin="0,4" IsChecked="{Binding FastFood}" />

                            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Effects when eaten'}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding FoodEffects}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type assets:FoodEffectViewModel}">
                                        <Border Style="{StaticResource Card}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" ToolTip="{l:Tr 'Remove'}"
                                                        VerticalAlignment="Top" Command="{Binding RemoveCommand}" />
                                                <StackPanel>
                                                    <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding EffectChoices}" SelectedValue="{Binding Kind}" />
                                                    <WrapPanel>
                                                        <ui:NumberBox Header="{l:Tr 'Duration (s)'}" Width="120" Margin="0,4,8,0" SpinButtonPlacementMode="Compact"
                                                                      Minimum="1" Maximum="{Binding MaxSeconds}" Value="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ui:NumberBox Header="{l:Tr 'Level'}" Width="90" Margin="0,4,8,0" SpinButtonPlacementMode="Compact"
                                                                      Minimum="1" Maximum="{Binding MaxLevel}" Value="{Binding Level, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ui:NumberBox Header="{l:Tr 'Chance (%)'}" Width="110" Margin="0,4,8,0" SpinButtonPlacementMode="Compact"
                                                                      Minimum="0" Maximum="100" Value="{Binding Percent, UpdateSourceTrigger=PropertyChanged}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{l:Tr 'Add an effect'}" Command="{Binding AddFoodEffectCommand}" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,0"
                                       Text="{l:Tr 'Golden apple: Regeneration II for 5 s and Absorption I for 2 min, chance 100%.'}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Data'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Item returned after crafting'}" />
                            <ContentControl Style="{StaticResource RowPicker}" Content="{Binding CraftRemainder}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Left in the crafting grid (like the empty bucket after a cake). Empty: nothing.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Fuel (seconds)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxBurnSeconds}" SmallChange="5"
                                          Value="{Binding BurnSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Burn time in a furnace; 0 = not a fuel. Coal: 80 s, stick: 5 s.'}" />

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Tags'}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource FieldBox}" AcceptsReturn="True" FontFamily="Consolas" MinHeight="56"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="{l:Tr 'One tag per line. They are used by recipes and for compatibility with other mods: c:gems/ruby, minecraft:piglin_loved, minecraft:beacon_payment_items...'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Events'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,0,0,8"
                                   Text="{l:Tr 'Connect an item event to a node graph: what happens there (message, sound, item given...) runs when the event occurs.'}" />
                        <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type assets:ItemEventViewModel}">
                                    <Border x:Name="EventCard" Style="{StaticResource Card}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Open'}" Command="{Binding OpenCommand}"
                                                        Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Style="{StaticResource ToolButton}" Command="{Binding AddCommand}" ToolTip="{l:Tr 'Add this event to the item\'s event graph'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.NewItem}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{l:Tr 'Connect'}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="Bolt" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Event}" Margin="0,2,8,0"
                                                               Foreground="{DynamicResource HintBrush}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource HintBrush}" />
                                                <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource HintBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLinked}" Value="True">
                                            <Setter TargetName="Bolt" Property="Foreground" Value="{DynamicResource AccentLineBrush}" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                            <Setter TargetName="EventCard" Property="BorderBrush" Value="{DynamicResource CardSelectedBorderBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,0" Text="{Binding EventsHint}" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DataTemplate>
    <!-- ===================== Bloc ===================== -->
    <DataTemplate DataType="{x:Type assets:BlockAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <TabControl Style="{StaticResource UnderlineTabControl}" HorizontalContentAlignment="{DynamicResource AssetTabsAlignment}">
                <TabItem Header="{l:Tr 'Visual'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Shape'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding ModelChoices}" SelectedValue="{Binding BlockModel}" />
                        </WrapPanel>
                        <ContentControl Content="{Binding CustomModel}" Focusable="False"
                                        Visibility="{Binding ShowsModelPicker, Converter={StaticResource BoolToVisibility}}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Transparency'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding RenderTypeChoices}" SelectedValue="{Binding RenderType}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Light level'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxLightLevel}" SmallChange="1"
                                          Value="{Binding LightLevel, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Light emitted from 0 to 15. Torch: 14, glowstone: 15.'}" />

                        <StackPanel Visibility="{Binding ShowsModelPicker, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Textures'}" Margin="0,12,0,4" />
                            <!-- One texture per face: the faces of the cube unfolded, like MCreator. -->
                            <StackPanel Visibility="{Binding ShowsFaceCross, Converter={StaticResource BoolToVisibility}}">
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ContentControl Grid.Column="1" Content="{Binding TopSlot}" ContentTemplate="{StaticResource TextureTile}" Focusable="False" />
                                    <ContentControl Grid.Row="1" Content="{Binding LeftSlot}" ContentTemplate="{StaticResource TextureTile}" Focusable="False" />
                                    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding FrontSlot}" ContentTemplate="{StaticResource TextureTile}" Focusable="False" />
                                    <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding RightSlot}" ContentTemplate="{StaticResource TextureTile}" Focusable="False" />
                                    <ContentControl Grid.Row="1" Grid.Column="3" Content="{Binding BackSlot}" ContentTemplate="{StaticResource TextureTile}" Focusable="False" />
                                    <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding BottomSlot}" ContentTemplate="{StaticResource TextureTile}" Focusable="False" />
                                    <ContentControl Grid.Row="2" Grid.Column="3" Content="{Binding MainTexture}" ContentTemplate="{StaticResource TextureTile}" Focusable="False"
                                                    ToolTip="{l:Tr 'Default texture: particles, and the faces left empty'}" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="{l:Tr 'Double-click a face to choose its texture; right-click to import or remove it.'}" />
                            </StackPanel>
                            <ContentControl Content="{Binding MainTexture}" Focusable="False"
                                            Visibility="{Binding ShowsFaceCross, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding ExtraTextures}" Focusable="False"
                                          Visibility="{Binding ShowsFaceCross, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                                       Text="{l:Tr 'Faces without a texture use the default texture.'}" />
                        </StackPanel>
                        <ContentControl Content="{Binding ParticleTextureSlot}" Focusable="False" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'Particle texture: the pieces that fly when the block breaks. Empty: the main texture.'}" />
                        <ContentControl Content="{Binding AppearanceList}" Focusable="False" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Properties'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Hardness'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxStrength}" SmallChange="0.5" LargeChange="5"
                                          IsEnabled="{Binding Unbreakable, Converter={StaticResource InverseBool}}"
                                          Value="{Binding Hardness, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Time to break the block. Dirt: 0.5; stone: 1.5; ore: 3.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Resistance'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="{Binding MaxStrength}" SmallChange="1" LargeChange="10"
                                          IsEnabled="{Binding Unbreakable, Converter={StaticResource InverseBool}}"
                                          Value="{Binding Resistance, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Blast resistance. Stone: 6; obsidian: 1200.'}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Unbreakable (like bedrock)'}" Margin="0,4,0,8" IsChecked="{Binding Unbreakable}" />

                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Sounds'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding SoundChoices}" SelectedValue="{Binding Sound}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Slipperiness'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0.1" Maximum="1.2" SmallChange="0.05"
                                          Value="{Binding Friction, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr '0.6 normal; slime: 0.8; ice: 0.98.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Walk speed'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0.1" Maximum="5" SmallChange="0.1"
                                          Value="{Binding SpeedFactor, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Jump height'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0.1" Maximum="5" SmallChange="0.1"
                                          Value="{Binding JumpFactor, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Multipliers: 1 normal; soul sand: 0.4; honey block: 0.5.'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Harvesting'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Effective tool'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding HarvestToolChoices}" SelectedValue="{Binding HarvestTool}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Tool level'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding ToolTierChoices}" SelectedValue="{Binding ToolTier}" />
                        </WrapPanel>
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Drops nothing without the right tool (like stone without a pickaxe)'}" Margin="0,4,0,12"
                                  IsChecked="{Binding RequiresCorrectTool}" />

                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Drops'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding DropKindChoices}" SelectedValue="{Binding DropKind}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding IsDropOtherItem, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Dropped item'}" />
                                <ContentControl Style="{StaticResource RowPicker}" Content="{Binding DropItemPicker}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="{l:Tr 'Item from the project (&quot;ruby&quot;) or from Minecraft (&quot;diamond&quot;, &quot;minecraft:coal&quot;).'}" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Quantity (min - max)'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="1" Maximum="{Binding MaxDropCount}" SmallChange="1"
                                              Value="{Binding DropMin, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="1" Maximum="{Binding MaxDropCount}" SmallChange="1"
                                              Value="{Binding DropMax, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                        </StackPanel>

                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Experience (min - max)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="0" Maximum="{Binding MaxExperience}" SmallChange="1"
                                          Value="{Binding ExperienceMin, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="0" Maximum="{Binding MaxExperience}" SmallChange="1"
                                          Value="{Binding ExperienceMax, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Experience points gained when breaking the block (diamond ore: 3 to 7).'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Item'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'The block also exists as an item in the inventory'}" FontWeight="SemiBold" Margin="0,0,0,8"
                                  IsChecked="{Binding HasItemForm}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryFields}" Focusable="False"
                                        IsEnabled="{Binding HasItemForm}" />
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Item texture'}" Margin="0,12,0,4" />
                        <ContentControl Content="{Binding ItemTextureSlot}" Focusable="False" IsEnabled="{Binding HasItemForm}" />
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'Optional: a flat texture for the block in the inventory and in hand (like a door). Empty: the block itself.'}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="{l:Tr 'Advanced'}">
                    <StackPanel Style="{StaticResource TabContent}" DataContext="{Binding Options}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Rotation and water'}" Margin="0,0,0,4" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Rotation'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Source={x:Static assets:BlockOptionsViewModel.Rotations}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Rotation}" />
                        </WrapPanel>
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Can also be placed on the floor and the ceiling (like a button)'}"
                                  IsChecked="{Binding HasPitchRotation}" IsEnabled="{Binding CanHavePitch}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Can hold water (waterloggable, like a slab)'}" IsChecked="{Binding Waterloggable}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Falls like sand (gravity)'}" IsChecked="{Binding HasGravity}" />

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Rendering and physics'}" Margin="0,12,0,4" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Glows in the dark (emissive rendering)'}" IsChecked="{Binding Emissive}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Hides the faces between two blocks of this type (connected sides, like glass)'}"
                                  IsChecked="{Binding ConnectedSides}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Replaceable (another block can be placed instead, like tall grass)'}"
                                  IsChecked="{Binding Replaceable}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Entities can walk through it (no collision)'}" IsChecked="{Binding WalkThrough}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Custom light opacity'}" IsChecked="{Binding CustomLightOpacity}" />
                        <WrapPanel Style="{StaticResource Row}" IsEnabled="{Binding CustomLightOpacity}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Light opacity'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="15" SmallChange="1"
                                          Value="{Binding LightOpacity, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Light stopped by the block: 0 lets every light through (glass), 15 stops it (stone).'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Random model offset'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Source={x:Static assets:BlockOptionsViewModel.Offsets}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RandomOffset}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Color on the map'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding MapColors}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MapColor}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Note block instrument'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Instruments}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Instrument}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Reaction to pistons'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Source={x:Static assets:BlockOptionsViewModel.PushReactions}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PushReaction}" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Special behaviors'}" Margin="0,12,0,4" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Acts like a ladder (entities climb it)'}" IsChecked="{Binding Ladder}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Plants can grow on it (saplings, flowers)'}" IsChecked="{Binding PlantsCanSustain}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Enchanting power bonus'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="15" SmallChange="0.5"
                                          Value="{Binding EnchantPowerBonus, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Given to a nearby enchanting table (a bookshelf gives 1).'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Beacon beam color'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding BeaconColors}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BeaconColor}" />
                        </WrapPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Redstone and fire'}">
                    <StackPanel Style="{StaticResource TabContent}" DataContext="{Binding Options}">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Redstone'}" Margin="0,0,0,4" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'The redstone dust connects to this block'}" IsChecked="{Binding RedstoneConnects}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Emits redstone power (like a redstone block)'}" IsChecked="{Binding EmitsRedstone}" />
                        <WrapPanel Style="{StaticResource Row}" IsEnabled="{Binding EmitsRedstone}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Redstone power'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="15" SmallChange="1"
                                          Value="{Binding RedstonePower, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Fire'}" Margin="0,12,0,4" />
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Can be ignited by lava'}" IsChecked="{Binding IgnitedByLava}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Flammability'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="300" SmallChange="5"
                                          Value="{Binding Flammability, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Fire spreading speed'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="300" SmallChange="5"
                                          Value="{Binding FireSpreadSpeed, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Wool: 60 and 30; planks: 20 and 5; 0: does not burn.'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Shape'}">
                    <StackPanel Style="{StaticResource TabContent}" DataContext="{Binding Options}">
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{l:Tr 'Boxes in pixels (0 to 16) for the collisions and the outline of the block; a subtracted box makes a hole. Without box: the full block. A block that turns uses the boxes drawn for the north.'}" />
                        <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{l:Tr 'Add a box'}" Command="{Binding AddBoxCommand}" />
                        <ItemsControl ItemsSource="{Binding Boxes}" Focusable="False" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type assets:BlockBoxViewModel}">
                                    <WrapPanel Margin="0,2">
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.ChevronUp}" Command="{Binding UpCommand}" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.ChevronDown}" Command="{Binding DownCommand}" />
                                        <TextBlock Text="{l:Tr 'From'}" VerticalAlignment="Center" Margin="4,0" />
                                        <ui:NumberBox Width="62" Value="{Binding MinX, UpdateSourceTrigger=PropertyChanged}" ToolTip="X" />
                                        <ui:NumberBox Width="62" Value="{Binding MinY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y" />
                                        <ui:NumberBox Width="62" Value="{Binding MinZ, UpdateSourceTrigger=PropertyChanged}" ToolTip="Z" />
                                        <TextBlock Text="{l:Tr 'To'}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                        <ui:NumberBox Width="62" Value="{Binding MaxX, UpdateSourceTrigger=PropertyChanged}" ToolTip="X" />
                                        <ui:NumberBox Width="62" Value="{Binding MaxY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y" />
                                        <ui:NumberBox Width="62" Value="{Binding MaxZ, UpdateSourceTrigger=PropertyChanged}" ToolTip="Z" />
                                        <CheckBox Content="{l:Tr 'Subtract'}" Margin="8,0" MinWidth="0" IsChecked="{Binding Subtract}" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Command="{Binding RemoveCommand}"
                                                ToolTip="{l:Tr 'Remove this box'}" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'States'}">
                    <StackPanel Style="{StaticResource TabContent}" DataContext="{Binding Options}">
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{l:Tr 'Properties of the block state (lit, age, color...): the graphs read and change them with the State property nodes, by name. Every combination of values is a state of the block: keep their number small.'}" />
                        <WrapPanel>
                            <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Add a property'}" Command="{Binding AddPropertyCommand}" />
                            <TextBlock x:Name="Combinations" Text="{Binding CombinationsLabel}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Properties}" Focusable="False" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type assets:BlockPropertyViewModel}">
                                    <WrapPanel Margin="0,2">
                                        <TextBox Width="130" Text="{Binding Name}" FontFamily="Consolas" ToolTip="{l:Tr 'Name (lowercase letters, digits and _)'}" />
                                        <ComboBox Width="150" Margin="6,0" ItemsSource="{Binding KindChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Kind}" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsInteger, Converter={StaticResource BoolToVisibility}}">
                                            <ui:NumberBox Width="70" Minimum="0" Maximum="255" Value="{Binding Min, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr 'Minimum'}" />
                                            <ui:NumberBox Width="70" Margin="4,0" Minimum="1" Maximum="256" Value="{Binding Max, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr 'Maximum'}" />
                                        </StackPanel>
                                        <TextBox Width="200" Text="{Binding Values}" FontFamily="Consolas" ToolTip="{l:Tr 'Values, separated by commas (red, green, blue)'}"
                                                 Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Command="{Binding RemoveCommand}"
                                                ToolTip="{l:Tr 'Remove this property'}" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Ore'}">
                    <StackPanel Style="{StaticResource TabContent}" DataContext="{Binding Options}">
                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Content="{l:Tr 'Generate the block as an ore in the world'}"
                                  IsChecked="{Binding OreEnabled}" Margin="0,0,0,8" />
                        <StackPanel IsEnabled="{Binding OreEnabled}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Blocks it replaces'}" />
                                <TextBox Width="320" Text="{Binding OreReplace}" FontFamily="Consolas" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Blocks or tags, separated by commas: #minecraft:stone_ore_replaceables, #minecraft:deepslate_ore_replaceables, minecraft:netherrack...'}" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Biomes'}" />
                                <TextBox Width="320" Text="{Binding OreBiomes}" FontFamily="Consolas" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Empty: every biome of the overworld. A tag (#minecraft:is_nether) or biomes separated by commas (minecraft:desert, minecraft:badlands).'}" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Shape of the heights'}" />
                                <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Source={x:Static assets:BlockOptionsViewModel.OreShapes}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OreShape}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Groups per chunk'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="64" SmallChange="1"
                                              Value="{Binding OreGroups, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Ores per group'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="64" SmallChange="1"
                                              Value="{Binding OreSize, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'More than 32 may make the generation of the world crash.'}" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Heights (min - max)'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="-64" Maximum="320" SmallChange="1"
                                              Value="{Binding OreMinHeight, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="-64" Maximum="320" SmallChange="1"
                                              Value="{Binding OreMaxHeight, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Diamonds: -64 to 16 (triangle); iron: -24 to 56; coal: 0 to 192.'}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Plant (V0.7.0) ===================== -->
    <DataTemplate DataType="{x:Type assets:PlantAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <TabControl Style="{StaticResource UnderlineTabControl}" HorizontalContentAlignment="{DynamicResource AssetTabsAlignment}">
                <TabItem Header="{l:Tr 'Plant'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Kind'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Source={x:Static assets:PlantAssetViewModel.Kinds}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}" Visibility="{Binding HasSoilChoice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Placed on'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding Source={x:Static assets:PlantAssetViewModel.Soils}}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Soil}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}" Visibility="{Binding IsGrowing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Maximum height'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="16" SmallChange="1"
                                          Value="{Binding MaxHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Light level'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="15" SmallChange="1"
                                          Value="{Binding LightLevel, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Sounds'}" />
                            <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding SoundChoices}" SelectedValue="{Binding Sound}" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Textures'}" Margin="0,12,0,4" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding MainTextureHint}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <ContentControl Content="{Binding MainTexture}" ContentTemplate="{StaticResource TextureTile}" Focusable="False" />
                            <ContentControl Content="{Binding TopTexture}" ContentTemplate="{StaticResource TextureTile}" Focusable="False"
                                            Visibility="{Binding IsTall, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding IsCrop, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Growth stages'}" Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding Stages}" ItemTemplate="{StaticResource TextureTile}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Add a stage'}" Command="{Binding AddStageCommand}" />
                                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Remove the last stage'}" Command="{Binding RemoveStageCommand}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                       Text="{l:Tr 'From the seed to the ripe plant (up to 8, like wheat); the last one is the ripe crop.'}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Crop'}" Visibility="{Binding IsCrop, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Produce'}" />
                            <ContentControl Style="{StaticResource RowPicker}" Content="{Binding ProducePicker}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Quantity (min - max)'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="1" Maximum="64" SmallChange="1"
                                          Value="{Binding ProduceMin, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="1" Maximum="64" SmallChange="1"
                                          Value="{Binding ProduceMax, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'A ripe crop drops its produce (wheat) and 1 to 3 seeds; a young one only its seed. The item of the crop is its seeds.'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Generation'}" Visibility="{Binding CanGenerate, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Content="{l:Tr 'Generate patches of the plant in the world'}"
                                  IsChecked="{Binding GenerationEnabled}" Margin="0,0,0,8" />
                        <StackPanel IsEnabled="{Binding GenerationEnabled}">
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Biomes'}" />
                                <TextBox Width="320" FontFamily="Consolas" Text="{Binding GenerationBiomes}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                       Text="{l:Tr 'Empty: every biome of the overworld. A tag (#minecraft:is_forest) or biomes separated by commas (minecraft:plains, mymod:my_biome).'}" />
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'One patch every (chunks)'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="256" SmallChange="1"
                                              Value="{Binding GenerationRarity, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Plants tried per patch'}" />
                                <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="256" SmallChange="4"
                                              Value="{Binding GenerationPatchSize, UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Flowers of the plains: one patch every 32 chunks, 64 tries; sugar cane: every 6 chunks, 20 tries.'}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Item'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InventoryFields}" Focusable="False" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Biome (V0.7.0) ===================== -->
    <DataTemplate DataType="{x:Type assets:BiomeAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <TabControl Style="{StaticResource UnderlineTabControl}" HorizontalContentAlignment="{DynamicResource AssetTabsAlignment}">
                <TabItem Header="{l:Tr 'Biome'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Based on'}" />
                            <ComboBox Style="{StaticResource RowCombo}" IsEditable="True" ItemsSource="{Binding BaseBiomes}"
                                      Text="{Binding BaseBiome, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'The biome keeps the trees, flowers, ores, caves and mobs of this biome of Minecraft.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Temperature'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="-2" Maximum="2" SmallChange="0.05"
                                          Value="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Snow below 0.15; plains: 0.8; desert: 2.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Downfall'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="1" SmallChange="0.05"
                                          Value="{Binding Downfall, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Rain or snow falls in the biome'}" IsChecked="{Binding HasPrecipitation}" />

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Surface'}" Margin="0,12,0,4" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Surface block'}" />
                            <TextBox Width="240" FontFamily="Consolas" Text="{Binding TopBlock}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Under the surface'}" />
                            <TextBox Width="240" FontFamily="Consolas" Text="{Binding UnderBlock}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'Blocks of the mod or of Minecraft (minecraft:podzol, mymod:moss); empty: those of the overworld (grass, dirt).'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Colors'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Sky'}" />
                            <TextBox Width="120" FontFamily="Consolas" Text="{Binding SkyColor}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Fog'}" />
                            <TextBox Width="120" FontFamily="Consolas" Text="{Binding FogColor}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Water'}" />
                            <TextBox Width="120" FontFamily="Consolas" Text="{Binding WaterColor}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Fog under water'}" />
                            <TextBox Width="120" FontFamily="Consolas" Text="{Binding WaterFogColor}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Grass'}" />
                            <TextBox Width="120" FontFamily="Consolas" Text="{Binding GrassColor}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Leaves'}" />
                            <TextBox Width="120" FontFamily="Consolas" Text="{Binding FoliageColor}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'Colors #RRGGBB. Grass and leaves: empty to compute them from the temperature and the downfall.'}" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{l:Tr 'Placement'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <CheckBox Style="{StaticResource WrapCheck}" FontWeight="SemiBold" Content="{l:Tr 'Appears in the overworld'}"
                                  IsChecked="{Binding GeneratesInOverworld}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{l:Tr 'The biome appears where the climate of the world is close to these values (center and spread, from -1 to 1), next to the biomes of Minecraft.'}" />
                        <ItemsControl ItemsSource="{Binding Climate}" Focusable="False" IsEnabled="{Binding GeneratesInOverworld}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type assets:ClimateRangeViewModel}">
                                    <WrapPanel Style="{StaticResource Row}" ToolTip="{Binding Hint}">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Label}" />
                                        <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="-1" Maximum="1" SmallChange="0.05"
                                                      Value="{Binding Center, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:NumberBox Style="{StaticResource RowNumber}" Width="130" Minimum="0" Maximum="1" SmallChange="0.05"
                                                      Value="{Binding Spread, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding Hint}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource HintBrush}" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Texture ===================== -->
    <DataTemplate DataType="{x:Type assets:TextureAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <Border Width="128" Height="128" HorizontalAlignment="Left" BorderThickness="1" Margin="0,4,0,8"
                    BorderBrush="{DynamicResource PreviewBorderBrush}" Background="{DynamicResource PreviewBackgroundBrush}">
                <Image Source="{Binding FullPath, Converter={StaticResource FilePathToImage}}"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" Margin="6" />
            </Border>
            <WrapPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Size'}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding SizeLabel}" />
            </WrapPanel>
            <WrapPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'File'}" />
                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Text="{Binding FilePath}" />
            </WrapPanel>
            <WrapPanel Margin="0,4">
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Replace the image...'}" Command="{Binding ReplaceCommand}" />
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Open the image'}" Command="{Binding OpenFileCommand}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                       Text="{l:Tr 'Items, blocks and mobs refer to this texture by its internal identifier: you can rename it without breaking anything.'}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Son ===================== -->
    <DataTemplate DataType="{x:Type assets:SoundAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <WrapPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'File'}" />
                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Text="{Binding FilePath}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource RowHint}" Foreground="{DynamicResource LogWarningBrush}" Text="{l:Tr 'File not found.'}"
                       Visibility="{Binding IsFileMissing, Converter={StaticResource BoolToVisibility}}" />
            <WrapPanel Margin="0,4">
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Listen'}" Command="{Binding OpenFileCommand}"
                        ToolTip="{l:Tr 'Opens the sound with the Windows player'}" />
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Replace the sound...'}" Command="{Binding ReplaceCommand}" />
            </WrapPanel>
            <StackPanel Style="{StaticResource FieldRow}">
                <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Subtitle'}" />
                <TextBox Style="{StaticResource FieldBox}" Margin="0" Text="{Binding Subtitle, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Shown when the game\'s subtitles are enabled; leave empty for none.'}" />
            <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Test in game'}" Margin="0,8,0,2" />
            <TextBox IsReadOnly="True" FontFamily="Consolas" Text="{Binding PlaySoundCommand, Mode=OneWay}" />
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                       Text="{l:Tr 'OGG Vorbis format, preferably mono (a stereo sound is not positioned by Minecraft).'}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================== 3D model ===================== -->
    <DataTemplate DataType="{x:Type assets:ModelAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <WrapPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Format'}" />
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding FormatLabel}" />
            </WrapPanel>
            <WrapPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'File'}" />
                <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Text="{Binding FilePath}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource RowHint}" Foreground="{DynamicResource LogWarningBrush}" Text="{l:Tr 'File not found.'}"
                       Visibility="{Binding IsFileMissing, Converter={StaticResource BoolToVisibility}}" />
            <WrapPanel Margin="0,4">
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Open'}" Command="{Binding OpenFileCommand}"
                        ToolTip="{l:Tr 'Opens the model with the Windows application (or use Open with in the Explorer)'}" />
                <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Replace the model...'}" Command="{Binding ReplaceCommand}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource RowHint}" Text="{Binding Summary}" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Visibility="{Binding IsUsedByTheGame, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{l:Tr 'Choose this model in the Visual tab of an item, or as the shape of a block or the model of a mob (Blockbench only).'}" />

                <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Textures of the model'}" Margin="0,12,0,2" />
                <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                           Text="{l:Tr 'Each texture of the file keeps its image unless a texture of the project is bound to it.'}" />
                <ItemsControl ItemsSource="{Binding TextureSlots}" Focusable="False" />

                <StackPanel Visibility="{Binding CanBeEntityModel, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Variants (mobs)'}" Margin="0,12,0,2" />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Text="{l:Tr 'Other textures for the whole model: each mob takes the first texture or one of the variants at random, and keeps it.'}" />
                    <ItemsControl ItemsSource="{Binding Variants}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="{l:Tr 'Remove'}" VerticalAlignment="Top"
                                            Margin="6,4,0,0" Command="{Binding RemoveCommand}" />
                                    <ContentControl Content="{Binding Texture}" Focusable="False" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{l:Tr 'Add a variant'}" Command="{Binding AddVariantCommand}" />

                    <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Layers (mobs)'}" Margin="0,12,0,2" />
                    <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                               Text="{l:Tr 'Drawn over the model with the same UVs (a collar, a saddle). An emissive layer glows in the dark, like the eyes of a spider.'}" />
                    <ItemsControl ItemsSource="{Binding Layers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="{l:Tr 'Remove'}" VerticalAlignment="Top"
                                                Margin="6,4,0,0" Command="{Binding RemoveCommand}" />
                                        <ContentControl Content="{Binding Texture}" Focusable="False" />
                                    </DockPanel>
                                    <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Emissive (glows in the dark)'}" IsChecked="{Binding Emissive}" Margin="68,0,0,6" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{l:Tr 'Add a layer'}" Command="{Binding AddLayerCommand}" />
                </StackPanel>

                <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Reference in the mod'}" Margin="0,12,0,2" />
                <TextBox IsReadOnly="True" FontFamily="Consolas" Text="{Binding GameReference, Mode=OneWay}" />
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{l:Tr 'Written into the mod as models/custom, with its textures: it can also be the parent of a model written by hand.'}" />
            </StackPanel>
            <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsUsedByTheGame, Converter={StaticResource InverseBoolToVisibility}}"
                       Text="{l:Tr 'Kept in the project as a source file: the mod uses Blockbench projects (.bbmodel) and Java JSON models.'}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Commande (V0.6.2) ===================== -->
    <DataTemplate DataType="{x:Type assets:CommandAssetViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <views:SideBySidePanel FirstMinWidth="500" Gap="16" FillSecond="True" Margin="0,8,0,0">
                <!-- La commande et ses paramètres -->
                <Border Width="500" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="14" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{l:Tr 'Name without /'}" Width="150" VerticalAlignment="Center" />
                            <TextBox Text="{Binding CommandName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" FontFamily="Consolas"
                                     AutomationProperties.Name="{l:Tr 'Name without /'}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{l:Tr 'Who runs it'}" Width="150" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding SourceChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AnySource}"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Tr 'Who runs it'}"
                                      ToolTip="{l:Tr 'From a command block or the console, the player of the event is empty and the position is the one of the source.'}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{l:Tr 'Required level'}" Width="150" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding PermissionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PermissionLevel}"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Tr 'Required level'}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{l:Tr 'Message'}" Width="150" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Feedback, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Tr 'Message'}"
                                     ToolTip="{l:Tr 'Sent to the player once the command has run; empty for none.'}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Usage}" FontFamily="Consolas" Foreground="{DynamicResource LinkBrush}" Margin="0,2,0,10" TextWrapping="Wrap" />
                        <Border Height="2" Background="{DynamicResource PreviewBorderBrush}" Margin="0,0,0,10" />

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Parameters'}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type assets:CommandParameterViewModel}">
                                    <Border views:RowReorder.IsRow="True" Margin="0,2" Padding="6,5" CornerRadius="4" BorderThickness="1"
                                            Background="{DynamicResource HubBackgroundBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" views:RowReorder.IsHandle="True" Text="⠿" FontSize="16" Cursor="SizeAll" Width="20"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource HintBrush}" Background="Transparent"
                                                           ToolTip="{l:Tr 'Drag to move the parameter.'}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Order}" Width="20" VerticalAlignment="Center" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource ToolButton}" Width="30" MinWidth="0" Padding="0" Content="▲" Command="{Binding MoveUpCommand}" ToolTip="{l:Tr 'Move up'}" />
                                                    <Button Style="{StaticResource ToolButton}" Width="30" MinWidth="0" Padding="0" Content="▼" Command="{Binding MoveDownCommand}" ToolTip="{l:Tr 'Move down'}" />
                                                    <Button Style="{StaticResource ToolButton}" Width="30" MinWidth="0" Padding="0" Content="✕" Command="{Binding RemoveCommand}" ToolTip="{l:Tr 'Remove'}"
                                                            AutomationProperties.Name="{l:Tr 'Remove'}" />
                                                </StackPanel>
                                                <ComboBox DockPanel.Dock="Right" Width="190" Margin="6,0" ItemsSource="{x:Static assets:CommandParameterViewModel.KindChoices}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind}"
                                                          AutomationProperties.Name="{l:Tr 'Kind of the parameter'}" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" VerticalAlignment="Center"
                                                         AutomationProperties.Name="{l:Tr 'Name of the parameter'}" />
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="40,4,0,0" Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{l:Tr 'Minimum'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ui:NumberBox Width="110" Value="{Binding Minimum, UpdateSourceTrigger=LostFocus}" SpinButtonPlacementMode="Compact" />
                                                <TextBlock Text="{l:Tr 'Maximum'}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                                <ui:NumberBox Width="110" Value="{Binding Maximum, UpdateSourceTrigger=LostFocus}" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource FieldHint}" Margin="40,3,0,0" Text="{Binding Example}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4" Text="{l:Tr 'No parameter: the command is typed alone.'}"
                                   Visibility="{Binding HasParameters, Converter={StaticResource InverseBoolToVisibility}}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Add a parameter'}" Command="{Binding AddParameterCommand}" />
                            <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Add the event to the graph'}" Command="{Binding AddEventCommand}"
                                    ToolTip="{l:Tr 'Adds the event On command of this command to the graph beside: it gives the value of each parameter.'}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding GraphsLabel}" />
                    </StackPanel>
                </Border>

                <!-- Le graphe des événements de la commande -->
                <ContentControl Content="{Binding EventGraph}" MinWidth="420" Focusable="False" />
            </views:SideBySidePanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Onglet créatif (V0.6.2) ===================== -->
    <!-- Image d'un item : le haut d'une texture animée (bande verticale), en pixels nets. -->
    <Style x:Key="ItemIconImage" TargetType="Image">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
    </Style>

    <!-- Fonds de l'inventaire créatif (195 × 136 pixels utiles), embarqués dans l'éditeur -->
    <CroppedBitmap x:Key="CreativeItemsBackground" SourceRect="0,0,195,136"
                   Source="/MineEngine.Editor;component/Themes/CreativeInventory/tab_items.png" />
    <CroppedBitmap x:Key="CreativeSearchBackground" SourceRect="0,0,195,136"
                   Source="/MineEngine.Editor;component/Themes/CreativeInventory/tab_item_search.png" />

    <DataTemplate DataType="{x:Type assets:CreativeTabAssetViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <StackPanel Style="{StaticResource TabContent}">
                <views:SideBySidePanel FirstMinWidth="600" Gap="20">
                    <!-- Propriétés et contenu de l'onglet -->
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'The name of the element is the title of the tab.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Icon'}" />
                            <ContentControl Style="{StaticResource RowPicker}" Content="{Binding Icon}" />
                        </WrapPanel>
                        <CheckBox Style="{StaticResource WrapCheck}" Content="{l:Tr 'Has a search bar'}" Margin="0,4"
                                  IsChecked="{Binding HasSearchBar}" ToolTip="{l:Tr 'A search field above the items, like the Search tab of the game.'}" />

                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Contains'}" Margin="0,12,0,4" />
                        <Border BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1" Background="{DynamicResource PreviewBackgroundBrush}" Padding="4">
                            <StackPanel>
                                <!-- En-têtes des colonnes -->
                                <Grid Margin="4,0,4,4" TextElement.Foreground="{DynamicResource HintBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="#" />
                                    <TextBlock Grid.Column="2" Text="{l:Tr 'Name'}" />
                                    <TextBlock Grid.Column="3" Text="{l:Tr 'Identifier'}" />
                                    <TextBlock Grid.Column="4" Text="{l:Tr 'Type'}" />
                                    <TextBlock Grid.Column="5" Text="{l:Tr 'Icon'}" />
                                    <!-- Réserve la place des boutons des lignes -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Visibility="Hidden">
                                        <Button Style="{StaticResource ToolButton}" Width="30" MinWidth="0" Padding="0" Content="▲" />
                                        <Button Style="{StaticResource ToolButton}" Width="30" MinWidth="0" Padding="0" Content="▼" />
                                        <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Remove'}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border views:RowReorder.IsRow="True" Margin="0,1" Padding="4,2" Background="{DynamicResource HubBackgroundBrush}"
                                                    BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" views:RowReorder.IsHandle="True" Text="⠿" FontSize="16" Cursor="SizeAll"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource HintBrush}" Background="Transparent"
                                                               ToolTip="{l:Tr 'Drag to move the item in the tab.'}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Order}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                                    <ContentControl Grid.Column="3" Content="{Binding Picker}" Focusable="False" HorizontalContentAlignment="Stretch" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="4" Text="{Binding TypeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource HintBrush}" />
                                                    <Grid Grid.Column="5" Width="24" Height="24" ClipToBounds="True" HorizontalAlignment="Left"
                                                          ToolTip="{l:Tr 'Image of the texture of the item, or of Minecraft; ? when there is none.'}">
                                                        <Image Style="{StaticResource ItemIconImage}" Source="{Binding IconPath, Converter={StaticResource FilePathToImage}}" />
                                                        <TextBlock Text="?" Foreground="{DynamicResource HintBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding ShowsPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                                                        <Button Style="{StaticResource ToolButton}" Width="30" MinWidth="0" Padding="0" Content="▲" Command="{Binding MoveUpCommand}" ToolTip="{l:Tr 'Move up'}" />
                                                        <Button Style="{StaticResource ToolButton}" Width="30" MinWidth="0" Padding="0" Content="▼" Command="{Binding MoveDownCommand}" ToolTip="{l:Tr 'Move down'}" />
                                                        <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Remove'}" Command="{Binding RemoveCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="4,6" Text="{l:Tr 'The tab is empty: add items to it.'}"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,6">
                            <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Add an item'}" Command="{Binding AddItemCommand}" />
                            <Button Style="{StaticResource ToolButton}" Content="{l:Tr 'Add all the items of the mod'}" Command="{Binding AddAllModItemsCommand}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="{l:Tr 'Items of the mod or of Minecraft (minecraft:diamond), in this order. The mod also keeps its own tab with all its items.'}" />
                    </StackPanel>

                    <!-- Aperçu de l'onglet dans l'inventaire créatif -->
                    <StackPanel Width="392" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Preview'}" Margin="0,0,0,4" />
                        <!-- Inventaire créatif à l'échelle 2 (unités : pixels de la texture) : fond embarqué, onglets et poignée dessinés -->
                        <Canvas Width="195" Height="164" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True">
                            <Canvas.LayoutTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2" />
                            </Canvas.LayoutTransform>
                            <!-- Onglets non sélectionnés, derrière le fond -->
                            <Border Canvas.Left="27" Canvas.Top="2" Width="26" Height="28" Background="#8B8B8B" BorderBrush="#000000" BorderThickness="1,1,1,0">
                                <Border BorderBrush="#A8A8A8" BorderThickness="1,1,0,0" />
                            </Border>
                            <Border Canvas.Left="54" Canvas.Top="2" Width="26" Height="28" Background="#8B8B8B" BorderBrush="#000000" BorderThickness="1,1,1,0">
                                <Border BorderBrush="#A8A8A8" BorderThickness="1,1,0,0" />
                            </Border>
                            <Image Canvas.Left="0" Canvas.Top="28" Width="195" Height="136" Stretch="None">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="{StaticResource CreativeItemsBackground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSearchBar}" Value="True">
                                                <Setter Property="Source" Value="{StaticResource CreativeSearchBackground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- Onglet de l'élément, sélectionné : il se fond dans le panneau -->
                            <Border Canvas.Left="0" Canvas.Top="0" Width="26" Height="32" Background="#C6C6C6" BorderBrush="#000000" BorderThickness="1,1,1,0" ToolTip="{Binding PreviewTitle}">
                                <Grid>
                                    <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0" Margin="0,0,1,0" />
                                    <Border BorderBrush="#555555" BorderThickness="0,0,1,0" />
                                    <Border Width="16" Height="16" Margin="0,8,0,0" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
                                        <Image Style="{StaticResource ItemIconImage}" Source="{Binding TabIconPath, Converter={StaticResource FilePathToImage}}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Canvas.Left="8" Canvas.Top="33" Text="{Binding PreviewTitle}" Foreground="#404040" FontSize="8" MaxWidth="70" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer Canvas.Left="9" Canvas.Top="46" Width="162" Height="90" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="18" ItemHeight="18" Width="162" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True"
                                                  Background="Transparent" ToolTip="{Binding Name}">
                                                <Image Style="{StaticResource ItemIconImage}" Source="{Binding IconPath, Converter={StaticResource FilePathToImage}}" />
                                                <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="#404040" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding ShowsPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- Poignée de la barre de défilement -->
                            <Border Canvas.Left="175" Canvas.Top="46" Width="12" Height="15" Background="#C6C6C6" BorderBrush="#000000" BorderThickness="1">
                                <Grid>
                                    <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0" />
                                    <Border BorderBrush="#555555" BorderThickness="0,0,1,1" />
                                </Grid>
                            </Border>
                        </Canvas>

                        <!-- Zone de dépôt des éléments : prévue pour une prochaine version -->
                        <Grid Margin="0,12,0,0" Height="150">
                            <Rectangle Stroke="{DynamicResource PreviewBorderBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="4" RadiusY="4" />
                            <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                       Text="{l:Tr 'Drag and drop elements here: coming in a later version.'}" />
                        </Grid>
                    </StackPanel>
                </views:SideBySidePanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Graphe d'événements d'un élément (touche, commande), édité dans son éditeur -->
    <DataTemplate DataType="{x:Type assets:OwnedEventGraph}">
        <Border MinWidth="420" Height="760" VerticalAlignment="Top" CornerRadius="6" BorderThickness="1" ClipToBounds="True"
                Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}">
            <Grid>
                <DockPanel Visibility="{Binding HasGraph, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="10,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="{l:Tr 'Show in the Dashboard'}" Command="{Binding ShowCommand}" />
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding Graph.FileName}" VerticalAlignment="Center" />
                    </DockPanel>
                    <graphs:GraphDocumentView DataContext="{Binding Graph}" />
                </DockPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding HasGraph, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldHint}" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
                               Text="{l:Tr 'The events of this element go in its graph, edited here.'}" />
                    <Button Style="{DynamicResource AccentButtonStyle}" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,6" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ===================== Touche (V0.6.2) ===================== -->
    <!-- Bouton qui lit la prochaine touche du clavier ou bouton de la souris (comme Unreal). -->
    <Style x:Key="KeyCapture" TargetType="views:KeyCaptureButton">
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:KeyCaptureButton">
                    <Border x:Name="Frame" Background="#7A2323" BorderBrush="#A33A3A" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label" Text="{l:Tr 'Press to choose'}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#8E2B2B" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentLineBrush}" />
                            <Setter TargetName="Label" Property="Text" Value="{l:Tr 'Press a key or a button...'}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip" Value="{l:Tr 'Click, then press the key of the keyboard or the button of the mouse to use (Escape: cancel).'}" />
    </Style>

    <DataTemplate DataType="{x:Type assets:KeybindAssetViewModel}">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <views:SideBySidePanel FirstMinWidth="430" Gap="16" FillSecond="True" Margin="0,8,0,0">
                <!-- La touche et ses déclencheurs -->
                <Border Width="430" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="14" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{l:Tr 'Key of the keybind'}" Width="70" VerticalAlignment="Center" FontSize="15" />
                            <views:KeyCaptureButton DockPanel.Dock="Right" Style="{StaticResource KeyCapture}" KeyName="{Binding DefaultKey}"
                                                    AutomationProperties.Name="{l:Tr 'Press to choose'}" />
                            <ComboBox ItemsSource="{Binding KeyChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultKey}"
                                      HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Tr 'Default key'}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="{l:Tr 'Name'}" Width="70" VerticalAlignment="Center" FontSize="15" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr 'Name'}"
                                     ToolTip="{l:Tr 'Name of the key in Options > Controls.'}" />
                        </DockPanel>
                        <Border Height="2" Background="{DynamicResource PreviewBorderBrush}" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{l:Tr 'Triggers'}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Triggers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type assets:KeyTriggerViewModel}">
                                    <Border Margin="0,3" Padding="10,8" CornerRadius="4" BorderThickness="1"
                                            Background="{DynamicResource HubBackgroundBrush}" BorderBrush="{DynamicResource PreviewBorderBrush}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="{l:Tr 'Add to the graph'}" Command="{Binding AddCommand}"
                                                        ToolTip="{l:Tr 'Adds this event of the key to the graph beside.'}" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding UsageLabel}" FontSize="11" Margin="0,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUsed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource FieldHint}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <!-- Réglage du déclencheur, porté par la touche -->
                                            <DockPanel Margin="0,6,0,0" Visibility="{Binding UsesHoldTime, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{l:Tr 'Hold time (seconds)'}" Width="215" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <ui:NumberBox Minimum="{Binding DataContext.MinSeconds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              Maximum="{Binding DataContext.MaxSeconds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SmallChange="0.05" SpinButtonPlacementMode="Inline"
                                                              Value="{Binding DataContext.HoldSeconds, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0" Visibility="{Binding UsesPulse, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{l:Tr 'Pulse interval (seconds)'}" Width="215" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <ui:NumberBox Minimum="{Binding DataContext.MinSeconds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              Maximum="{Binding DataContext.MaxSeconds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SmallChange="0.05" SpinButtonPlacementMode="Inline"
                                                              Value="{Binding DataContext.PulseSeconds, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0" Visibility="{Binding UsesCombo, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{l:Tr 'Combo key'}" Width="100" VerticalAlignment="Center" />
                                                <views:KeyCaptureButton DockPanel.Dock="Right" Style="{StaticResource KeyCapture}" MinWidth="110"
                                                                        KeyName="{Binding DataContext.ComboKey, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        AutomationProperties.Name="{l:Tr 'Combo key'}" />
                                                <ComboBox ItemsSource="{Binding DataContext.KeyChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding DataContext.ComboKey, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Tr 'Combo key'}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="{l:Tr 'Players can change the key in Options > Controls, where it is listed with the name of the element under the name of the mod. Its events run on the server.'}" />
                    </StackPanel>
                </Border>

                <!-- Le graphe des événements de la touche -->
                <ContentControl Content="{Binding EventGraph}" MinWidth="420" Focusable="False" />
            </views:SideBySidePanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Enchantement (V0.6.3) ===================== -->
    <DataTemplate DataType="{x:Type assets:EnchantmentAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <StackPanel Style="{StaticResource TabContent}">
                <WrapPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Enchanted items'}" />
                    <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding TargetChoices}" SelectedValue="{Binding Target}" />
                </WrapPanel>
                <WrapPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Rarity'}" />
                    <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding RarityChoices}" SelectedValue="{Binding Rarity}" />
                </WrapPanel>
                <WrapPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Maximum level'}" />
                    <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="{Binding MaxLevelLimit}" SmallChange="1"
                                  Value="{Binding MaxLevel, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>
                <WrapPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Damage bonus per level'}" />
                    <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="100" SmallChange="0.5"
                                  Value="{Binding DamageBonus, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Extra damage of a weapon at each level (Sharpness: about 1). 0 for none.'}" />
                <CheckBox Style="{StaticResource WrapCheck}" Margin="0,4" IsChecked="{Binding Treasure}"
                          Content="{l:Tr 'Treasure: only in loot and trades, not on the enchanting table (like Mending)'}" />
                <CheckBox Style="{StaticResource WrapCheck}" Margin="0,4" IsChecked="{Binding Curse}"
                          Content="{l:Tr 'Curse: shown in red, cannot be removed with a grindstone'}" />
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{l:Tr 'Graphs read its level with the enchantment nodes, with the identifier of the mod (magicmod:frost_edge).'}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Fluide (V0.6.3) ===================== -->
    <DataTemplate DataType="{x:Type assets:FluidAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <TabControl Style="{StaticResource UnderlineTabControl}" HorizontalContentAlignment="{DynamicResource AssetTabsAlignment}">
                <TabItem Header="{l:Tr 'Appearance'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Color'}" />
                            <TextBox Width="120" FontFamily="Consolas" Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Tint of the water texture, #RRGGBB (water: #3F76E4). Not used with textures of your own.'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Light level'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="15" SmallChange="1" Value="{Binding LightLevel, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <ContentControl Content="{Binding StillTexture}" Focusable="False" />
                        <ContentControl Content="{Binding FlowingTexture}" Focusable="False" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="{l:Tr 'Flow'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Ticks between steps'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="100" SmallChange="1" Value="{Binding FlowSpeed, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Water: 5, lava: 30 (slower).'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Level lost per block'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="7" SmallChange="1" Value="{Binding LevelDecrease, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Water: 1 (flows 7 blocks), lava: 2 (flows 3 blocks).'}" />
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Slope search distance'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="1" Maximum="8" SmallChange="1" Value="{Binding SpreadDistance, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Density'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="-10000" Maximum="10000" SmallChange="100" Value="{Binding Density, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Viscosity'}" />
                            <ui:NumberBox Style="{StaticResource RowNumber}" Minimum="0" Maximum="100000" SmallChange="500" Value="{Binding Viscosity, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource RowHint}" Text="{l:Tr 'Water: 1000 and 1000; lava: 3000 and 6000.'}" />
                        <CheckBox Style="{StaticResource WrapCheck}" Margin="0,4" IsChecked="{Binding Infinite}"
                                  Content="{l:Tr 'Infinite: two sources make a new one, like water'}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="{l:Tr 'Bucket'}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <CheckBox Style="{StaticResource WrapCheck}" Margin="0,4" IsChecked="{Binding HasBucket}" Content="{l:Tr 'Has a bucket'}" />
                        <StackPanel Visibility="{Binding HasBucket, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource RowHint}" Text="{Binding BucketId, StringFormat={l:Tr 'Item of the bucket: {0}'}}" />
                            <ContentControl Content="{Binding BucketTexture}" Focusable="False" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Règle du jeu (V0.6.3) ===================== -->
    <DataTemplate DataType="{x:Type assets:GameRuleAssetViewModel}">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CommonAssetFields}" Focusable="False" />
            <StackPanel Style="{StaticResource TabContent}">
                <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Typed in the chat'}" />
                <TextBox IsReadOnly="True" FontFamily="Consolas" Text="{Binding Usage, Mode=OneWay}" Margin="0,2,0,8" />
                <WrapPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Value'}" />
                    <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding KindChoices}" SelectedValue="{Binding Kind}" />
                </WrapPanel>
                <CheckBox Style="{StaticResource WrapCheck}" Margin="0,4" IsChecked="{Binding DefaultBoolean}" Content="{l:Tr 'True by default'}"
                          Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" />
                <WrapPanel Style="{StaticResource Row}" Visibility="{Binding IsBoolean, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Default value'}" />
                    <ui:NumberBox Style="{StaticResource RowNumber}" SmallChange="1" Value="{Binding DefaultNumber, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>
                <WrapPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{l:Tr 'Category'}" />
                    <ComboBox Style="{StaticResource RowCombo}" ItemsSource="{Binding CategoryChoices}" SelectedValue="{Binding Category}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource StackedLabel}" Text="{l:Tr 'Description'}" Margin="0,8,0,2" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
