<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MineEngine.Editor.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVisible" />
    <conv:FilePathToImageConverter x:Key="FilePathToImage" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible" />

    <!-- Les couleurs (PanelHeaderBrush, HintBrush...) viennent de la palette du thème : Themes/*Palette.xaml. -->

    <!--
        Cadres de groupe : le modèle classique de WPF dessine un double liseré blanc,
        très visible en thème sombre. Ce modèle simple suit les couleurs du thème.
    -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="10,8,10,0"
                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="11"
                                              TextElement.Foreground="{DynamicResource HintBrush}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PanelHeaderBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,12,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!--
        Les styles nommés dérivent du style du thème (BasedOn) : sans cela, le contrôle
        reprendrait l'apparence classique de WPF et resterait clair en mode sombre.
        Champ de saisie : l'erreur de validation s'affiche en info-bulle.
    -->
    <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="3,2" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)/ErrorContent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinWidth" Value="70" />
    </Style>

</ResourceDictionary>
