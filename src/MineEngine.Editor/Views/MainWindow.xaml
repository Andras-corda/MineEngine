<Window x:Class="MineEngine.Editor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:panels="clr-namespace:MineEngine.Editor.Views.Panels"
        xmlns:conv="clr-namespace:MineEngine.Editor.Converters"
        xmlns:hubviews="clr-namespace:MineEngine.Editor.Views.Hub"
        xmlns:graphs="clr-namespace:MineEngine.Assets.Graphs;assembly=MineEngine.Assets"
        xmlns:java="clr-namespace:MineEngine.Minecraft.Java;assembly=MineEngine.Minecraft"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowTitleBar.ExtendsContentIntoTitleBar="True"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:WidthToGridLengthConverter x:Key="WidthToGridLength" />

            <!-- Bouton de disposition de la barre de titre ; Tag = vrai quand le panneau est affiché (glyphe plus clair). -->
            <Style x:Key="LayoutButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="26" />
                <Setter Property="FontSize" Value="14" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{StaticResource True}">
                        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding BuildCommand}" />
        <KeyBinding Key="F5" Command="{Binding RunClientCommand}" />
        <KeyBinding Key="F7" Command="{Binding ValidateCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveDocumentCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!--
            Barre de titre (comme VS Code) : icône, titre au centre, boutons de disposition à droite,
            avant les boutons de la fenêtre dessinés par ModernWpf. Le reste de la barre sert à
            déplacer la fenêtre ; seuls les boutons reçoivent la souris.
        -->
        <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource SidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding (ui:WindowTitleBar.SystemOverlayRightInset), RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthToGridLength}, FallbackValue=138}" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="4" Text="{Binding WindowTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource HintBrush}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" MaxWidth="520" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <Path Data="{StaticResource CubeGeometry}" Stroke="{DynamicResource AccentLineBrush}" StrokeThickness="1.6"
                      Stretch="Uniform" Width="16" Height="16" Margin="12,0,8,0" />
                <TextBlock Text="Mine Engine" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource BadgeTextBrush}" />
            </StackPanel>

            <!-- Disposition : Personnaliser, Explorateur (gauche), panneau du bas, Détails (droite). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                        Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="LayoutMenuButton" Style="{StaticResource LayoutButton}" Content="&#xE8A9;" Click="OnLayoutMenuClick"
                        ToolTip="Personnaliser la disposition" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="ExplorerMenuItem" Header="Explorateur" IsCheckable="True" InputGestureText="Ctrl+B" Click="OnToggleExplorerClick" />
                            <MenuItem x:Name="BottomMenuItem" Header="Sortie et diagnostics" IsCheckable="True" InputGestureText="Ctrl+J" Click="OnToggleBottomClick" />
                            <MenuItem x:Name="InspectorMenuItem" Header="Détails / Inspecteur" IsCheckable="True" InputGestureText="Ctrl+Alt+B" Click="OnToggleInspectorClick" />
                            <Separator />
                            <MenuItem Header="Mode concentration (masquer les panneaux)" Click="OnFocusModeClick" />
                            <MenuItem Header="Tout afficher" Click="OnShowAllPanelsClick" />
                            <Separator />
                            <MenuItem Header="Réinitialiser la disposition" Click="OnResetLayoutClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ExplorerToggle" Style="{StaticResource LayoutButton}" Content="&#xE90C;" Click="OnToggleExplorerClick"
                        ToolTip="Afficher ou masquer l'Explorateur (Ctrl+B)" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="BottomToggle" Style="{StaticResource LayoutButton}" Content="&#xE90E;" Click="OnToggleBottomClick"
                        ToolTip="Afficher ou masquer Sortie et Diagnostics (Ctrl+J)" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="InspectorToggle" Style="{StaticResource LayoutButton}" Content="&#xE90D;" Click="OnToggleInspectorClick"
                        ToolTip="Afficher ou masquer Détails / Inspecteur (Ctrl+Alt+B)" WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <!-- Menus -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Nouveau projet..." Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Ouvrir un projet..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Enregistrer tout" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"
                          ToolTip="Enregistre le projet et les fichiers modifiés dans les onglets" />
                <MenuItem Header="Enregistrer le _fichier" Command="{Binding SaveDocumentCommand}" />
                <MenuItem Header="Fermer l'_onglet" Command="{Binding CloseActiveDocumentCommand}" InputGestureText="Ctrl+W" />
                <MenuItem Header="_Fermer le projet (retour à l'accueil)" Command="{Binding CloseProjectCommand}" />
                <Separator />
                <MenuItem Header="Ouvrir le dossier du projet" Command="{Binding OpenProjectFolderCommand}" />
                <MenuItem Header="Ouvrir le dossier des sauvegardes" Command="{Binding OpenBackupsFolderCommand}" />
                <Separator />
                <MenuItem Header="_Quitter" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="É_dition">
                <MenuItem Header="{Binding UndoLabel}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{Binding RedoLabel}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Supprimer l'élément sélectionné" Command="{Binding DeleteAssetCommand}" />
                <MenuItem Header="_Voir le fichier de l'élément" Command="{Binding OpenAssetSourceCommand}" />
            </MenuItem>
            <MenuItem Header="_Affichage">
                <MenuItem Header="_Dashboard" Command="{Binding ShowDashboardCommand}" />
                <MenuItem Header="_Explorateur" Tag="explorer" Click="OnShowPanelClick" />
                <MenuItem Header="Dé_tails / Inspecteur" Tag="inspector" Click="OnShowPanelClick" />
                <MenuItem Header="_Sortie" Tag="output" Click="OnShowPanelClick" />
                <MenuItem Header="_Diagnostics" Tag="diagnostics" Click="OnShowPanelClick" />
                <Separator />
                <MenuItem Header="_Réinitialiser la disposition" Click="OnResetLayoutClick" />
            </MenuItem>
            <MenuItem Header="_Projet">
                <MenuItem Header="_Paramètres du projet..." Command="{Binding EditProjectSettingsCommand}" />
                <Separator />
                <MenuItem Header="Ajouter un _item" Command="{Binding AddItemCommand}" />
                <MenuItem Header="Ajouter un _bloc" Command="{Binding AddBlockCommand}" />
                <MenuItem Header="Ajouter un _mob" Command="{Binding AddMobCommand}" />
                <MenuItem Header="Ajouter une _recette" Command="{Binding AddRecipeCommand}" />
                <MenuItem Header="Ajouter un _graphe">
                    <MenuItem Header="Graphe d'_événements" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Events}"
                              ToolTip="Réactions aux événements du jeu (clic droit, connexion...)" />
                    <Separator />
                    <MenuItem Header="_Fonction" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Function}"
                              ToolTip="Suite d'instructions qui renvoie des valeurs" />
                    <MenuItem Header="_Procédure" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Procedure}"
                              ToolTip="Suite d'instructions qui ne renvoie rien" />
                    <Separator />
                    <MenuItem Header="_Classe" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Class}"
                              ToolTip="Type avec des champs, un constructeur, des méthodes ; héritage et interfaces" />
                    <MenuItem Header="_Structure" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Struct}"
                              ToolTip="Type qui regroupe des champs" />
                    <MenuItem Header="_Interface" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Interface}"
                              ToolTip="Méthodes que les classes qui l'implémentent doivent fournir" />
                    <MenuItem Header="É_numération" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Enum}"
                              ToolTip="Liste de valeurs nommées" />
                </MenuItem>
                <MenuItem Header="Nouvelle classe _Java">
                    <MenuItem Header="Écouteur d'événements du jeu..." Command="{Binding Explorer.NewJavaClassCommand}"
                              CommandParameter="{x:Static java:JavaClassKind.EventListener}" />
                    <MenuItem Header="Classe utilitaire..." Command="{Binding Explorer.NewJavaClassCommand}"
                              CommandParameter="{x:Static java:JavaClassKind.Utility}" />
                    <MenuItem Header="Classe vide..." Command="{Binding Explorer.NewJavaClassCommand}"
                              CommandParameter="{x:Static java:JavaClassKind.Empty}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Importer des _textures (PNG)..." Command="{Binding ImportTexturesCommand}" />
                <MenuItem Header="Importer des _sons (OGG)..." Command="{Binding ImportSoundsCommand}" />
                <Separator />
                <MenuItem Header="_Valider le projet" Command="{Binding ValidateCommand}" InputGestureText="F7" />
            </MenuItem>
            <MenuItem Header="_Compilation">
                <MenuItem Header="_Générer le mod (.jar)" Command="{Binding BuildCommand}" InputGestureText="Ctrl+Maj+B" />
                <MenuItem Header="_Lancer Minecraft" Command="{Binding RunClientCommand}" InputGestureText="F5" />
                <MenuItem Header="_Annuler le build" Command="{Binding CancelBuildCommand}" />
                <Separator />
                <MenuItem Header="Ouvrir le dossier des mods produits (build/libs)" Command="{Binding OpenBuildFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Outils">
                <MenuItem Header="Gestionnaire de _MDK..." Command="{Binding OpenMdkManagerCommand}" />
                <Separator />
                <MenuItem Header="_Paramètres..." Command="{Binding OpenSettingsCommand}" InputGestureText="Ctrl+," />
            </MenuItem>
        </Menu>

        <!-- Barre de statut : projet et problèmes à gauche ; position dans le fichier, compilation et version à droite -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="CaretStatus" Orientation="Horizontal"
                                Visibility="{Binding HasActiveCodeDocument, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ActiveCodeDocument.CaretLabel}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="{Binding ActiveCodeDocument.IndentationLabel}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="{Binding ActiveCodeDocument.EncodingLabel}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="{Binding ActiveCodeDocument.Language}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HintBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource FlatButton}" Command="{Binding BuildCommand}" ToolTip="Générer le mod (Ctrl+Maj+B)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE90F;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Compiler" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding RunClientCommand}" ToolTip="Lancer Minecraft (F5)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE768;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Lancer" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding CancelBuildCommand}" ToolTip="Arrêter la compilation"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Arrêter" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding VersionLabel}" Margin="12,0,2,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource HintBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing IsActive="{Binding IsBusy}" Width="12" Height="12" Margin="0,0,8,0" />
                    <Ellipse x:Name="ProjectDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                             Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource LogSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Diagnostics.ErrorCount, Converter={StaticResource ZeroToVisible}}" Value="Collapsed">
                                        <Setter Property="Fill" Value="{DynamicResource LogErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ProjectStatus, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource HintBrush}" /><Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource HintBrush}" />
                    </TextBlock>
                    <Button Style="{StaticResource FlatButton}" Margin="10,0,0,0" Tag="diagnostics" Click="OnShowPanelClick"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" ToolTip="Afficher les diagnostics">
                        <TextBlock Text="{Binding Diagnostics.ProblemsLabel}" FontSize="12" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
        <!-- Panneaux ancrables -->
        <dock:DockingManager x:Name="DockManager" AllowMixedOrientation="True">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">
                    <dock:LayoutAnchorablePane DockWidth="270" DockMinWidth="180">
                        <dock:LayoutAnchorable Title="Explorateur" ContentId="explorer" CanClose="False">
                            <panels:ProjectExplorerPanel x:Name="ExplorerPanel" />
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                    <dock:LayoutPanel Orientation="Vertical">
                        <dock:LayoutDocumentPane>
                            <dock:LayoutDocument x:Name="DashboardDocument" Title="Dashboard" ContentId="home" CanClose="False" CanFloat="False">
                                <panels:DashboardPanel x:Name="DashboardPanel" />
                            </dock:LayoutDocument>
                        </dock:LayoutDocumentPane>
                        <dock:LayoutAnchorablePane DockHeight="220" DockMinHeight="90">
                            <dock:LayoutAnchorable Title="Sortie" ContentId="output" CanClose="False">
                                <panels:OutputPanel x:Name="OutputPanel" />
                            </dock:LayoutAnchorable>
                            <dock:LayoutAnchorable Title="Diagnostics" ContentId="diagnostics" CanClose="False">
                                <panels:DiagnosticsPanel x:Name="DiagnosticsPanel" />
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                    </dock:LayoutPanel>

                    <dock:LayoutAnchorablePane DockWidth="380" DockMinWidth="240">
                        <dock:LayoutAnchorable Title="Détails / Inspecteur" ContentId="inspector" CanClose="False">
                            <panels:InspectorPanel x:Name="InspectorPanel" />
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>
                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>

        <!-- Accueil (sélection de projet) : recouvre l'espace de travail tant qu'aucun projet n'est ouvert -->
        <DockPanel Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}"
                   Background="{DynamicResource HubBackgroundBrush}">
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Border HorizontalAlignment="Left" Margin="8,0,0,0" Padding="12,6" BorderBrush="{DynamicResource AccentLineBrush}"
                        BorderThickness="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Accueil" />
                    </StackPanel>
                </Border>
            </Border>
            <hubviews:ProjectHubView />
        </DockPanel>
        </Grid>
    </DockPanel>
</Window>
