<Window x:Class="MineEngine.Editor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MineEngine.Editor.Views"
        xmlns:l="clr-namespace:MineEngine.Editor.Localization"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:panels="clr-namespace:MineEngine.Editor.Views.Panels"
        xmlns:conv="clr-namespace:MineEngine.Editor.Converters"
        xmlns:hubviews="clr-namespace:MineEngine.Editor.Views.Hub"
        xmlns:graphs="clr-namespace:MineEngine.Assets.Graphs;assembly=MineEngine.Assets"
        xmlns:java="clr-namespace:MineEngine.Minecraft.Java;assembly=MineEngine.Minecraft"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowTitleBar.ExtendsContentIntoTitleBar="True"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:WidthToGridLengthConverter x:Key="WidthToGridLength" />

            <!-- Bouton de disposition de la barre de titre ; Tag = vrai quand le panneau est affiché (glyphe plus clair). -->
            <Style x:Key="LayoutButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="26" />
                <Setter Property="FontSize" Value="14" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{StaticResource True}">
                        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--
            Barre de titre (comme VS Code) : icône, titre au centre, boutons de disposition à droite,
            avant les boutons de la fenêtre dessinés par ModernWpf. Le reste de la barre sert à
            déplacer la fenêtre ; seuls les boutons reçoivent la souris.
        -->
        <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource SidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding (ui:WindowTitleBar.SystemOverlayRightInset), RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthToGridLength}, FallbackValue=138}" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="4" Text="{Binding WindowTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource HintBrush}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" MaxWidth="520" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <Path Style="{StaticResource LogoPath}" Margin="12,0,8,0" />
                <TextBlock Text="{l:Tr 'Mine Engine'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource BadgeTextBrush}" />
            </StackPanel>

            <!-- Disposition : Personnaliser, Explorateur (gauche), panneau du bas, Détails (droite). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                        Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="LayoutMenuButton" Style="{StaticResource LayoutButton}" Content="{StaticResource Glyph.Layout}" Click="OnLayoutMenuClick"
                        ToolTip="{l:Tr 'Personnaliser la disposition'}" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="ExplorerMenuItem" Header="{l:Tr 'Explorateur'}" IsCheckable="True" InputGestureText="Ctrl+B" Click="OnToggleExplorerClick" />
                            <MenuItem x:Name="BottomMenuItem" Header="{l:Tr 'Sortie et diagnostics'}" IsCheckable="True" InputGestureText="Ctrl+J" Click="OnToggleBottomClick" />
                            <MenuItem x:Name="InspectorMenuItem" Header="{l:Tr 'Détails / Inspecteur'}" IsCheckable="True" InputGestureText="Ctrl+Alt+B" Click="OnToggleInspectorClick" />
                            <Separator />
                            <MenuItem Header="{l:Tr 'Mode concentration (masquer les panneaux)'}" Click="OnFocusModeClick" />
                            <MenuItem Header="{l:Tr 'Tout afficher'}" Click="OnShowAllPanelsClick" />
                            <Separator />
                            <MenuItem Header="{l:Tr 'Réinitialiser la disposition'}" Click="OnResetLayoutClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ExplorerToggle" Style="{StaticResource LayoutButton}" Content="{StaticResource Glyph.PanelLeft}" Click="OnToggleExplorerClick"
                        ToolTip="{l:Tr 'Afficher ou masquer l\'Explorateur (Ctrl+B)'}" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="BottomToggle" Style="{StaticResource LayoutButton}" Content="{StaticResource Glyph.PanelBottom}" Click="OnToggleBottomClick"
                        ToolTip="{l:Tr 'Afficher ou masquer Sortie et Diagnostics (Ctrl+J)'}" WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="InspectorToggle" Style="{StaticResource LayoutButton}" Content="{StaticResource Glyph.PanelRight}" Click="OnToggleInspectorClick"
                        ToolTip="{l:Tr 'Afficher ou masquer Détails / Inspecteur (Ctrl+Alt+B)'}" WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <!-- Menus : Mine Engine, Fichier, Édition, Espace de travail, Éléments, Outils, Compilation et lancement, Fenêtre -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}">
            <MenuItem Header="{l:Tr '_Mine Engine'}">
                <MenuItem Header="{l:Tr 'Dépôt _GitHub'}" Command="{Binding OpenRepositoryCommand}"
                          ToolTip="{l:Tr 'Code source, tickets et versions de Mine Engine'}" />
                <MenuItem Header="{l:Tr '_Site web'}" Command="{Binding OpenWebsiteCommand}" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Fichier'}">
                <MenuItem Header="{l:Tr '_Nouveau projet...'}" Command="{Binding NewProjectCommand}" InputGestureText="{Binding Shortcuts[file.newProject]}" />
                <MenuItem Header="{l:Tr '_Ouvrir un projet...'}" Command="{Binding OpenProjectCommand}" InputGestureText="{Binding Shortcuts[file.openProject]}" />
                <MenuItem Header="{l:Tr '_Enregistrer tout'}" Command="{Binding SaveProjectCommand}" InputGestureText="{Binding Shortcuts[file.saveAll]}"
                          ToolTip="{l:Tr 'Enregistre le projet et les fichiers modifiés dans les onglets'}" />
                <MenuItem Header="{l:Tr 'Enregistrer le _fichier'}" Command="{Binding SaveDocumentCommand}" InputGestureText="{Binding Shortcuts[file.saveFile]}" />
                <MenuItem Header="{l:Tr 'Fermer l\'_onglet'}" Command="{Binding CloseActiveDocumentCommand}" InputGestureText="{Binding Shortcuts[file.closeTab]}" />
                <MenuItem Header="{l:Tr '_Fermer le projet (retour à l\'accueil)'}" Command="{Binding CloseProjectCommand}" InputGestureText="{Binding Shortcuts[file.closeProject]}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Quitter'}" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="{l:Tr 'É_dition'}">
                <MenuItem Header="{Binding UndoLabel}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{Binding RedoLabel}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="{l:Tr '_Éditer l\'élément sélectionné'}" Command="{Binding EditSelectedAssetCommand}" InputGestureText="{Binding Shortcuts[edit.edit]}" />
                <MenuItem Header="{l:Tr 'D_upliquer l\'élément sélectionné'}" Command="{Binding DuplicateAssetCommand}" InputGestureText="{Binding Shortcuts[edit.duplicate]}" />
                <MenuItem Header="{l:Tr '_Supprimer l\'élément sélectionné'}" Command="{Binding DeleteAssetCommand}" InputGestureText="{Binding Shortcuts[edit.delete]}" />
                <Separator />
                <MenuItem Header="{l:Tr 'Ouvrir le _graphe sélectionné'}" Command="{Binding OpenSelectedGraphCommand}" InputGestureText="{Binding Shortcuts[edit.openGraph]}" />
                <MenuItem Header="{l:Tr 'Voir le code _Java'}" Command="{Binding OpenAssetJavaCommand}" InputGestureText="{Binding Shortcuts[edit.viewJava]}" />
                <MenuItem Header="{l:Tr '_Voir le fichier de l\'élément'}" Command="{Binding OpenAssetSourceCommand}" />
            </MenuItem>
            <MenuItem Header="{l:Tr 'Espace de _travail'}">
                <MenuItem Header="{l:Tr '_Paramètres du projet...'}" Command="{Binding EditProjectSettingsCommand}" InputGestureText="{Binding Shortcuts[workspace.settings]}" />
                <Separator />
                <MenuItem Header="{l:Tr 'Ouvrir le dossier du projet'}" Command="{Binding OpenProjectFolderCommand}" />
                <MenuItem Header="{l:Tr 'Ouvrir le dossier des sauvegardes'}" Command="{Binding OpenBackupsFolderCommand}" />
                <Separator />
                <MenuItem Header="{l:Tr 'Nouveau _dossier'}" Command="{Binding NewFolderCommand}" InputGestureText="{Binding Shortcuts[workspace.newFolder]}" />
                <MenuItem Header="{l:Tr 'Nouvelle classe _Java'}">
                    <MenuItem Header="{l:Tr 'Écouteur d\'événements du jeu...'}" Command="{Binding Explorer.NewJavaClassCommand}"
                              CommandParameter="{x:Static java:JavaClassKind.EventListener}" />
                    <MenuItem Header="{l:Tr 'Classe utilitaire...'}" Command="{Binding Explorer.NewJavaClassCommand}"
                              CommandParameter="{x:Static java:JavaClassKind.Utility}" />
                    <MenuItem Header="{l:Tr 'Classe vide...'}" Command="{Binding Explorer.NewJavaClassCommand}"
                              CommandParameter="{x:Static java:JavaClassKind.Empty}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:Tr '_Valider le projet'}" Command="{Binding ValidateCommand}" InputGestureText="{Binding Shortcuts[workspace.validate]}" />
            </MenuItem>
            <MenuItem Header="{l:Tr 'Élé_ments'}">
                <MenuItem Header="{l:Tr '_Ajouter'}">
                    <MenuItem Header="{l:Tr 'Contenu du jeu'}">
                        <MenuItem.Icon><views:IconView Icon="BlockGeometry" IconSize="14" /></MenuItem.Icon>
                        <MenuItem Header="{l:Tr 'Item'}" Command="{Binding AddItemCommand}" InputGestureText="{Binding Shortcuts[assets.addItem]}">
                            <MenuItem.Icon><views:IconView Icon="ItemGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr 'Bloc'}" Command="{Binding AddBlockCommand}" InputGestureText="{Binding Shortcuts[assets.addBlock]}">
                            <MenuItem.Icon><views:IconView Icon="BlockGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr 'Mob'}" Command="{Binding AddMobCommand}" InputGestureText="{Binding Shortcuts[assets.addMob]}">
                            <MenuItem.Icon><views:IconView Icon="MobGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr 'Recette'}" Command="{Binding AddRecipeCommand}" InputGestureText="{Binding Shortcuts[assets.addRecipe]}">
                            <MenuItem.Icon><views:IconView Icon="RecipeGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="{l:Tr 'Programmation nodale'}">
                        <MenuItem.Icon><views:IconView Icon="NodeGraphGeometry" IconSize="14" /></MenuItem.Icon>
                        <MenuItem Header="{l:Tr 'Graphe d\'événements'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Events}" ToolTip="{l:Tr 'Réactions aux événements du jeu (clic droit, connexion...)'}">
                            <MenuItem.Icon><views:IconView Icon="NodeGraphGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:Tr 'Fonction'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Function}" ToolTip="{l:Tr 'Suite d\'instructions qui renvoie des valeurs'}">
                            <MenuItem.Icon><views:IconView Icon="FunctionGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr 'Procédure'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Procedure}" ToolTip="{l:Tr 'Suite d\'instructions qui ne renvoie rien'}">
                            <MenuItem.Icon><views:IconView Icon="ProcedureGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:Tr 'Classe'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Class}" ToolTip="{l:Tr 'Type avec des champs, un constructeur, des méthodes ; héritage et interfaces'}">
                            <MenuItem.Icon><views:IconView Icon="ClassGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr 'Structure'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Struct}" ToolTip="{l:Tr 'Type qui regroupe des champs'}">
                            <MenuItem.Icon><views:IconView Icon="StructGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr 'Interface'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Interface}" ToolTip="{l:Tr 'Méthodes que les classes qui l\'implémentent doivent fournir'}">
                            <MenuItem.Icon><views:IconView Icon="InterfaceGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:Tr 'Énumération'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Enum}" ToolTip="{l:Tr 'Liste de valeurs nommées'}">
                            <MenuItem.Icon><views:IconView Icon="EnumGeometry" IconSize="14" /></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="{l:Tr 'Classe Java'}">
                        <MenuItem Header="{l:Tr 'Écouteur d\'événements du jeu...'}" Command="{Binding Explorer.NewJavaClassCommand}" CommandParameter="{x:Static java:JavaClassKind.EventListener}" />
                        <MenuItem Header="{l:Tr 'Classe utilitaire...'}" Command="{Binding Explorer.NewJavaClassCommand}" CommandParameter="{x:Static java:JavaClassKind.Utility}" />
                        <MenuItem Header="{l:Tr 'Classe vide...'}" Command="{Binding Explorer.NewJavaClassCommand}" CommandParameter="{x:Static java:JavaClassKind.Empty}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{l:Tr 'Importer'}">
                        <MenuItem Header="{l:Tr 'Textures (PNG)...'}" Command="{Binding ImportTexturesCommand}" InputGestureText="{Binding Shortcuts[assets.importTextures]}" />
                        <MenuItem Header="{l:Tr 'Sons (OGG)...'}" Command="{Binding ImportSoundsCommand}" InputGestureText="{Binding Shortcuts[assets.importSounds]}" />
                        <MenuItem Header="{l:Tr 'Élément d\'un autre projet (.asset.json)...'}" Command="{Binding ImportAssetCommand}" ToolTip="{l:Tr 'Ajoute au dossier ouvert un élément exporté depuis un autre projet'}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{l:Tr 'Nouveau dossier'}" Command="{Binding NewFolderCommand}" InputGestureText="{Binding Shortcuts[workspace.newFolder]}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{l:Tr '_Exporter l\'élément sélectionné...'}" Command="{Binding ExportAssetCommand}" InputGestureText="{Binding Shortcuts[assets.export]}"
                          ToolTip="{l:Tr 'Fichier .asset.json de l\'élément, ou l\'image ou le son d\'une texture ou d\'un son'}" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Outils'}">
                <MenuItem Header="{l:Tr 'Gestionnaire de _MDK...'}" Command="{Binding OpenMdkManagerCommand}" InputGestureText="{Binding Shortcuts[tools.mdk]}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Paramètres...'}" Command="{Binding OpenSettingsCommand}" InputGestureText="{Binding Shortcuts[tools.settings]}" />
            </MenuItem>
            <MenuItem Header="{l:Tr '_Compilation et lancement'}">
                <MenuItem Header="{l:Tr '_Compiler le mod'}" Command="{Binding BuildCommand}" InputGestureText="{Binding Shortcuts[build.build]}" />
                <MenuItem Header="{l:Tr '_Exporter le mod (.jar)...'}" Command="{Binding ExportModCommand}" InputGestureText="{Binding Shortcuts[build.export]}"
                          ToolTip="{l:Tr 'Compile le mod puis copie le .jar à l\'endroit choisi'}" />
                <MenuItem Header="{l:Tr '_Lancer Minecraft'}" Command="{Binding RunClientCommand}" InputGestureText="{Binding Shortcuts[build.run]}" />
                <MenuItem Header="{l:Tr '_Recharger Gradle'}" Command="{Binding ReloadGradleCommand}" InputGestureText="{Binding Shortcuts[build.reloadGradle]}"
                          ToolTip="{l:Tr 'Régénère le projet et fait relire à Gradle sa configuration et ses dépendances, sans compiler'}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Arrêter'}" Command="{Binding CancelBuildCommand}" InputGestureText="{Binding Shortcuts[build.stop]}" />
                <MenuItem Header="{l:Tr 'Ouvrir le dossier des mods produits (build/libs)'}" Command="{Binding OpenBuildFolderCommand}" />
            </MenuItem>
            <MenuItem Header="{l:Tr 'Fe_nêtre'}">
                <MenuItem Header="{l:Tr '_Dashboard'}" Command="{Binding ShowDashboardCommand}" InputGestureText="{Binding Shortcuts[window.dashboard]}" />
                <MenuItem Header="{l:Tr 'R_essources'}" Command="{Binding ShowResourcesCommand}" InputGestureText="{Binding Shortcuts[window.resources]}" />
                <MenuItem Header="{l:Tr '_Langues du mod'}" Command="{Binding ShowLanguagesCommand}" InputGestureText="{Binding Shortcuts[window.languages]}" />
                <Separator />
                <MenuItem Header="{l:Tr '_Explorateur'}" Tag="explorer" Click="OnShowPanelClick" InputGestureText="Ctrl+B" />
                <MenuItem Header="{l:Tr 'Dé_tails / Inspecteur'}" Tag="inspector" Click="OnShowPanelClick" InputGestureText="Ctrl+Alt+B" />
                <MenuItem Header="{l:Tr '_Sortie'}" Tag="output" Click="OnShowPanelClick" />
                <MenuItem Header="{l:Tr 'D_iagnostics'}" Tag="diagnostics" Click="OnShowPanelClick" />
                <Separator />
                <MenuItem Header="{l:Tr 'Mode concentration (masquer les panneaux)'}" Click="OnFocusModeClick" />
                <MenuItem Header="{l:Tr 'Tout afficher'}" Click="OnShowAllPanelsClick" />
                <MenuItem Header="{l:Tr '_Réinitialiser la disposition'}" Click="OnResetLayoutClick" />
            </MenuItem>
        </Menu>

        <!-- Barre d'outils : ajout et actions sur l'élément sélectionné, recherche, affichage, compilation -->
        <views:MainToolbar x:Name="Toolbar" DockPanel.Dock="Top"
                           Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />

        <!-- Barre de statut : projet et problèmes à gauche ; position dans le fichier, compilation et version à droite -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="CaretStatus" Orientation="Horizontal"
                                Visibility="{Binding HasActiveCodeDocument, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ActiveCodeDocument.CaretLabel}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="{Binding ActiveCodeDocument.IndentationLabel}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="{Binding ActiveCodeDocument.EncodingLabel}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HintBrush}" />
                        <TextBlock Text="{Binding ActiveCodeDocument.Language}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource HintBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource FlatButton}" Command="{Binding BuildCommand}" ToolTip="{l:Tr 'Générer le mod (Ctrl+Maj+B)'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Build}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr 'Compiler'}" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding RunClientCommand}" ToolTip="{l:Tr 'Lancer Minecraft (F5)'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Run}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr 'Lancer'}" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding CancelBuildCommand}" ToolTip="{l:Tr 'Arrêter la compilation'}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Tr 'Arrêter'}" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding VersionLabel}" Margin="12,0,2,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource HintBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing IsActive="{Binding IsBusy}" Width="12" Height="12" Margin="0,0,8,0" />
                    <Ellipse x:Name="ProjectDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                             Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource LogSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Diagnostics.ErrorCount, Converter={StaticResource ZeroToVisible}}" Value="Collapsed">
                                        <Setter Property="Fill" Value="{DynamicResource LogErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ProjectStatus, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource HintBrush}" /><Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{DynamicResource HintBrush}" />
                    </TextBlock>
                    <Button Style="{StaticResource FlatButton}" Margin="10,0,0,0" Tag="diagnostics" Click="OnShowPanelClick"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" ToolTip="{l:Tr 'Afficher les diagnostics'}">
                        <TextBlock Text="{Binding Diagnostics.ProblemsLabel}" FontSize="12" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
        <!-- Panneaux ancrables -->
        <dock:DockingManager x:Name="DockManager" AllowMixedOrientation="True">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">
                    <dock:LayoutAnchorablePane DockWidth="270" DockMinWidth="180">
                        <dock:LayoutAnchorable Title="{l:Tr 'Explorateur'}" ContentId="explorer" CanClose="False">
                            <panels:ProjectExplorerPanel x:Name="ExplorerPanel" />
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>

                    <dock:LayoutPanel Orientation="Vertical">
                        <dock:LayoutDocumentPane>
                            <dock:LayoutDocument x:Name="DashboardDocument" Title="{l:Tr 'Dashboard'}" ContentId="home" CanClose="False" CanFloat="False">
                                <panels:DashboardPanel x:Name="DashboardPanel" />
                            </dock:LayoutDocument>
                            <dock:LayoutDocument Title="{l:Tr 'Ressources'}" ContentId="resources" CanClose="False" CanFloat="False">
                                <panels:ResourcesPanel x:Name="ResourcesPanel" />
                            </dock:LayoutDocument>
                            <dock:LayoutDocument Title="{l:Tr 'Langues'}" ContentId="languages" CanClose="False" CanFloat="False">
                                <panels:LanguagesPanel x:Name="LanguagesPanel" />
                            </dock:LayoutDocument>
                        </dock:LayoutDocumentPane>
                        <dock:LayoutAnchorablePane DockHeight="220" DockMinHeight="90">
                            <dock:LayoutAnchorable Title="{l:Tr 'Sortie'}" ContentId="output" CanClose="False">
                                <panels:OutputPanel x:Name="OutputPanel" />
                            </dock:LayoutAnchorable>
                            <dock:LayoutAnchorable Title="{l:Tr 'Diagnostics'}" ContentId="diagnostics" CanClose="False">
                                <panels:DiagnosticsPanel x:Name="DiagnosticsPanel" />
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                    </dock:LayoutPanel>

                    <dock:LayoutAnchorablePane DockWidth="380" DockMinWidth="240">
                        <dock:LayoutAnchorable Title="{l:Tr 'Détails / Inspecteur'}" ContentId="inspector" CanClose="False">
                            <panels:InspectorPanel x:Name="InspectorPanel" />
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>
                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>

        <!-- Accueil (sélection de projet) : recouvre l'espace de travail tant qu'aucun projet n'est ouvert -->
        <DockPanel Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}"
                   Background="{DynamicResource HubBackgroundBrush}">
            <hubviews:ProjectHubView />
        </DockPanel>
        </Grid>
    </DockPanel>
</Window>
