<UserControl x:Class="MineEngine.Editor.Views.Gui.GuiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:gui="clr-namespace:MineEngine.Editor.ViewModels.Gui"
             xmlns:local="clr-namespace:MineEngine.Editor.Views.Gui"
             xmlns:views="clr-namespace:MineEngine.Editor.Views"
             xmlns:assets="clr-namespace:MineEngine.Editor.ViewModels.Assets"
             xmlns:graphviews="clr-namespace:MineEngine.Editor.Views.Graphs"
             Focusable="True" FocusVisualStyle="{x:Null}" KeyDown="OnKeyDown">

    <!--
        GUI editor (V0.8.0, like the GUI editor of MCreator). DataContext: GuiDocumentViewModel.
        Left: the toolbox (a click adds a component). Middle: the window of the GUI over a view of the
        game, at the zoom chosen with Ctrl+wheel; a component is moved with the mouse, resized with the
        handle of its corner, nudged with the arrows (Shift: 10 pixels). Right: the GUI, its components
        and the selected one, then the grid. Gestures are handled by the code-behind.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Colors of the game: the window, its bevel, the slots, the buttons. -->
            <SolidColorBrush x:Key="McPanel" Color="#C6C6C6" />
            <SolidColorBrush x:Key="McLight" Color="#FFFFFF" />
            <SolidColorBrush x:Key="McDark" Color="#555555" />
            <SolidColorBrush x:Key="McSlot" Color="#8B8B8B" />
            <SolidColorBrush x:Key="McSlotDark" Color="#373737" />
            <SolidColorBrush x:Key="McButton" Color="#6F6F6F" />

            <!-- A slot of the game: dark top left, light bottom right. -->
            <ControlTemplate x:Key="McSlotTemplate" TargetType="ContentControl">
                <Border Width="18" Height="18" Background="{StaticResource McSlot}" BorderThickness="1,1,0,0" BorderBrush="{StaticResource McSlotDark}">
                    <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource McLight}" />
                </Border>
            </ControlTemplate>

            <!-- How each kind of component is drawn, in pixels of the GUI. -->
            <DataTemplate x:Key="ComponentTemplate" DataType="{x:Type gui:GuiComponentViewModel}">
                <Grid x:Name="Root" Width="{Binding Width}" Height="{Binding Height}" Background="Transparent" Cursor="SizeAll"
                      ToolTip="{Binding Tooltip}" ToolTipService.IsEnabled="{Binding HasTooltip}">
                    <!-- The content, with the opacity and the rotation of the component (V0.8.1). -->
                    <Grid Opacity="{Binding PreviewOpacity}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="{Binding Rotation}" />
                        </Grid.RenderTransform>
                        <!-- Text -->
                        <TextBlock x:Name="Label" Text="{Binding Text}" Foreground="{Binding TextBrush}" FontSize="{Binding PreviewFontSize}" Visibility="Collapsed"
                                   Margin="{Binding PreviewPadding}" HorizontalAlignment="{Binding PreviewHorizontal}" VerticalAlignment="{Binding PreviewVertical}"
                                   TextAlignment="{Binding PreviewJustify}" TextWrapping="{Binding PreviewWrap}" />
                        <!-- Image, and the button that is an image -->
                        <Border x:Name="Picture" Visibility="Collapsed" BorderBrush="{Binding PreviewBorderBrush}" BorderThickness="{Binding PreviewBorder}">
                            <Grid>
                                <Border Background="#33000000" />
                                <views:IconView Icon="Glyph.Texture" IconSize="8" Foreground="#AA000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle x:Name="ImageFill" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding ImagePath, Converter={StaticResource FilePathToImage}}" Stretch="{Binding PreviewStretch}"
                                                    TileMode="{Binding PreviewTileMode}" Viewport="{Binding PreviewBrushViewport}" ViewportUnits="{Binding PreviewViewportUnits}"
                                                    AlignmentX="{Binding PreviewImageX}" AlignmentY="{Binding PreviewImageY}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- The tint, only where the image is -->
                                <Rectangle Fill="{Binding PreviewTint}" Opacity="0.5" OpacityMask="{Binding Fill, ElementName=ImageFill}"
                                           Visibility="{Binding HasTint, Converter={StaticResource BoolToVisibility}}" />
                                <Rectangle Fill="#40FFFFFF" Visibility="{Binding Highlight, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Text}" Foreground="White" FontSize="{Binding PreviewFontSize}" Margin="{Binding PreviewPadding}"
                                           HorizontalAlignment="{Binding PreviewHorizontal}" VerticalAlignment="{Binding PreviewVertical}"
                                           Visibility="{Binding IsImageButton, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <!-- Button of the game -->
                        <Border x:Name="Button" Visibility="Collapsed" Background="{StaticResource McButton}" BorderBrush="Black" BorderThickness="0.5">
                            <Border BorderThickness="0.5,0.5,0,0" BorderBrush="#AAAAAA">
                                <TextBlock Text="{Binding Text}" Foreground="White" FontSize="{Binding PreviewFontSize}" Margin="{Binding PreviewPadding}"
                                           HorizontalAlignment="{Binding PreviewHorizontal}" VerticalAlignment="{Binding PreviewVertical}" />
                            </Border>
                        </Border>
                        <!-- Slot -->
                        <Grid x:Name="Slot" Visibility="Collapsed">
                            <ContentControl Template="{StaticResource McSlotTemplate}" Focusable="False" />
                            <TextBlock x:Name="SlotMark" Text="&#x2192;" FontSize="7" Foreground="#40000000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Rectangle x:Name="SlotLock" Fill="#30000000" Visibility="Collapsed" />
                        </Grid>
                        <!-- Checkbox -->
                        <StackPanel x:Name="Check" Orientation="Horizontal" Visibility="Collapsed" Margin="{Binding PreviewPadding}"
                                    HorizontalAlignment="{Binding PreviewHorizontal}" VerticalAlignment="{Binding PreviewVertical}">
                            <Border Width="12" Height="12" Background="#202020" BorderBrush="#A0A0A0" BorderThickness="0.5">
                                <TextBlock Text="&#x2713;" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibility}}" />
                            </Border>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" FontSize="{Binding PreviewFontSize}" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Text input -->
                        <Border x:Name="Input" Visibility="Collapsed" Background="Black" BorderBrush="#A0A0A0" BorderThickness="0.5">
                            <TextBlock Text="{Binding Text}" Foreground="#707070" FontSize="8" Margin="3,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                    <!-- Typing on the canvas (double-click): Enter keeps, Escape drops. -->
                    <TextBox x:Name="Inline" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" FontSize="8" Padding="1,0" MinHeight="0"
                             MinWidth="20" VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                             IsVisibleChanged="OnInlineVisible" KeyDown="OnInlineKeyDown" LostKeyboardFocus="OnInlineLostFocus"
                             AutomationProperties.Name="{l:Tr 'Text of the component'}" />
                    <!-- Selection and resize handle -->
                    <Border x:Name="Frame" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="0.75" Margin="-1" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Rectangle x:Name="Handle" Tag="resize" Width="4" Height="4" Fill="{DynamicResource AccentLineBrush}" Cursor="SizeNWSE"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" Visibility="Collapsed" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsText}" Value="True"><Setter TargetName="Label" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding HasImage}" Value="True"><Setter TargetName="Picture" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding Blur}" Value="True">
                        <Setter TargetName="Picture" Property="Effect"><Setter.Value><BlurEffect Radius="1.2" /></Setter.Value></Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPlainButton}" Value="True"><Setter TargetName="Button" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsSlot}" Value="True"><Setter TargetName="Slot" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding SlotMode}" Value="Output"><Setter TargetName="SlotMark" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding SlotMode}" Value="Display"><Setter TargetName="SlotLock" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsCheckbox}" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsTextInput}" Value="True"><Setter TargetName="Input" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Frame" Property="Visibility" Value="Visible" /></DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                            <Condition Binding="{Binding CanResize}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Handle" Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="EventButtons" DataType="{x:Type assets:ElementMethodViewModel}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding State}"
                               Foreground="{DynamicResource LinkBrush}" Visibility="{Binding Exists, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{l:Tr '+ Java'}" Command="{Binding CreateJavaCommand}" Padding="8,2" Margin="0,0,4,0"
                            ToolTip="{l:Tr 'Write the event in Java'}"
                            Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{l:Tr '+ Graph'}" Command="{Binding CreateNodalCommand}" Padding="8,2"
                            ToolTip="{l:Tr 'Write the event as a node graph that belongs to the GUI'}"
                            Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Rename}" Command="{Binding OpenCommand}"
                            ToolTip="{l:Tr 'Edit the method'}" AutomationProperties.Name="{l:Tr 'Edit the method'}"
                            Visibility="{Binding Exists, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Command="{Binding RemoveCommand}" Margin="2,0,0,0"
                            ToolTip="{l:Tr 'Remove the method (and its graph)'}" AutomationProperties.Name="{l:Tr 'Remove the method'}"
                            Visibility="{Binding Exists, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="SideTitle" TargetType="TextBlock" BasedOn="{StaticResource PanelTitle}">
                <Setter Property="Margin" Value="0,14,0,6" />
            </Style>
            <Style x:Key="FieldName" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Width" Value="110" />
            </Style>
            <Style x:Key="Field" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style x:Key="Number" TargetType="ui:NumberBox">
                <Setter Property="SpinButtonPlacementMode" Value="Compact" />
                <Setter Property="SmallChange" Value="1" />
                <Setter Property="LargeChange" Value="10" />
                <Setter Property="Width" Value="110" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="ToolboxButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource HubBackgroundBrush}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,12,0">
            <Button Style="{StaticResource UnderlineTab}" Content="{l:Tr 'Design'}" Command="{Binding ShowDesignCommand}" Tag="{Binding IsDesignTab}"
                    AutomationProperties.Name="{l:Tr 'Design'}" FontSize="14" />
            <Button Style="{StaticResource UnderlineTab}" Content="{l:Tr 'Nodes'}" Command="{Binding ShowNodesCommand}" Tag="{Binding IsNodesTab}"
                    AutomationProperties.Name="{l:Tr 'Nodes'}" FontSize="14"
                    ToolTip="{l:Tr 'The graph of the GUI: its event nodes (button pressed, mouse over, text changed...) and its components marked variable'}" />
            <Button Style="{StaticResource UnderlineTab}" Content="{l:Tr 'Events'}" Command="{Binding ShowEventsCommand}" Tag="{Binding IsEventsTab}"
                    AutomationProperties.Name="{l:Tr 'Events'}" FontSize="14"
                    ToolTip="{l:Tr 'What the GUI does: its events in Java or as node graphs'}" />
        </StackPanel>
        <Grid>
        <!-- Nodes (V0.8.1): the graph of the GUI, edited here. -->
        <Grid Visibility="{Binding IsNodesTab, Converter={StaticResource BoolToVisibility}}">
            <graphviews:GraphDocumentView DataContext="{Binding NodesDocument}"
                                          Visibility="{Binding DataContext.HasNodesGraph, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                        Visibility="{Binding HasNodesGraph, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Style="{StaticResource PanelTitle}" HorizontalAlignment="Center" Text="{l:Tr 'The graph of the GUI'}" />
                <TextBlock Style="{StaticResource FieldHint}" FontSize="12" TextAlignment="Center" Margin="0,4,0,12"
                           Text="{l:Tr 'Program the GUI with nodes: GUI: opened, button pressed, mouse over, checkbox changed, text changed... The components marked variable are nodes of this graph.'}" />
                <Button Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Center" Padding="14,6" Command="{Binding CreateNodesGraphCommand}"
                        Content="{l:Tr 'Create the graph of the GUI'}" AutomationProperties.Name="{l:Tr 'Create the graph of the GUI'}" />
            </StackPanel>
        </Grid>

        <!-- Events: the methods of the GUI and of its components. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEventsTab, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="16,12" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource FieldHint}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="{l:Tr 'Each event runs on the server with the player and the world. Write it in Java, or as a graph that belongs to the GUI: the GUI nodes (Text of a GUI component, Set the text of a GUI component, Item in a GUI slot...) read and change its components.'}" />
                <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type assets:ElementMethodViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,8">
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource EventButtons}" Focusable="False" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Slot.Title}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource MonoHint}" Text="{Binding Slot.JavaSignature}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Visibility="{Binding IsDesignTab, Converter={StaticResource BoolToVisibility}}">

        <!-- Toolbox -->
        <StackPanel DockPanel.Dock="Left" Margin="10,12,6,12">
            <TextBlock Style="{StaticResource PanelCaption}" Text="{l:Tr 'ADD'}" Margin="2,0,0,8" />
            <ItemsControl ItemsSource="{Binding Kinds}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ToolboxButton}" Command="{Binding DataContext.AddComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="{Binding Converter={x:Static local:GuiKindLabelConverter.Instance}}"
                                AutomationProperties.Name="{Binding Converter={x:Static local:GuiKindLabelConverter.Instance}}">
                            <views:IconView Icon="{Binding Converter={x:Static local:GuiKindIconConverter.Instance}}" IconSize="20" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Properties -->
        <Border DockPanel.Dock="Right" Width="330" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardBorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,4,14,14">
                    <TextBlock Style="{StaticResource SideTitle}" Text="{l:Tr 'GUI'}" />
                    <DockPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Width x height'}" />
                        <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding Width}" Minimum="16" Maximum="512" AutomationProperties.Name="{l:Tr 'Width'}" />
                        <ui:NumberBox Style="{StaticResource Number}" Width="90" Margin="6,0,0,0" Value="{Binding Height}" Minimum="16" Maximum="512" AutomationProperties.Name="{l:Tr 'Height'}" />
                    </DockPanel>
                    <CheckBox IsChecked="{Binding HasInventory}" Content="{l:Tr 'Slots of the player\'s inventory'}" Margin="0,4,0,0" />
                    <DockPanel Style="{StaticResource Field}" Visibility="{Binding HasInventory, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Inventory offset'}" />
                        <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding InventoryOffsetX}" AutomationProperties.Name="{l:Tr 'Inventory offset X'}" />
                        <ui:NumberBox Style="{StaticResource Number}" Width="90" Margin="6,0,0,0" Value="{Binding InventoryOffsetY}" AutomationProperties.Name="{l:Tr 'Inventory offset Y'}" />
                    </DockPanel>
                    <CheckBox IsChecked="{Binding RenderBackground}" Content="{l:Tr 'Darken the world behind'}" />
                    <CheckBox IsChecked="{Binding PauseGame}" Content="{l:Tr 'Pause the game while it is open'}"
                              ToolTip="{l:Tr 'Only in single player, like the menu of the game'}" />

                    <!-- Components -->
                    <DockPanel Margin="0,14,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.ChevronUp}" Command="{Binding BringForwardCommand}"
                                    ToolTip="{l:Tr 'Bring forward'}" AutomationProperties.Name="{l:Tr 'Bring forward'}" />
                            <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.ChevronDown}" Command="{Binding SendBackwardCommand}"
                                    ToolTip="{l:Tr 'Send backward'}" AutomationProperties.Name="{l:Tr 'Send backward'}" />
                            <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Copy}" Command="{Binding DuplicateSelectedCommand}"
                                    ToolTip="{l:Tr 'Duplicate (Ctrl+D)'}" AutomationProperties.Name="{l:Tr 'Duplicate'}" />
                            <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Delete}" Command="{Binding DeleteSelectedCommand}"
                                    ToolTip="{l:Tr 'Delete (Del)'}" AutomationProperties.Name="{l:Tr 'Delete'}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PanelTitle}" Margin="0" VerticalAlignment="Center" Text="{l:Tr 'Components'}" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Components}" SelectedItem="{Binding Selected}" MaxHeight="190" MinHeight="40"
                             AutomationProperties.Name="{l:Tr 'Components'}" MouseDoubleClick="OnListDoubleClick"
                             ToolTip="{l:Tr 'Double-click: rename. Right-click: the actions of the component.'}">
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="OnMenuOpened" />
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type gui:GuiComponentViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <views:IconView Icon="{Binding Icon}" IconSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding KindLabel}" Margin="8,0,0,0" Foreground="{DynamicResource HintBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0" Text="{l:Tr 'The last ones are drawn on top.'}" />

                    <!-- Selected component -->
                    <StackPanel DataContext="{Binding Selected}" Visibility="{Binding DataContext.HasSelection, ElementName=Canvas, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SideTitle}" Text="{Binding KindLabel}" />
                        <DockPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Name'}" ToolTip="{l:Tr 'Name used by the code and the nodes'}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" AutomationProperties.Name="{l:Tr 'Name'}" />
                        </DockPanel>
                        <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource LogErrorBrush}" TextWrapping="Wrap" Margin="118,0,0,4"
                                   Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox IsChecked="{Binding IsVariable}" Content="{l:Tr 'Is variable (a node of the graph of the GUI)'}"
                                  ToolTip="{l:Tr 'The component becomes a node in the Nodes tab: it gives itself to the GUI nodes and follows its renaming'}" />
                        <DockPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Position'}" />
                            <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding X}" AutomationProperties.Name="X" />
                            <ui:NumberBox Style="{StaticResource Number}" Width="90" Margin="6,0,0,0" Value="{Binding Y}" AutomationProperties.Name="Y" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Field}" Visibility="{Binding CanResize, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Size'}" />
                            <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding Width}" Minimum="1" AutomationProperties.Name="{l:Tr 'Component width'}" />
                            <ui:NumberBox Style="{StaticResource Number}" Width="90" Margin="6,0,0,0" Value="{Binding Height}" Minimum="1" AutomationProperties.Name="{l:Tr 'Component height'}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Field}" Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{Binding TextLabel}" />
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Tr 'Text'}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Field}" Visibility="{Binding HasColor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Color'}" />
                            <views:ColorPicker Color="{Binding Color}" HorizontalAlignment="Left" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Field}" Visibility="{Binding HasImageLook, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Texture'}" />
                            <ComboBox ItemsSource="{Binding DataContext.TextureChoices, ElementName=Canvas}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding TextureId}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Tr 'Texture'}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsSlot, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Slot'}" />
                            <ComboBox ItemsSource="{x:Static gui:GuiComponentViewModel.SlotModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SlotMode}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Tr 'Slot'}" />
                        </DockPanel>
                        <CheckBox IsChecked="{Binding IsChecked}" Content="{l:Tr 'Ticked when the GUI opens'}"
                                  Visibility="{Binding IsCheckbox, Converter={StaticResource BoolToVisibility}}" />
                        <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Longest text'}" />
                            <ui:NumberBox Style="{StaticResource Number}" Value="{Binding MaxLength}" Minimum="1" Maximum="32767" AutomationProperties.Name="{l:Tr 'Longest text'}" />
                        </DockPanel>
                        <!-- The look (V0.8.1) -->
                        <TextBlock Style="{StaticResource SideTitle}" Text="{l:Tr 'Look'}" />
                        <StackPanel Visibility="{Binding HasAlignment, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Alignment'}" ToolTip="{l:Tr 'Place of the content in the component'}" />
                                <ComboBox Width="90" ItemsSource="{x:Static gui:GuiComponentViewModel.HorizontalChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Horizontal}" AutomationProperties.Name="{l:Tr 'Horizontal alignment'}" />
                                <ComboBox Width="90" Margin="6,0,0,0" ItemsSource="{x:Static gui:GuiComponentViewModel.VerticalChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Vertical}" AutomationProperties.Name="{l:Tr 'Vertical alignment'}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Lines'}" ToolTip="{l:Tr 'Place of the lines between them (justify content)'}" />
                                <ComboBox Width="90" ItemsSource="{x:Static gui:GuiComponentViewModel.HorizontalChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Justify}" AutomationProperties.Name="{l:Tr 'Justify content'}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Padding'}" />
                                <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding Padding}" Minimum="0" Maximum="64" AutomationProperties.Name="{l:Tr 'Padding'}" />
                            </DockPanel>
                        </StackPanel>
                        <DockPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Opacity (%)'}" />
                            <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding Opacity}" Minimum="0" Maximum="100" AutomationProperties.Name="{l:Tr 'Opacity'}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Field}" Visibility="{Binding HasRotation, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Rotation (degrees)'}" />
                            <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding Rotation}" Minimum="-360" Maximum="360" AutomationProperties.Name="{l:Tr 'Rotation'}" />
                        </DockPanel>
                        <!-- Text -->
                        <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Font size (%)'}" ToolTip="{l:Tr '100: the size of the font of the game'}" />
                                <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding FontScale}" Minimum="25" Maximum="800" SmallChange="25" AutomationProperties.Name="{l:Tr 'Font size'}" />
                            </DockPanel>
                            <CheckBox IsChecked="{Binding Wrap}" Content="{l:Tr 'Go to the next line at the end of the component'}" />
                            <DockPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Text on hover'}" ToolTip="{l:Tr 'Text shown while the mouse is over it; empty: the same'}" />
                                <TextBox Text="{Binding HoverText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Tr 'Text on hover'}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <CheckBox Width="118" IsChecked="{Binding HasHoverColor}" Content="{l:Tr 'Color on hover'}" />
                                <views:ColorPicker Color="{Binding HoverColor}" HorizontalAlignment="Left"
                                                   IsEnabled="{Binding HasHoverColor}" />
                            </DockPanel>
                        </StackPanel>
                        <!-- Image, and button that is an image -->
                        <StackPanel Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Image size'}" />
                                <ComboBox ItemsSource="{x:Static gui:GuiComponentViewModel.ImageSizeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding ImageSize}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Tr 'Image size'}" />
                            </DockPanel>
                            <CheckBox IsChecked="{Binding Tiling}" Content="{l:Tr 'Repeat the image (tiling)'}" />
                            <DockPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Tint'}" ToolTip="{l:Tr 'Color the image is multiplied by; white: unchanged'}" />
                                <views:ColorPicker Color="{Binding Tint}" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Border'}" />
                                <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding Border}" Minimum="0" Maximum="16" AutomationProperties.Name="{l:Tr 'Border'}" />
                                <views:ColorPicker Color="{Binding BorderColor}" Margin="6,0,0,0" HorizontalAlignment="Left" />
                            </DockPanel>
                            <CheckBox IsChecked="{Binding Blur}" Content="{l:Tr 'Blur'}" />
                            <CheckBox IsChecked="{Binding Highlight}" Content="{l:Tr 'Highlight'}" />
                            <DockPanel Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'On hover'}" ToolTip="{l:Tr 'What changes while the mouse is over the image'}" />
                                <ComboBox Width="110" ItemsSource="{x:Static gui:GuiComponentViewModel.HoverEffectChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding HoverEffect}" AutomationProperties.Name="{l:Tr 'On hover'}" />
                                <views:ColorPicker Color="{Binding HoverTint}" Margin="6,0,0,0" HorizontalAlignment="Left"
                                                   Visibility="{Binding HasHoverTint, Converter={StaticResource BoolToVisibility}}" />
                            </DockPanel>
                        </StackPanel>
                        <DockPanel Style="{StaticResource Field}" Visibility="{Binding DataContext.SelectedEvent, ElementName=Canvas, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Event'}" ToolTip="{Binding DataContext.SelectedEvent.Slot.Title, ElementName=Canvas}" />
                            <ContentControl Content="{Binding DataContext.SelectedEvent, ElementName=Canvas}" ContentTemplate="{StaticResource EventButtons}"
                                            Focusable="False" HorizontalAlignment="Left" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Tooltip'}" ToolTip="{l:Tr 'Text shown when the mouse is over the component; empty: none'}" />
                            <TextBox Text="{Binding Tooltip, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{l:Tr 'Tooltip'}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Grid -->
                    <TextBlock Style="{StaticResource SideTitle}" Text="{l:Tr 'Grid of the editor'}" />
                    <CheckBox IsChecked="{Binding SnapToGrid}" Content="{l:Tr 'Snap the components on the grid'}" />
                    <DockPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Step X x Y'}" />
                        <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding GridX}" Minimum="1" Maximum="64" AutomationProperties.Name="{l:Tr 'Grid step X'}" />
                        <ui:NumberBox Style="{StaticResource Number}" Width="90" Margin="6,0,0,0" Value="{Binding GridY}" Minimum="1" Maximum="64" AutomationProperties.Name="{l:Tr 'Grid step Y'}" />
                    </DockPanel>
                    <DockPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource FieldName}" Text="{l:Tr 'Offset X x Y'}" />
                        <ui:NumberBox Style="{StaticResource Number}" Width="90" Value="{Binding GridOffsetX}" Minimum="0" Maximum="63" AutomationProperties.Name="{l:Tr 'Grid offset X'}" />
                        <ui:NumberBox Style="{StaticResource Number}" Width="90" Margin="6,0,0,0" Value="{Binding GridOffsetY}" Minimum="0" Maximum="63" AutomationProperties.Name="{l:Tr 'Grid offset Y'}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                               Text="{l:Tr 'Drag a component to move it, its corner to resize it. Arrows: move by one pixel (Shift: 10). Ctrl+wheel: zoom.'}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- The GUI over a view of the game -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnMouseWheel">
            <Grid MinWidth="{Binding ActualWidth, ElementName=Scroller}" MinHeight="{Binding ActualHeight, ElementName=Scroller}">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#27323F" Offset="0" />
                        <GradientStop Color="#27323F" Offset="0.45" />
                        <GradientStop Color="#0E2A1A" Offset="0.45" />
                        <GradientStop Color="#0E2A1A" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Border x:Name="Shade" Background="#80101010" Visibility="{Binding RenderBackground, Converter={StaticResource BoolToVisibility}}" />
                <Canvas x:Name="Canvas" Width="{Binding Width}" Height="{Binding Height}" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent" MouseLeftButtonDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseLeftButtonUp="OnCanvasMouseUp"
                        MouseRightButtonDown="OnCanvasRightDown"
                        AutomationProperties.Name="{l:Tr 'GUI'}">
                    <Canvas.ContextMenu>
                        <ContextMenu Opened="OnMenuOpened" />
                    </Canvas.ContextMenu>
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="Zoom" ScaleX="2" ScaleY="2" />
                    </Canvas.LayoutTransform>
                    <!-- The window: the panel of the game with its bevel -->
                    <Border Width="{Binding Width}" Height="{Binding Height}" Background="{StaticResource McPanel}" CornerRadius="1.5"
                            BorderBrush="Black" BorderThickness="0.5" IsHitTestVisible="False">
                        <Border BorderThickness="1.5,1.5,0,0" BorderBrush="{StaticResource McLight}">
                            <Border BorderThickness="0,0,1.5,1.5" BorderBrush="{StaticResource McDark}" Margin="-1.5,-1.5,0,0" />
                        </Border>
                    </Border>
                    <local:GuiGrid Width="{Binding Width}" Height="{Binding Height}" StepX="{Binding GridX}" StepY="{Binding GridY}"
                                   OffsetX="{Binding GridOffsetX}" OffsetY="{Binding GridOffsetY}"
                                   Visibility="{Binding SnapToGrid, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Player's inventory -->
                    <ItemsControl ItemsSource="{Binding InventorySlots}" IsHitTestVisible="False" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Template="{StaticResource McSlotTemplate}" Focusable="False" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Components -->
                    <ItemsControl x:Name="ComponentLayer" ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </ScrollViewer>
        </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
