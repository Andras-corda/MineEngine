<UserControl x:Class="MineEngine.Editor.Views.MainToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MineEngine.Editor.Localization"
             xmlns:views="clr-namespace:MineEngine.Editor.Views"
             xmlns:graphs="clr-namespace:MineEngine.Assets.Graphs;assembly=MineEngine.Assets"
             xmlns:core="clr-namespace:MineEngine.Core.Assets;assembly=MineEngine.Core"
             xmlns:java="clr-namespace:MineEngine.Minecraft.Java;assembly=MineEngine.Minecraft">

    <!--
        Barre d'outils sous les menus, au-dessus de l'espace de travail. DataContext : MainViewModel.
        À gauche, ce qui agit sur le mod et sur l'élément sélectionné ; à droite, la recherche,
        le mode d'affichage du Dashboard, puis valider, compiler et lancer.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MineEngine.Editor;component/Themes/BaseStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="1,0" />
            </Style>

            <!-- Mode d'affichage du Dashboard ; Tag = vrai pour le mode actif. -->
            <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{StaticResource True}">
                        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- View of the work area opened from the toolbar (Dashboard, Resources, Languages); Tag = true when shown. -->
            <Style x:Key="ViewButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="2,0" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="{StaticResource True}">
                        <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ToolSeparator" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
            </Style>

            <!-- Bouton texte (Valider, Compiler, Lancer) : glyphe puis libellé. -->
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
        <DockPanel>
            <!-- Droite : recherche, affichage, validation, compilation, lancement -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Back and Forward between the pages of the work area, like a web browser. -->
                <Button Style="{StaticResource ToolButton}" Margin="0,0,0,0" Content="{StaticResource Glyph.Back}" Command="{Binding GoBackCommand}"
                        ToolTip="{l:Tr 'Back to the previous page (Alt+Left)'}" AutomationProperties.Name="{l:Tr 'Back'}" />
                <Button Style="{StaticResource ToolButton}" Content="{StaticResource Glyph.Forward}" Command="{Binding GoForwardCommand}"
                        ToolTip="{l:Tr 'Forward to the next page (Alt+Right)'}" AutomationProperties.Name="{l:Tr 'Forward'}" />

                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsViewModeButtons, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource ModeButton}" Margin="6,0,1,0" Content="{StaticResource Glyph.ListView}" ToolTip="{l:Tr 'Show as a list'}"
                            Command="{Binding Project.ShowListCommand}" Click="OnShowDashboardClick"
                            Tag="{Binding Project.IsTileView, Converter={StaticResource InverseBool}, FallbackValue=False}" />
                    <Button Style="{StaticResource ModeButton}" Content="{StaticResource Glyph.GridView}" ToolTip="{l:Tr 'Show as tiles (Ctrl+wheel: size)'}"
                            Command="{Binding Project.ShowTilesCommand}" Click="OnShowDashboardClick"
                            Tag="{Binding Project.IsTileView, FallbackValue=False}" />
                </StackPanel>

                <Border Style="{StaticResource ToolSeparator}" />

                <Button Style="{StaticResource ActionButton}" Command="{Binding ValidateCommand}" ToolTip="{l:Tr 'Validate the project (F7)'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Check}" />
                        <TextBlock Text="{l:Tr 'Validate'}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding BuildCommand}" ToolTip="{l:Tr 'Build the mod (Ctrl+Shift+B)'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Build}" />
                        <TextBlock Text="{l:Tr 'Build'}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Command="{Binding CancelBuildCommand}" ToolTip="{l:Tr 'Stop the build'}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Tr 'Stop'}" />
                </Button>
                <Button Style="{DynamicResource AccentButtonStyle}" Padding="12,4" MinHeight="28" Margin="4,0,0,0"
                        Command="{Binding RunClientCommand}" ToolTip="{l:Tr 'Launch Minecraft with the mod (F5)'}" ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Run}" />
                        <TextBlock Text="{l:Tr 'Run'}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Gauche : ajout, puis actions sur l'élément sélectionné, puis dossier -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddButton" Style="{DynamicResource AccentButtonStyle}" Padding="8,4" MinHeight="28" Margin="0,0,4,0"
                        Click="OnAddClick" IsEnabled="{Binding CanEdit}" ToolTip="{l:Tr 'Add to the mod'}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Tr 'Game content'}">
                                <MenuItem.Icon><views:IconView Icon="BlockGeometry" IconSize="14" /></MenuItem.Icon>
                                <MenuItem Header="{l:Tr 'Item'}" Command="{Binding AddItemCommand}">
                                    <MenuItem.Icon><views:IconView Icon="ItemGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Block'}" Command="{Binding AddBlockCommand}">
                                    <MenuItem.Icon><views:IconView Icon="BlockGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Mob'}" Command="{Binding AddMobCommand}">
                                    <MenuItem.Icon><views:IconView Icon="MobGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Recipe'}" Command="{Binding AddRecipeCommand}">
                                    <MenuItem.Icon><views:IconView Icon="RecipeGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="{l:Tr 'Visual programming'}">
                                <MenuItem.Icon><views:IconView Icon="NodeGraphGeometry" IconSize="14" /></MenuItem.Icon>
                                <MenuItem Header="{l:Tr 'Event graph'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Events}" ToolTip="{l:Tr 'Reactions to game events (right-click, player join...)'}">
                                    <MenuItem.Icon><views:IconView Icon="NodeGraphGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:Tr 'Function'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Function}" ToolTip="{l:Tr 'Sequence of instructions that returns values'}">
                                    <MenuItem.Icon><views:IconView Icon="FunctionGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Procedure'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Procedure}" ToolTip="{l:Tr 'Sequence of instructions that returns nothing'}">
                                    <MenuItem.Icon><views:IconView Icon="ProcedureGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Function library'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Library}" ToolTip="{l:Tr 'Functions and procedures usable in every graph of the project, grouped under the name of the library in the Nodes window'}">
                                    <MenuItem.Icon><views:IconView Icon="LibraryGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:Tr 'Class'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Class}" ToolTip="{l:Tr 'Type with fields, a constructor and methods; inheritance and interfaces'}">
                                    <MenuItem.Icon><views:IconView Icon="ClassGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Struct'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Struct}" ToolTip="{l:Tr 'Type that groups fields'}">
                                    <MenuItem.Icon><views:IconView Icon="StructGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Interface'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Interface}" ToolTip="{l:Tr 'Methods that the implementing classes must provide'}">
                                    <MenuItem.Icon><views:IconView Icon="InterfaceGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Enumeration'}" Command="{Binding AddGraphCommand}" CommandParameter="{x:Static graphs:GraphKind.Enum}" ToolTip="{l:Tr 'List of named values'}">
                                    <MenuItem.Icon><views:IconView Icon="EnumGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="{l:Tr 'Behavior tree (Puppeteer)'}" Command="{Binding AddBehaviorTreeCommand}"
                                      ToolTip="{l:Tr 'AI of a mob as nodes: selectors, sequences, tasks, decorators and services, like Unreal\'s Behavior Trees'}">
                                <MenuItem.Icon><views:IconView Icon="BehaviorTreeGeometry" IconSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Tr 'Gameplay'}">
                                <MenuItem.Icon><views:IconView Icon="CommandGeometry" IconSize="14" /></MenuItem.Icon>
                                <MenuItem Header="{l:Tr 'Command'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.Command}"
                                          ToolTip="{l:Tr 'Chat command (/heal) run by event graphs'}">
                                    <MenuItem.Icon><views:IconView Icon="CommandGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Creative tab'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.CreativeTab}"
                                          ToolTip="{l:Tr 'Tab of the creative inventory with the items you choose'}">
                                    <MenuItem.Icon><views:IconView Icon="Glyph.Tab" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Keybind'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.Keybind}"
                                          ToolTip="{l:Tr 'Key of the Controls that runs event graphs'}">
                                    <MenuItem.Icon><views:IconView Icon="Glyph.Keyboard" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Enchantment'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.Enchantment}"
                                          ToolTip="{l:Tr 'Enchantment for weapons, armor or tools'}">
                                    <MenuItem.Icon><views:IconView Icon="Glyph.Star" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Fluid'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.Fluid}"
                                          ToolTip="{l:Tr 'Fluid with its block and its bucket'}">
                                    <MenuItem.Icon><views:IconView Icon="FluidGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Plant'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.Plant}"
                                          ToolTip="{l:Tr 'Flower, tall plant, growing plant or crop, with its patches in the world'}">
                                    <MenuItem.Icon><views:IconView Icon="Glyph.Star" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Biome'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.Biome}"
                                          ToolTip="{l:Tr 'Biome of the overworld, with its climate and its colors'}">
                                    <MenuItem.Icon><views:IconView Icon="Glyph.Explorer" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Particle system'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.Sparkle}"
                                          ToolTip="{l:Tr 'Sparkle particle system: emitters of particles played by the graphs'}">
                                    <MenuItem.Icon><views:IconView Icon="SparkleGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Game rule'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.GameRule}"
                                          ToolTip="{l:Tr 'Rule changed with /gamerule'}">
                                    <MenuItem.Icon><views:IconView Icon="Glyph.Settings" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:Tr 'Status effect'}" Command="{Binding AddOfTypeCommand}" CommandParameter="{x:Static core:AssetType.Effect}"
                                          ToolTip="{l:Tr 'Effect like Speed or Poison, with its potion'}">
                                    <MenuItem.Icon><views:IconView Icon="PotionGeometry" IconSize="14" /></MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="{l:Tr 'Java class'}">
                                <MenuItem Header="{l:Tr 'Game event listener...'}" Command="{Binding Explorer.NewJavaClassCommand}" CommandParameter="{x:Static java:JavaClassKind.EventListener}" />
                                <MenuItem Header="{l:Tr 'Utility class...'}" Command="{Binding Explorer.NewJavaClassCommand}" CommandParameter="{x:Static java:JavaClassKind.Utility}" />
                                <MenuItem Header="{l:Tr 'Empty class...'}" Command="{Binding Explorer.NewJavaClassCommand}" CommandParameter="{x:Static java:JavaClassKind.Empty}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{l:Tr 'Import'}">
                                <MenuItem Header="{l:Tr 'Textures (PNG)...'}" Command="{Binding ImportTexturesCommand}" />
                                <MenuItem Header="{l:Tr 'Sounds (OGG)...'}" Command="{Binding ImportSoundsCommand}" />
                                <MenuItem Header="{l:Tr '3D models...'}" Command="{Binding ImportModelsCommand}"
                                          ToolTip="{l:Tr 'Blockbench (.bbmodel) or Java JSON, with their textures, for items, blocks and mobs; GeckoLib, OBJ and glTF are kept as sources'}" />
                                <MenuItem Header="{l:Tr 'Element from another project (.asset.json)...'}" Command="{Binding ImportAssetCommand}" ToolTip="{l:Tr 'Adds an element exported from another project to the open folder'}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{l:Tr 'New folder'}" Command="{Binding NewFolderCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.NewItem}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.ChevronDown}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolSeparator}" Margin="4,0,6,0" />

                <Button Style="{StaticResource ToolButton}" Content="{StaticResource Glyph.Copy}" Command="{Binding DuplicateAssetCommand}"
                        ToolTip="{l:Tr 'Duplicate the selected element (Ctrl+D)'}" />
                <Button Style="{StaticResource ToolButton}" Content="{StaticResource Glyph.Delete}" Command="{Binding DeleteAssetCommand}"
                        ToolTip="{l:Tr 'Delete the selected element'}" />
                <Button Style="{StaticResource ToolButton}" Content="{StaticResource Glyph.Rename}" Command="{Binding EditSelectedAssetCommand}"
                        ToolTip="{l:Tr 'Edit the selected element'}" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenSelectedGraphCommand}" ToolTip="{l:Tr 'Open the selected graph'}">
                    <Path Style="{StaticResource IconPathButton}" Width="14" Height="14" Data="{StaticResource NodeGraphGeometry}" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Content="{StaticResource Glyph.Code}" Command="{Binding OpenAssetJavaCommand}"
                        ToolTip="{l:Tr 'View the Java code of the selected element (the mod code is generated, without compiling)'}" />

                <Border Style="{StaticResource ToolSeparator}" />

                <Button Style="{StaticResource ToolButton}" Content="{StaticResource Glyph.NewFolder}" Command="{Binding NewFolderCommand}"
                        ToolTip="{l:Tr 'Create a folder in the folder open in the Dashboard'}" />

                <Border Style="{StaticResource ToolSeparator}" />

                <!-- Views of the project in the work area (their tabs are not shown). -->
                <Button Style="{StaticResource ViewButton}" Command="{Binding ShowDashboardCommand}" Tag="{Binding IsDashboardShown}"
                        ToolTip="{l:Tr 'Show the Dashboard (Ctrl+1)'}" AutomationProperties.Name="{l:Tr 'Dashboard'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Home}" Margin="6,0,6,0" />
                        <TextBlock Text="{l:Tr 'Dashboard'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ViewButton}" Command="{Binding ShowResourcesCommand}" Tag="{Binding IsResourcesShown}"
                        ToolTip="{l:Tr 'Show the resources: textures, sounds and 3D models (Ctrl+2)'}" AutomationProperties.Name="{l:Tr 'Resources'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Texture}" Margin="6,0,6,0" />
                        <TextBlock Text="{l:Tr 'Resources'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ViewButton}" Command="{Binding ShowGlobalsCommand}" Tag="{Binding IsGlobalsShown}"
                        ToolTip="{l:Tr 'Show the global variables, readable and changeable from every graph (Ctrl+4)'}" AutomationProperties.Name="{l:Tr 'Global'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Field}" Margin="6,0,6,0" />
                        <TextBlock Text="{l:Tr 'Global'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ViewButton}" Command="{Binding ShowTagsCommand}" Tag="{Binding IsTagsShown}"
                        ToolTip="{l:Tr 'Show the tags: groups of blocks, items, entities, biomes... (Ctrl+5)'}" AutomationProperties.Name="{l:Tr 'Tags'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Link}" Margin="6,0,6,0" />
                        <TextBlock Text="{l:Tr 'Tags'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ViewButton}" Command="{Binding ShowLanguagesCommand}" Tag="{Binding IsLanguagesShown}"
                        ToolTip="{l:Tr 'Show the languages of the mod and their translations (Ctrl+3)'}" AutomationProperties.Name="{l:Tr 'Languages'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{StaticResource Glyph.Language}" Margin="6,0,6,0" />
                        <TextBlock Text="{l:Tr 'Languages'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Middle: the search takes the space left (up to 320 pixels) and shrinks with the window. -->
            <Grid Margin="8,0,6,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20*" MaxWidth="320" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="1" Padding="28,4,8,4" MinHeight="28" TextChanged="OnSearchTextChanged"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr 'Search the mod (Ctrl+F)'}" />
                <TextBlock Grid.Column="1" FontFamily="{StaticResource IconFont}" Text="{StaticResource Glyph.Search}" FontSize="12" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource HintBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding SearchHint}" TextTrimming="CharacterEllipsis" Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource HintBrush}"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisible}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
